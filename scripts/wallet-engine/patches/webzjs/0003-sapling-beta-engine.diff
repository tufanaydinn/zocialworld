+        let many = (0..=MAX_OUTPUTS).map(|_| out(ORCHARD_SAPLING, false, false)).collect();
+        assert!(resolve_outputs(net, many).unwrap_err().to_string().starts_with("invalid_outputs:"));
+        let ok = resolve_outputs(net, vec![out(ORCHARD_SAPLING, false, true), out(&t, true, false)]).unwrap();
+        assert_eq!(ok.iter().map(|o| o.recipient.pool).collect::<Vec<_>>(), vec![OutputPool::Sapling, OutputPool::Transparent]);
+    }

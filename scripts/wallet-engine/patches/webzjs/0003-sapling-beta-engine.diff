+/// Maps a zcash_client_backend proposal error to a coded Sapling-beta error.
+fn map_proposal_error<DE, TE, SE, FE, CE, N>(
+    e: zcash_client_backend::data_api::error::Error<DE, TE, SE, FE, CE, N>,
+) -> Error
+where
+    DE: Debug,
+    TE: Debug,
+    SE: Debug,
+    FE: Debug,
+    CE: Debug,
+    N: Debug,
+{
+    use zcash_client_backend::data_api::error::Error as BackendError;
+    match e {
+        BackendError::InsufficientFunds {
+            available,
+            required,
+        } => Error::InsufficientFunds {
+            available: available.into(),
+            required: required.into(),
+        },
+        other => Error::ProposalFailed(format!("{:?}", other)),
+    }
+}

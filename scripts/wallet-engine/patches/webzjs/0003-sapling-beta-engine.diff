+    /// A UTXO missing from lightwalletd's UTXO set is a candidate; a transaction
+    /// marks exactly the candidates it spends.
+    #[test]
+    fn transparent_reconcile_helpers() {
+        let shield = fixture("shield");
+        let spent: Vec<OutPoint> = shield
+            .transparent_bundle()
+            .expect("the shielding fixture spends transparent inputs")
+            .vin
+            .iter()
+            .map(|i| i.prevout().clone())
+            .collect();
+        assert!(!spent.is_empty());
+        let other = OutPoint::new([9u8; 32], 0);
+        let stored: Vec<OutPoint> = spent.iter().cloned().chain([other.clone()]).collect();
+        // lightwalletd still lists `other` as unspent, not the shielded inputs.
+        let live: BTreeSet<OutPoint> = [other.clone()].into_iter().collect();
+        let missing = missing_outpoints(&stored, &live);
+        let mut expected = spent.clone();
+        expected.sort();
+        assert_eq!(missing, expected);
+        let candidates: BTreeSet<OutPoint> = missing.into_iter().collect();
+        assert_eq!(spent_outpoints(&shield, &candidates).len(), spent.len());
+        // A payment (Sapling spends only) spends none of them; nor does anything spend `other`.
+        assert!(spent_outpoints(&fixture("payment"), &candidates).is_empty());
+        let only_other: BTreeSet<OutPoint> = [other].into_iter().collect();
+        assert!(spent_outpoints(&shield, &only_other).is_empty());
+        // Everything still live: nothing to reconcile.
+        let all_live: BTreeSet<OutPoint> = stored.iter().cloned().collect();
+        assert!(missing_outpoints(&stored, &all_live).is_empty());
+    }

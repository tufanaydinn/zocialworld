+/// Restores the result of a worker thread: worker errors travel as strings (coded messages keep
+/// their code); a panic becomes `transaction_build_failed`.
+fn join_worker<T>(
+    joined: Result<Result<T, String>, Box<dyn std::any::Any + Send>>,
+) -> Result<T, Error> {
+    match joined {
+        Ok(Ok(v)) => Ok(v),
+        Ok(Err(message)) => Err(Error::from_worker(message)),
+        Err(panic) => {
+            let detail = panic
+                .downcast_ref::<String>()
+                .cloned()
+                .or_else(|| panic.downcast_ref::<&str>().map(|s| s.to_string()))
+                .unwrap_or_else(|| "unknown panic".to_string());
+            Err(Error::TransactionBuildFailed(format!(
+                "the wallet worker panicked: {}",
+                detail
+            )))
+        }
+    }
+}

+/// Stable error codes carried by Sapling-beta errors (message prefix and `error.code`).
+pub const ERROR_CODES: &[&str] = &[
+    "invalid_address",
+    "recipient_no_sapling_receiver",
+    "recipient_transparent_not_allowed",
+    "recipient_unsupported",
+    "recipient_wrong_network",
+    "memo_not_allowed",
+    "memo_too_long",
+    "invalid_amount",
+    "invalid_outputs",

+    /// Sapling beta upgrade guard, with `code` filled in from `reason`.
+    pub async fn sending_status(&self) -> SendingStatus {
+        let mut status = self.sending_status_inner().await;
+        if !status.allowed && status.code.is_none() {
+            status.code = status

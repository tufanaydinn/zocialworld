+/// Sapling beta: transaction "enhancement" for the memory backend. zcash_client_backend's sync
+/// only scans compact blocks, which carry no memos, so a received note's memo is unknown until the
+/// full transaction is fetched and decrypted. This fetches (GetTransaction, through the game
+/// server's bridge) every transaction that holds a received Sapling note with no memo and no stored
+/// raw data yet, and stores its decryption. Each transaction is fetched once (its raw data is then
+/// stored). Failures are logged and retried on the next sync; they never fail the sync.
+impl<T> Wallet<MemoryWalletDb<Network>, T>
+where
+    T: GrpcService<tonic::body::Body> + Clone,
+    T::Error: Into<StdError>,
+    T::ResponseBody: Body<Data = Bytes> + std::marker::Send + 'static,
+    <T::ResponseBody as Body>::Error: Into<StdError> + std::marker::Send,
+{
+    pub async fn enhance_received_memos(&self) -> Result<usize, Error> {
+        use zcash_protocol::memo::Memo;
+        let (candidates, tip) = {
+            let db = self.db.read().await;
+            let mut set = std::collections::BTreeSet::new();
+            for note in db.received_notes().iter() {
+                if note.pool() != zcash_protocol::PoolType::SAPLING
+                    || !matches!(note.memo(), Memo::Empty)
+                {
+                    continue;
+                }
+                let txid = note.txid();
+                if matches!(db.get_transaction(txid), Ok(Some(_))) {
+                    continue; // already have the full transaction (sent by us, or enhanced)
+                }
+                set.insert(txid);
+            }
+            (set.into_iter().collect::<Vec<_>>(), db.chain_height()?)
+        };
+        let mut client = self.client.clone();
+        let mut enhanced = 0;
+        for txid in candidates {
+            let raw = match client
+                .get_transaction(service::TxFilter {
+                    block: None,
+                    index: 0,
+                    hash: txid.as_ref().to_vec(),
+                })
+                .await
+            {
+                Ok(r) => r.into_inner(),
+                Err(e) => {
+                    tracing::warn!("enhancement: GetTransaction {} failed: {}", txid, e.message());
+                    continue;
+                }
+            };
+            let mined_height = u32::try_from(raw.height)
+                .ok()
+                .filter(|h| *h > 0 && *h < u32::MAX)
+                .map(BlockHeight::from_u32);
+            let branch_height = mined_height
+                .or(tip.map(|t| t + 1))
+                .unwrap_or_else(|| BlockHeight::from_u32(1));
+            let tx = match zcash_primitives::transaction::Transaction::read(
+                &raw.data[..],
+                BranchId::for_height(&self.network, branch_height),
+            ) {
+                Ok(tx) if tx.txid() == txid => tx,
+                Ok(_) | Err(_) => {
+                    tracing::warn!("enhancement: could not parse transaction {}", txid);
+                    continue;
+                }
+            };
+            let mut db = self.db.write().await;
+            match zcash_client_backend::data_api::wallet::decrypt_and_store_transaction(
+                &self.network,
+                &mut *db,
+                &tx,
+                mined_height,
+            ) {
+                Ok(()) => enhanced += 1,
+                Err(e) => tracing::warn!("enhancement: storing {} failed: {}", txid, e),
+            }
+        }
+        if enhanced > 0 {
+            tracing::info!("enhancement: decrypted {} full transaction(s)", enhanced);
+        }
+        Ok(enhanced)
+    }
+
+    /// Sapling beta: transparent UTXOs spent OUTSIDE this wallet.
+    ///
+    /// zcash_client_backend's `refresh_utxos` only inserts what GetAddressUtxos returns, and the
+    /// memory backend marks a UTXO spent only when it stores a transaction spending it (one this
+    /// wallet built, or one enhancement fetched because it holds a received Sapling note). When
+    /// another wallet with the same seed (Zodl, Zashi, Zingo, …) shields or spends the shared
+    /// t-address into Orchard/Ironwood or a transparent output, nothing tells this wallet: the UTXO
+    /// would show as "waiting to be shielded" forever and every shield would be rejected
+    /// (`missingorspent`).
+    ///
+    /// For every stored UTXO this wallet still counts as spendable that lightwalletd's current
+    /// UTXO set no longer lists, this looks for its spending transaction with
+    /// GetTaddressTransactions (from the UTXO's height to the tip) and stores that transaction's
+    /// transparent part only (no decryption), which marks the UTXO spent by a mined transaction.
+    /// Only a MINED transaction that really spends the outpoint counts, so a lagging or reorganised
+    /// server can never make funds disappear. Failures are logged and retried on the next sync.
+    /// Returns how many UTXOs were marked spent.
+    pub async fn reconcile_transparent_utxos(&self) -> Result<usize, Error> {
+        use futures_util::TryStreamExt;
+        use std::collections::{BTreeMap, BTreeSet};
+        use zcash_client_backend::data_api::wallet::TargetHeight;
+        use zcash_client_backend::data_api::DecryptedTransaction;
+        use zcash_keys::encoding::AddressCodec;
+        use zcash_transparent::address::TransparentAddress;
+        use zcash_transparent::bundle::OutPoint;
+
+        /// At most this many transactions are read per address and sync (a long-used t-address
+        /// is finished on later syncs).
+        const MAX_TXS_PER_ADDRESS: usize = 500;
+
+        // 1. The UTXOs this wallet still counts as spendable, per address.
+        let (stored, tip) = {
+            let db = self.db.read().await;
+            let tip = match db.chain_height()? {
+                Some(h) => h,
+                None => return Ok(0),
+            };
+            let target = TargetHeight::from(tip + 1);
+            let mut stored: Vec<(TransparentAddress, OutPoint, Option<BlockHeight>)> = Vec::new();
+            for account in db.get_account_ids()? {
+                for address in db.get_transparent_receivers(account, true, true)?.into_keys() {
+                    for utxo in db.get_spendable_transparent_outputs(
+                        &address,
+                        target,
+                        self.min_confirmations,
+                        CoinbaseFilter::AllTransparentOutputs,
+                    )? {
+                        stored.push((address, utxo.outpoint().clone(), utxo.mined_height()));
+                    }
+                }
+            }
+            (stored, tip)
+        };
+        if stored.is_empty() {
+            return Ok(0);
+        }
+
+        // 2. lightwalletd's current UTXO set for those addresses.
+        let start = stored
+            .iter()
+            .filter_map(|(_, _, h)| *h)
+            .min()
+            .unwrap_or_else(|| BlockHeight::from_u32(0));
+        let addresses: BTreeSet<String> = stored
+            .iter()
+            .map(|(a, _, _)| a.encode(&self.network))
+            .collect();
+        let mut client = self.client.clone();
+        let mut live = BTreeSet::new();
+        let mut replies = client
+            .get_address_utxos_stream(service::GetAddressUtxosArg {
+                addresses: addresses.into_iter().collect(),
+                start_height: u64::from(u32::from(start)),
+                max_entries: 0,
+            })
+            .await?
+            .into_inner();
+        while let Some(reply) = replies.try_next().await? {
+            if let (Ok(hash), Ok(index)) = (<[u8; 32]>::try_from(&reply.txid[..]), u32::try_from(reply.index)) {
+                live.insert(OutPoint::new(hash, index));
+            }
+        }
+        let outpoints: Vec<OutPoint> = stored.iter().map(|(_, o, _)| o.clone()).collect();
+        let missing: BTreeSet<OutPoint> = sapling_beta::missing_outpoints(&outpoints, &live)
+            .into_iter()
+            .collect();
+        if missing.is_empty() {
+            return Ok(0);
+        }
+
+        // 3. For each address with missing UTXOs: find the mined transactions that spend them.
+        let mut by_address: BTreeMap<String, BlockHeight> = BTreeMap::new();
+        for (address, outpoint, height) in &stored {
+            if missing.contains(outpoint) {
+                let from = height.unwrap_or(start);
+                let entry = by_address.entry(address.encode(&self.network)).or_insert(from);
+                *entry = (*entry).min(from);
+            }
+        }
+        let mut remaining = missing.clone();
+        let mut marked = 0;
+        for (address, from) in by_address {
+            if remaining.is_empty() {
+                break;
+            }
+            let filter = service::TransparentAddressBlockFilter {
+                address,
+                range: Some(service::BlockRange {
+                    start: Some(service::BlockId {
+                        height: u64::from(u32::from(from)),
+                        hash: vec![],
+                    }),
+                    end: Some(service::BlockId {
+                        height: u64::from(u32::from(tip)),
+                        hash: vec![],
+                    }),
+                    pool_types: vec![],
+                }),
+            };
+            let mut stream = client.get_taddress_txids(filter).await?.into_inner();
+            let mut seen = 0;
+            while let Some(raw) = stream.try_next().await? {
+                seen += 1;
+                if seen > MAX_TXS_PER_ADDRESS || remaining.is_empty() {
+                    break;
+                }
+                // Mined transactions only (mempool entries carry height 0 or u64::MAX).
+                let Some(height) = u32::try_from(raw.height)
+                    .ok()
+                    .filter(|h| *h > 0 && *h < u32::MAX)
+                    .map(BlockHeight::from_u32)
+                else {
+                    continue;
+                };
+                let Ok(tx) = zcash_primitives::transaction::Transaction::read(
+                    &raw.data[..],
+                    BranchId::for_height(&self.network, height),
+                ) else {
+                    tracing::warn!("utxo reconcile: could not parse a transaction at height {}", u32::from(height));
+                    continue;
+                };
+                let spends = sapling_beta::spent_outpoints(&tx, &remaining);
+                if spends.is_empty() {
+                    continue;
+                }
+                // Store the transaction's transparent part only: the memory backend marks every
+                // input the wallet holds as spent by this mined transaction.
+                let mut db = self.db.write().await;
+                db.store_decrypted_tx(DecryptedTransaction::new(
+                    Some(height),
+                    &tx,
+                    vec![],
+                    vec![],
+                    vec![],
+                ))?;
+                drop(db);
+                for outpoint in spends {
+                    remaining.remove(&outpoint);
+                    marked += 1;
+                }
+            }
+        }
+        if marked > 0 {
+            tracing::info!("utxo reconcile: {} transparent output(s) were spent elsewhere", marked);
+        }
+        Ok(marked)
+    }

+    /// Refuses (`consensus_branch_mismatch`, `consensus_upgrade_pending` or
+    /// `consensus_branch_unknown`) unless sending is allowed. The error carries the same message
+    /// as `sending_status().reason`.
+    pub async fn require_sending_allowed(&self) -> Result<(), Error> {
+        let status = self.sending_status().await;
+        if status.allowed {
+            return Ok(());
+        }
+        let reason = status.reason.unwrap_or_else(|| {
+            Error::ConsensusBranchUnknown("unknown".to_string()).to_string()
+        });
+        tracing::warn!("Sending refused: {}", reason);
+        Err(Error::Coded(reason))
+    }

+    /// Sapling beta upgrade guard: reads lightwalletd's consensus branch and compares it with the
+    /// branch this build targets. Never fails; problems are reported in `allowed`/`reason`.
+    async fn sending_status_inner(&self) -> SendingStatus {
+        let mut status = SendingStatus {
+            allowed: false,
+            expected_branch: sapling_beta::expected_branch_hex(),
+            chain_branch: None,
+            chain_name: None,
+            chain_tip: None,
+            next_block_branch: None,
+            pending_upgrade: None,
+            pools: vec!["sapling".to_string(), "transparent".to_string()],
+            code: None,
+            reason: None,
+        };
+        let mut client = self.client.clone();
+        let info = match client.get_lightd_info(service::Empty {}).await {
+            Ok(r) => r.into_inner(),
+            Err(e) => {
+                status.reason = Some(
+                    Error::ConsensusBranchUnknown(format!("GetLightdInfo failed: {}", e.message()))
+                        .to_string(),
+                );
+                return status;
+            }
+        };
+        status.chain_name = Some(info.chain_name.clone());
+        status.chain_tip = Some(info.block_height);
+        if info.upgrade_height > 0 && !info.upgrade_name.is_empty() {
+            status.pending_upgrade = Some(PendingUpgrade {
+                name: info.upgrade_name.clone(),
+                height: info.upgrade_height,
+            });
+        }
+        // The branch the transaction builder will use (target height = tip + 1) and the branch of
+        // the tip block, both under this build's own consensus parameters.
+        let tip_height = u32::try_from(info.block_height).unwrap_or(u32::MAX - 1);
+        let local_tip = BranchId::for_height(&self.network, BlockHeight::from_u32(tip_height));
+        let local_next =
+            BranchId::for_height(&self.network, BlockHeight::from_u32(tip_height.saturating_add(1)));
+        let local_expiry = BranchId::for_height(
+            &self.network,
+            BlockHeight::from_u32(
+                tip_height
+                    .saturating_add(1)
+                    .saturating_add(sapling_beta::UPGRADE_GUARD_BLOCKS as u32),
+            ),
+        );
+        status.next_block_branch = Some(sapling_beta::branch_hex(u32::from(local_next)));
+        if sapling_beta::supports_branch(u32::from(local_next)) {
+            status.expected_branch = sapling_beta::branch_hex(u32::from(local_next));
+        }
+        let expected = status.expected_branch.clone();
+        let chain = match sapling_beta::parse_branch_hex(&info.consensus_branch_id) {
+            Some(b) => b,
+            None => {
+                status.reason = Some(
+                    Error::ConsensusBranchUnknown(format!(
+                        "unparseable consensusBranchId {:?}",
+                        info.consensus_branch_id
+                    ))
+                    .to_string(),
+                );
+                return status;
+            }
+        };
+        status.chain_branch = Some(sapling_beta::branch_hex(chain));
+        // 1. The chain must be on a branch this build supports, and on the branch this build's
+        //    own rules give the tip (otherwise our activation heights disagree with the chain).
+        if !sapling_beta::supports_branch(chain) || chain != u32::from(local_tip) {
+            status.reason = Some(
+                Error::ConsensusBranchMismatch {
+                    expected,
+                    chain: sapling_beta::branch_hex(chain),
+                }
+                .to_string(),
+            );
+            return status;
+        }
+        // 2. No upgrade this build knows of may activate before a new transaction expires.
+        if local_next != local_tip || local_expiry != local_next {
+            // The first height in the window whose branch differs from the tip's.
+            let height = (1..=1 + sapling_beta::UPGRADE_GUARD_BLOCKS as u32)
+                .map(|d| tip_height.saturating_add(d))
+                .find(|h| BranchId::for_height(&self.network, BlockHeight::from_u32(*h)) != local_tip)
+                .unwrap_or(tip_height.saturating_add(1));
+            let name = format!(
+                "{:?}",
+                BranchId::for_height(&self.network, BlockHeight::from_u32(height))
+            );
+            let height = height as u64;
+            status.reason = Some(
+                Error::ConsensusUpgradePending {
+                    name,
+                    height,
+                    tip: info.block_height,
+                }
+                .to_string(),
+            );
+            status.code = Some("consensus_upgrade_pending".to_string());
+            return status;
+        }
+        // 3. Nor any upgrade lightwalletd announces (the NU6.3 build does not know NU7's height).

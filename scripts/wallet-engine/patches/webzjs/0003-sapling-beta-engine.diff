@@ -0,0 +1,753 @@
+// Zocial World "Sapling beta" policy (ADR-018 § 1–2), MIT OR Apache-2.0 like the rest of WebZjs.
+//
+// The memory wallet backend (zcash_client_memory) does not track the NU6.3 Ironwood pool, so this
+// build restricts the in-game wallet to the Sapling pool (plus transparent deposits that are
+// shielded into Sapling). NU6.3 leaves Sapling unchanged; ZIP 229: "version 4, version 5, and
+// version 6 transactions are all valid from NU6.3 activation onward".
+//
+// * receive:  the account's unified address carries ONLY a Sapling and a transparent receiver
+//             (ZIP 316), never Orchard; the plain transparent (t1) and Sapling (zs1) encodings of
+//             the same receivers are offered too;
+// * shield:   transparent UTXOs are spent into the wallet's own Sapling address (no transparent
+//             outputs), version-5 transaction;
+// * send:     only Sapling notes are selected (SpendPolicy), every payment goes to a Sapling
+//             receiver except withdrawal outputs, which may go to a transparent address; change
+//             goes to Sapling; the transaction is version 5 under the NU6.3 branch with no Orchard
+//             or Ironwood bundle;
+// * upgrade guard: before any transaction is built or broadcast, the chain's consensus branch
+//             (lightwalletd GetLightdInfo) must equal the branch this build targets.
+//
+// Everything is enforced twice: the proposal is constrained by zcash_client_backend's own knobs
+// (spend policy, fallback change pool, proposed tx version, resolved recipients), and the result
+// is re-checked (`check_proposal` before proving, `check_transaction` before broadcasting).
+
+use std::collections::BTreeSet;
+
+use serde::Serialize;
+use zcash_address::{ConversionError, ToAddress, ZcashAddress};
+use zcash_client_backend::data_api::wallet::input_selection::SpendPolicy;
+use zcash_client_backend::proposal::Proposal;
+use zcash_keys::address::Address;
+use zcash_primitives::transaction::{Transaction, TxVersion};
+use zcash_protocol::consensus::{BranchId, NetworkType};
+use zcash_protocol::memo::MemoBytes;
+use zcash_protocol::value::{Zatoshis, MAX_MONEY};
+use zcash_protocol::{PoolType, ShieldedPool};
+use zcash_transparent::address::TransparentAddress;
+use zcash_transparent::bundle::OutPoint;
+
+use crate::error::Error;
+
+/// The consensus branch this wallet build was made for: NU6.3 (Ironwood), `0x37A5165B`, active on
+/// mainnet from height 3,428,143 (ZIP 258). The regtest variant is used only with a local chain
+/// whose upgrades through NU6.3 are active from height 1, so it targets the same branch.
+/// It is the newest entry of `SUPPORTED_BRANCHES`.
+pub const EXPECTED_BRANCH: BranchId = BranchId::Nu6_3;
+
+/// Every consensus branch this build may create transactions for. The NU6.3 build supports only
+/// NU6.3. A NU7 build whose librustzcash knows the NU7 mainnet height lists `[Nu6_3, Nu7]`, so it
+/// keeps sending before activation and switches by itself at the activation height (the builder
+/// picks the branch with `BranchId::for_height`); see build/README.md "Moving to NU7".
+pub const SUPPORTED_BRANCHES: &[BranchId] = &[BranchId::Nu6_3];
+
+/// Whether this build may create transactions for `branch`.
+pub fn supports_branch(branch: u32) -> bool {
+    SUPPORTED_BRANCHES.iter().any(|b| u32::from(*b) == branch)
+}
+
+/// The supported branches as lightwalletd prints them, e.g. "37a5165b".
+pub fn supported_branches_hex() -> String {
+    SUPPORTED_BRANCHES
+        .iter()
+        .map(|b| branch_hex(u32::from(*b)))
+        .collect::<Vec<_>>()
+        .join("|")
+}
+
+/// The only transaction version the Sapling beta creates. V5 carries Sapling and (empty) Orchard
+/// bundles and no Ironwood bundle; it stays valid under NU6.3 (ZIP 229).
+pub const TX_VERSION: TxVersion = TxVersion::V5;
+
+/// Default number of blocks a created transaction stays valid for (zcash_primitives' builder
+/// default, `DEFAULT_TX_EXPIRY_DELTA`). Sending pauses when a pending network upgrade activates
+/// within this many blocks, because a transaction built for the current branch could still be
+/// waiting in a mempool when the branch changes.
+pub const UPGRADE_GUARD_BLOCKS: u64 = 40;
+
+/// The most outputs one `send` call accepts (recipient + project fee is 2; withdrawals and name
+/// fees are 1). A small bound keeps proofs and fees predictable.
+pub const MAX_OUTPUTS: usize = 8;
+
+/// Lower-case 8-digit hex form used by lightwalletd (`LightdInfo.consensusBranchId`).
+pub fn branch_hex(branch: u32) -> String {
+    format!("{:08x}", branch)
+}
+
+pub fn expected_branch_hex() -> String {
+    branch_hex(u32::from(EXPECTED_BRANCH))
+}
+
+/// Parses lightwalletd's `consensusBranchId` ("37a5165b", tolerating a 0x prefix / upper case).
+pub fn parse_branch_hex(s: &str) -> Option<u32> {
+    let t = s.trim();
+    let t = t
+        .strip_prefix("0x")
+        .or_else(|| t.strip_prefix("0X"))
+        .unwrap_or(t);
+    if t.is_empty() || t.len() > 8 {
+        return None;
+    }
+    u32::from_str_radix(t, 16).ok()
+}
+
+/// Input-pool selection for every Sapling-beta payment: Sapling notes only, never Orchard,
+/// Ironwood or transparent UTXOs (transparent funds are only ever spent by `shield`).
+pub fn spend_policy() -> SpendPolicy {
+    SpendPolicy::shielded_pools([ShieldedPool::Sapling])
+}
+
+/// The pool for change and for the shielded value of a shielding transaction when the transaction
+/// has no shielded inputs of its own. Sapling-only payments already put change in Sapling
+/// (zcash_client_backend's `select_change_pool` follows the input pools).
+pub const FALLBACK_CHANGE_POOL: ShieldedPool = ShieldedPool::Sapling;
+
+fn network_name(net: NetworkType) -> &'static str {
+    match net {
+        NetworkType::Main => "mainnet",
+        NetworkType::Test => "testnet",
+        NetworkType::Regtest => "regtest",
+    }
+}
+
+/// Which pool a resolved output pays into.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum OutputPool {
+    Sapling,
+    Transparent,
+}
+
+impl OutputPool {
+    pub fn pool_type(self) -> PoolType {
+        match self {
+            OutputPool::Sapling => PoolType::SAPLING,
+            OutputPool::Transparent => PoolType::Transparent,
+        }
+    }
+}
+
+/// A payment recipient reduced to the single receiver the Sapling beta pays.
+#[derive(Clone, Debug)]
+pub struct ResolvedRecipient {
+    /// A plain Sapling or transparent address (never a unified address), so that
+    /// zcash_client_backend cannot route the payment to any other pool.
+    pub address: ZcashAddress,
+    pub pool: OutputPool,
+}
+
+fn transparent_zaddr(net: NetworkType, t: &TransparentAddress) -> ZcashAddress {
+    match t {
+        TransparentAddress::PublicKeyHash(data) => ZcashAddress::from_transparent_p2pkh(net, *data),
+        TransparentAddress::ScriptHash(data) => ZcashAddress::from_transparent_p2sh(net, *data),
+    }
+}
+
+/// Resolves a payment recipient to the one receiver the Sapling beta pays, or refuses it.
+///
+/// * a Sapling address → itself;
+/// * a unified address → its Sapling receiver;
+/// * a transparent address → itself, for withdrawal outputs only
+///   (`recipient_transparent_not_allowed` otherwise);
+/// * a unified address WITHOUT a Sapling receiver (Orchard/Ironwood-only, or Orchard +
+///   transparent) → `recipient_no_sapling_receiver`, for withdrawals too. ADR-018 § 2 refuses a
+///   recipient without a Sapling receiver; paying such a UA's transparent receiver would make the
+///   amount and the address public although the player never typed a transparent address
+///   at all. A player who wants a public withdrawal pastes the plain t-address, which the
+///   game warns about;
+/// * a TEX address (ZIP 320), a Sprout address or an unparseable UA → `recipient_unsupported`;
+/// * an address of another network → `recipient_wrong_network`.
+pub fn resolve_recipient(
+    net: NetworkType,
+    to: &ZcashAddress,
+    withdrawal: bool,
+) -> Result<ResolvedRecipient, Error> {
+    let addr: Address = match to.clone().convert_if_network::<Address>(net) {
+        Ok(addr) => addr,
+        Err(ConversionError::IncorrectNetwork { .. }) => {
+            return Err(Error::RecipientWrongNetwork(network_name(net).to_string()))
+        }
+        Err(ConversionError::Unsupported(kind)) => {
+            return Err(Error::RecipientUnsupported(format!("{} address", kind)))
+        }
+        Err(ConversionError::User(e)) => {
+            return Err(Error::RecipientUnsupported(format!("unusable address ({})", e)))
+        }
+    };
+    match addr {
+        Address::Sapling(pa) => Ok(ResolvedRecipient {
+            address: ZcashAddress::from_sapling(net, pa.to_bytes()),
+            pool: OutputPool::Sapling,
+        }),
+        Address::Unified(ua) => {
+            if let Some(pa) = ua.sapling() {
+                return Ok(ResolvedRecipient {
+                    address: ZcashAddress::from_sapling(net, pa.to_bytes()),
+                    pool: OutputPool::Sapling,
+                });
+            }
+            // Never fall back to a UA's transparent receiver, not even for a withdrawal.
+            Err(Error::RecipientNoSaplingReceiver(if ua.has_orchard() {
+                "a unified address whose only shielded receiver is Orchard/Ironwood".to_string()
+            } else {
+                "a unified address without a Sapling receiver".to_string()
+            }))
+        }
+        Address::Transparent(t) => {
+            if withdrawal {
+                Ok(ResolvedRecipient {
+                    address: transparent_zaddr(net, &t),
+                    pool: OutputPool::Transparent,
+                })
+            } else {
+                Err(Error::RecipientTransparentNotAllowed)
+            }
+        }
+        Address::Tex(_) => Err(Error::RecipientUnsupported(
+            "a TEX (ZIP 320 transparent-source-only) address".to_string(),
+        )),
+    }
+}
+
+/// One requested output of a `send` call.
+#[derive(Clone, Debug)]
+pub struct OutputRequest {
+    pub to: ZcashAddress,
+    pub amount: Zatoshis,
+    pub memo: Option<MemoBytes>,
+    pub withdrawal: bool,
+}
+
+/// An output after recipient resolution, ready to become a ZIP 321 payment.
+#[derive(Clone, Debug)]
+pub struct ResolvedOutput {
+    pub recipient: ResolvedRecipient,
+    pub amount: Zatoshis,
+    pub memo: Option<MemoBytes>,
+    pub withdrawal: bool,
+}
+
+/// Validates an amount given in zatoshis: an integer in 1..=MAX_MONEY.
+pub fn parse_amount(zat: u64) -> Result<Zatoshis, Error> {
+    if zat == 0 || zat > MAX_MONEY {
+        return Err(Error::InvalidAmountZat(format!(
+            "{} zatoshis (must be 1..={})",
+            zat, MAX_MONEY
+        )));
+    }
+    Zatoshis::from_u64(zat).map_err(|_| Error::InvalidAmountZat(zat.to_string()))
+}
+
+/// Encodes a text memo (ZIP 302: UTF-8, at most 512 bytes).
+pub fn parse_memo(text: &str) -> Result<MemoBytes, Error> {
+    let bytes = text.as_bytes();
+    if bytes.len() > 512 {
+        return Err(Error::MemoTooLong(bytes.len()));
+    }
+    MemoBytes::from_bytes(bytes).map_err(|_| Error::MemoTooLong(bytes.len()))
+}
+
+/// Resolves and validates every output of a `send` call.
+pub fn resolve_outputs(
+    net: NetworkType,
+    outputs: Vec<OutputRequest>,
+) -> Result<Vec<ResolvedOutput>, Error> {
+    if outputs.is_empty() {
+        return Err(Error::InvalidOutputs("at least one output is required".into()));
+    }
+    if outputs.len() > MAX_OUTPUTS {
+        return Err(Error::InvalidOutputs(format!(
+            "{} outputs requested; at most {} are allowed",
+            outputs.len(),
+            MAX_OUTPUTS
+        )));
+    }
+    let mut total: u64 = 0;
+    let mut resolved = Vec::with_capacity(outputs.len());
+    for (i, o) in outputs.into_iter().enumerate() {
+        let recipient = resolve_recipient(net, &o.to, o.withdrawal).map_err(|e| e.at_output(i))?;
+        if recipient.pool == OutputPool::Transparent && o.memo.is_some() {
+            return Err(Error::MemoNotAllowed(i));
+        }
+        total = total.saturating_add(u64::from(o.amount));
+        if total > MAX_MONEY {
+            return Err(Error::InvalidAmountZat("the outputs add up to more than MAX_MONEY".into()));
+        }
+        resolved.push(ResolvedOutput {
+            recipient,
+            amount: o.amount,
+            memo: o.memo,
+            withdrawal: o.withdrawal,
+        });
+    }
+    Ok(resolved)
+}
+
+/// The stored transparent outputs the wallet still counts as spendable that
+/// lightwalletd's current UTXO set (GetAddressUtxos) no longer contains. They were spent by a
+/// transaction this wallet did not create (another wallet holding the same seed), or the server
+/// lags behind: they are only candidates, and a UTXO is marked spent only once its mined spending
+/// transaction is found on chain.
+pub fn missing_outpoints(stored: &[OutPoint], live: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
+    let mut out: Vec<OutPoint> = stored.iter().filter(|o| !live.contains(o)).cloned().collect();
+    out.sort();
+    out.dedup();
+    out
+}
+
+/// Which of `candidates` a transaction spends (its transparent inputs).
+pub fn spent_outpoints(tx: &Transaction, candidates: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
+    tx.transparent_bundle()
+        .map(|b| {
+            b.vin
+                .iter()
+                .map(|txin| txin.prevout().clone())
+                .filter(|prevout| candidates.contains(prevout))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// The marker an error message carries for the transaction it is about, so the game
+/// can report the txid of a transaction that may have reached the network. Errors cross the Web
+/// Worker boundary as strings, so the txid travels inside the message (`[txid=<hex>]`) and is
+/// restored as `error.txid` on the JavaScript side.
+pub fn txid_marker(txid: &str) -> String {
+    format!("[txid={}]", txid)
+}
+
+/// The txid of a `txid_marker` in an error message, if any (64 lower-case hex digits).
+pub fn txid_of_message(message: &str) -> Option<&str> {
+    let start = message.find("[txid=")? + "[txid=".len();
+    let rest = &message[start..];
+    let end = rest.find(']')?;
+    let txid = &rest[..end];
+    (txid.len() == 64 && txid.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
+        .then_some(txid)
+}
+
+/// What a transaction is expected to look like.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TxKind {
+    /// Transparent UTXOs → the wallet's own Sapling address. No Sapling spends, no transparent
+    /// outputs.
+    Shielding,
+    /// Sapling notes → Sapling outputs and `transparent_outputs` transparent (withdrawal)
+    /// outputs. No transparent inputs.
+    Payment { transparent_outputs: usize },
+    /// Broadcast-time check for a transaction already checked precisely at creation: either of
+    /// the shapes above.
+    Any,
+}
+
+/// Checks that a proposal is a single step, asks for a version-5 transaction, never touches the
+/// Orchard or Ironwood pool, returns change only to Sapling, and has the expected shape:
+/// shielding spends transparent UTXOs only; a payment spends Sapling notes only and pays Sapling
+/// receivers, plus transparent receivers exactly for the payments marked `transparent_payments`.
+pub fn check_proposal<FeeRuleT, NoteRef>(
+    proposal: &Proposal<FeeRuleT, NoteRef>,
+    kind: TxKind,
+    transparent_payments: &[usize],
+) -> Result<(), Error> {
+    let violation = |m: String| Err(Error::SaplingOnlyViolation(m));
+    if proposal.proposed_version() != Some(TX_VERSION) {
+        return violation(format!(
+            "proposal asks for transaction version {:?}, the Sapling beta only builds {:?}",
+            proposal.proposed_version(),
+            TX_VERSION
+        ));
+    }
+    if proposal.steps().len() != 1 {
+        return violation(format!(
+            "proposal has {} steps; the Sapling beta builds single-step transactions only",
+            proposal.steps().len()
+        ));
+    }
+    for step in proposal.steps().iter() {
+        if step.involves(PoolType::ORCHARD) || step.involves(PoolType::IRONWOOD) {
+            return violation("proposal involves the Orchard or Ironwood pool".to_string());
+        }
+        if !step.prior_step_inputs().is_empty() {
+            return violation("proposal spends outputs of a prior step".to_string());
+        }
+        let shielding = matches!(kind, TxKind::Shielding);
+        if step.input_in_pool(PoolType::Transparent) != shielding {
+            return violation(if shielding {
+                "shielding proposal has no transparent inputs".to_string()
+            } else {
+                "payment proposal spends transparent inputs".to_string()
+            });
+        }
+        if shielding && step.input_in_pool(PoolType::SAPLING) {
+            return violation("shielding proposal spends Sapling notes".to_string());
+        }
+        if !shielding && !step.input_in_pool(PoolType::SAPLING) {
+            return violation("payment proposal spends no Sapling notes".to_string());
+        }
+        for (idx, pool) in step.payment_pools().iter() {
+            let allowed = *pool == PoolType::SAPLING
+                || (*pool == PoolType::Transparent && transparent_payments.contains(idx));
+            if !allowed {
+                return violation(format!("payment {} goes to the {:?} pool", idx, pool));
+            }
+        }
+        if let TxKind::Payment { transparent_outputs } = kind {
+            let n = step
+                .payment_pools()
+                .values()
+                .filter(|p| **p == PoolType::Transparent)
+                .count();
+            if n != transparent_outputs {
+                return violation(format!(
+                    "proposal pays {} transparent outputs, expected {}",
+                    n, transparent_outputs
+                ));
+            }
+        }
+        for change in step.balance().proposed_change() {
+            if change.output_pool() != PoolType::SAPLING {
+                return violation(format!(
+                    "change output goes to the {:?} pool",
+                    change.output_pool()
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// The shape of a transaction, as checked and reported (`inspect`).
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct TxShape {
+    pub txid: String,
+    pub version: String,
+    pub consensus_branch_id: String,
+    pub transparent_inputs: usize,
+    pub transparent_outputs: usize,
+    pub sapling_spends: usize,
+    pub sapling_outputs: usize,
+    pub orchard_actions: usize,
+    pub ironwood_actions: usize,
+    pub has_orchard_bundle: bool,
+    pub has_ironwood_bundle: bool,
+    pub has_sprout_bundle: bool,
+}
+
+pub fn inspect(tx: &Transaction) -> TxShape {
+    let (t_in, t_out) = tx
+        .transparent_bundle()
+        .map(|b| (b.vin.len(), b.vout.len()))
+        .unwrap_or((0, 0));
+    let (s_sp, s_out) = tx
+        .sapling_bundle()
+        .map(|b| (b.shielded_spends().len(), b.shielded_outputs().len()))
+        .unwrap_or((0, 0));
+    TxShape {
+        txid: tx.txid().to_string(),
+        version: format!("{:?}", tx.version()),
+        consensus_branch_id: branch_hex(u32::from(tx.consensus_branch_id())),
+        transparent_inputs: t_in,
+        transparent_outputs: t_out,
+        sapling_spends: s_sp,
+        sapling_outputs: s_out,
+        orchard_actions: tx.orchard_bundle().map(|b| b.actions().len()).unwrap_or(0),
+        ironwood_actions: tx.ironwood_bundle().map(|b| b.actions().len()).unwrap_or(0),
+        has_orchard_bundle: tx.orchard_bundle().is_some(),
+        has_ironwood_bundle: tx.ironwood_bundle().is_some(),
+        has_sprout_bundle: tx.sprout_bundle().is_some(),
+    }
+}
+
+/// Checks a built transaction before it can be broadcast: version 5, consensus branch = this
+/// build's branch, no Orchard, Ironwood or Sprout bundle, and the shape `kind` asks for.
+pub fn check_transaction(tx: &Transaction, kind: TxKind) -> Result<(), Error> {
+    let violation = |m: String| Err(Error::SaplingOnlyViolation(m));
+    let s = inspect(tx);
+    if tx.version() != TX_VERSION {
+        return violation(format!(
+            "transaction {} has version {}, expected {:?}",
+            s.txid, s.version, TX_VERSION
+        ));
+    }
+    if !supports_branch(u32::from(tx.consensus_branch_id())) {
+        return violation(format!(
+            "transaction {} commits to branch {}, this build supports {}",
+            s.txid,
+            s.consensus_branch_id,
+            supported_branches_hex()
+        ));
+    }
+    if s.has_orchard_bundle || s.has_ironwood_bundle || s.has_sprout_bundle {
+        return violation(format!(
+            "transaction {} has an Orchard, Ironwood or Sprout bundle",
+            s.txid
+        ));
+    }
+    let shielding_shape = s.transparent_inputs > 0
+        && s.transparent_outputs == 0
+        && s.sapling_spends == 0
+        && s.sapling_outputs > 0;
+    let payment_shape = |t_out: Option<usize>| {
+        s.transparent_inputs == 0
+            && s.sapling_spends > 0
+            && t_out.map_or(true, |n| s.transparent_outputs == n)
+    };
+    let ok = match kind {
+        TxKind::Shielding => shielding_shape,
+        TxKind::Payment {
+            transparent_outputs,
+        } => payment_shape(Some(transparent_outputs)),
+        TxKind::Any => shielding_shape || payment_shape(None),
+    };
+    if !ok {
+        return violation(format!(
+            "transaction {} does not have the expected {:?} shape: {:?}",
+            s.txid, kind, s
+        ));
+    }
+    Ok(())
+}
+
+/// What the game shows about sending (see `WebWallet::sending_status`).
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct SendingStatus {
+    /// true only when the chain's branch equals `expected_branch` (and no network upgrade is
+    /// about to activate).
+    pub allowed: bool,
+    /// The branch this build targets, e.g. "37a5165b".
+    pub expected_branch: String,
+    /// The branch lightwalletd reports for its chain tip, or null when it could not be read.
+    pub chain_branch: Option<String>,
+    /// lightwalletd's chain name ("main", "test", "regtest"), when known.
+    pub chain_name: Option<String>,
+    /// lightwalletd's tip height, when known.
+    pub chain_tip: Option<u64>,
+    /// The branch this build's own consensus rules give the next block, when the tip is known.
+    pub next_block_branch: Option<String>,
+    /// The next network upgrade lightwalletd announces (name, height), when one is scheduled.
+    pub pending_upgrade: Option<PendingUpgrade>,
+    /// Pools this build can spend from / pay to.
+    pub pools: Vec<String>,
+    /// The stable error code when `allowed` is false: `consensus_branch_mismatch`,
+    /// `consensus_upgrade_pending` or `consensus_branch_unknown`.
+    pub code: Option<String>,
+    /// Error code + explanation when `allowed` is false.
+    pub reason: Option<String>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]

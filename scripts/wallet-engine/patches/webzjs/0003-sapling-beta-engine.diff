+    "consensus_upgrade_pending",
+    "consensus_branch_unknown",
+    "sapling_only_violation",
+    "insufficient_funds",
+    "nothing_to_shield",
+    "wallet_not_synced",
+    "proposal_failed",
+    "transaction_build_failed",
+    "broadcast_failed",
+    "broadcast_uncertain",
+];
+
+/// Returns the stable code a message starts with (`"<code>: ..."`), if any. Errors that cross a
+/// Web Worker boundary travel as strings, so the code is recovered from the message prefix.
+pub fn error_code_of(message: &str) -> Option<&'static str> {
+    ERROR_CODES
+        .iter()
+        .find(|code| {
+            message.starts_with(*code) && message[code.len()..].starts_with(':')
+        })
+        .copied()
+}
+
+impl Error {
+    /// Restores an error that crossed a worker boundary as a string: coded messages keep their
+    /// code, anything else becomes `transaction_build_failed`.
+    pub fn from_worker(message: String) -> Error {
+        if error_code_of(&message).is_some() {
+            Error::Coded(message)
+        } else {
+            Error::TransactionBuildFailed(message)
+        }
+    }
+
+    /// Adds "output <i>: " after the code, so the game can point at the offending output.
+    pub fn at_output(self, index: usize) -> Error {
+        let message = self.to_string();
+        match error_code_of(&message) {
+            Some(code) => Error::Coded(format!(
+                "{}: output {}: {}",
+                code,
+                index,
+                message[code.len() + 1..].trim_start()
+            )),
+            None => self,
+        }
+    }
+
+    /// The stable code of this error, if it has one.
+    pub fn code(&self) -> Option<&'static str> {
+        error_code_of(&self.to_string())

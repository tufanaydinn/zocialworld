+    pub txids: Vec<String>,
+    /// ZIP 317 network fee in zatoshis.
+    pub fee_zat: u64,
+    /// Sum of the outputs' amounts (excluding the network fee and change).
+    pub amount_zat: u64,
+    /// The outputs as resolved (the receiver actually paid).
+    pub outputs: Vec<ResolvedOutputInfo>,
+}
+
+#[derive(Clone, Debug, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ResolvedOutputInfo {
+    /// The receiver paid: a plain Sapling (zs1…) or, for a withdrawal, transparent (t1…) address.
+    pub to: String,
+    pub pool: OutputPool,
+    pub amount_zat: u64,
+    pub has_memo: bool,
+}
+
+/// Sapling beta: what a `shield` built (or would build).
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ShieldResult {
+    /// Transaction id (byte-reversed hex); empty for a preview.
+    pub txid: String,
+    /// Number of transparent UTXOs spent.
+    pub utxos: usize,
+    /// Value of the transparent UTXOs spent.
+    pub transparent_in_zat: u64,
+    /// ZIP 317 network fee.
+    pub fee_zat: u64,
+    /// Value arriving in the wallet's Sapling balance (transparent_in - fee).
+    pub shielded_zat: u64,
+}
+
+fn shield_result<N>(proposal: &Proposal<StandardFeeRule, N>) -> ShieldResult {
+    let step = &proposal.steps().head;
+    let inputs = step.transparent_inputs();
+    ShieldResult {
+        txid: String::new(),
+        utxos: inputs.len(),
+        transparent_in_zat: inputs
+            .iter()
+            .map(|i| u64::from(i.txout().value()))
+            .sum(),
+        fee_zat: step.balance().fee_required().into(),
+        shielded_zat: step
+            .balance()
+            .proposed_change()
+            .iter()
+            .map(|c| u64::from(c.value()))
+            .sum(),
+    }
+}
+
+/// Sapling beta: an account's balances (zatoshis). Orchard/Ironwood funds are never counted: this
+/// build cannot see or spend them.
+#[derive(Clone, Debug, Default, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Balances {
+    /// Shielded (Sapling) value that can be sent now.
+    pub sapling_spendable_zat: u64,
+    /// Sapling change from the wallet's own recent transactions, waiting for confirmation.
+    pub sapling_pending_change_zat: u64,
+    /// Sapling value received but not yet confirmed enough to spend.
+    pub sapling_pending_zat: u64,
+    /// All Sapling value the wallet knows (spendable + pending).
+    pub sapling_total_zat: u64,
+    /// Transparent value waiting to be shielded that `shield` can spend now (confirmed UTXOs).
+    pub transparent_shieldable_zat: u64,
+    /// Transparent value not yet confirmed enough (the memory backend reports confirmed UTXOs
+    /// only, so this is normally 0: deposits appear once mined).
+    pub transparent_pending_zat: u64,
+    /// All transparent value waiting to be shielded.
+    pub transparent_total_zat: u64,
+    pub chain_tip_height: u32,
+    pub fully_scanned_height: u32,
+}

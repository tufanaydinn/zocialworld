+/// 1 zatoshi, i.e. no extra minimum. Upstream compares the threshold with the WHOLE
+/// transparent input, and the change strategy already refuses an input that cannot pay the network
+/// fee plus a non-dust shielded amount, so a higher default only left small deposits (say 0.0009
+/// ZEC) stuck as "waiting to be shielded". Not 0: with every input dropped as dust, 0 would reach
+/// an empty proposal (`proposal_failed`) instead of `nothing_to_shield`.
+const DEFAULT_SHIELDING_THRESHOLD_ZAT: u64 = 1;
+
+fn shielding_threshold(threshold_zat: Option<u64>) -> Result<zcash_protocol::value::Zatoshis, Error> {
+    let zat = threshold_zat.unwrap_or(DEFAULT_SHIELDING_THRESHOLD_ZAT);
+    zcash_protocol::value::Zatoshis::from_u64(zat)
+        .map_err(|_| Error::InvalidAmountZat(format!("shielding threshold {}", zat)))
+}
+
+/// Parses `[{ to, amountZat, memo?, withdrawal? }]` from JavaScript.
+fn parse_outputs(value: &JsValue) -> Result<Vec<crate::sapling_beta::OutputRequest>, Error> {
+    use crate::sapling_beta::{parse_amount, parse_memo, OutputRequest, MAX_OUTPUTS};
+    let bad = |m: String| Error::InvalidOutputs(m);
+    if !js_sys::Array::is_array(value) {
+        return Err(bad("outputs must be an array of { to, amountZat, memo?, withdrawal? }".into()));
+    }
+    let arr = js_sys::Array::from(value);
+    if arr.length() == 0 {
+        return Err(bad("at least one output is required".into()));
+    }
+    if arr.length() as usize > MAX_OUTPUTS {
+        return Err(bad(format!("at most {} outputs are allowed", MAX_OUTPUTS)));
+    }
+    let get = |obj: &JsValue, key: &str| js_sys::Reflect::get(obj, &JsValue::from_str(key)).unwrap_or(JsValue::UNDEFINED);
+    let mut outputs = Vec::with_capacity(arr.length() as usize);
+    for (i, item) in arr.iter().enumerate() {
+        if !item.is_object() {
+            return Err(bad(format!("output {} is not an object", i)));
+        }
+        let to = get(&item, "to")
+            .as_string()
+            .ok_or_else(|| bad(format!("output {}: `to` must be an address string", i)))?;
+        let to = ZcashAddress::try_from_encoded(to.trim())
+            .map_err(|e| Error::from(e).at_output(i))?;
+        let amount_js = get(&item, "amountZat");
+        let zat: u64 = if let Some(n) = amount_js.as_f64() {
+            if !(n.is_finite() && n.fract() == 0.0 && n >= 0.0 && n <= 9_007_199_254_740_991.0) {
+                return Err(Error::InvalidAmountZat(format!("output {}: amountZat {} is not a whole number of zatoshis", i, n)));
+            }
+            n as u64
+        } else if amount_js.is_bigint() {
+            u64::try_from(js_sys::BigInt::from(amount_js.clone()))
+                .map_err(|_| Error::InvalidAmountZat(format!("output {}: amountZat is out of range", i)))?
+        } else if let Some(s) = amount_js.as_string() {
+            s.trim()
+                .parse::<u64>()
+                .map_err(|_| Error::InvalidAmountZat(format!("output {}: amountZat {:?} is not a whole number of zatoshis", i, s)))?
+        } else {
+            return Err(Error::InvalidAmountZat(format!("output {}: amountZat is missing", i)));
+        };
+        let amount = parse_amount(zat).map_err(|e| e.at_output(i))?;
+        let memo_js = get(&item, "memo");
+        let memo = if memo_js.is_undefined() || memo_js.is_null() {
+            None
+        } else {
+            let text = memo_js
+                .as_string()
+                .ok_or_else(|| bad(format!("output {}: `memo` must be a string", i)))?;
+            Some(parse_memo(&text).map_err(|e| e.at_output(i))?)
+        };
+        let withdrawal_js = get(&item, "withdrawal");
+        let withdrawal = if withdrawal_js.is_undefined() || withdrawal_js.is_null() {
+            false
+        } else {
+            withdrawal_js
+                .as_bool()
+                .ok_or_else(|| bad(format!("output {}: `withdrawal` must be a boolean", i)))?
+        };
+        outputs.push(OutputRequest {
+            to,
+            amount,
+            memo,
+            withdrawal,
+        });
+    }
+    Ok(outputs)
+}

+/// Legacy Orchard notes (TESTING ONLY, run by hand): a regtest chain where NU6.3 activates late
+/// (zebrad `"NU6.3" = 130`), with an Orchard coinbase mined to A before NU6.3, and an engine built
+/// with the same activation height:
+/// `ZW_REGTEST_NU6_3_HEIGHT=130 cargo test --release -p webzjs-wallet --lib --features regtest live_regtest_legacy_orchard -- --ignored --nocapture`
+/// A spends its Orchard note after NU6.3: the transaction must spend from the (withdraw-only)
+/// Orchard pool, pay Ironwood + Sapling outputs, and return the change to Ironwood.
+#[cfg(feature = "regtest")]
+#[tokio::test(flavor = "multi_thread")]
+#[ignore]
+async fn live_regtest_legacy_orchard_spend() {
+    use crate::policy::OutputRequest;
+    use crate::validation::validate_confirmations_policy;
+    use crate::Wallet;
+    let rpc = std::env::var("ZW_ZEBRA_RPC").unwrap_or_else(|_| "http://127.0.0.1:18832".into());
+    let lwd = std::env::var("ZW_LWD").unwrap_or_else(|_| "http://127.0.0.1:9567".into());
+    let zebra = |method: &str, params: &str| -> serde_json::Value {
+        let out = std::process::Command::new("curl")
+            .args([
+                "-s", "-X", "POST", "-H", "content-type: application/json", "--data",
+                &format!(r#"{{"jsonrpc":"2.0","id":1,"method":"{method}","params":{params}}}"#),
+                &rpc,
+            ])
+            .output()
+            .unwrap();
+        serde_json::from_slice(&out.stdout).unwrap()
+    };
+    let network = Network::TestNetwork;
+    assert!(
+        u32::from(zcash_protocol::consensus::Parameters::activation_height(&network, zcash_protocol::consensus::NetworkUpgrade::Nu6_3).unwrap()) > 1,
+        "build with ZW_REGTEST_NU6_3_HEIGHT"
+    );
+    let policy = validate_confirmations_policy(1, 1, true).unwrap();
+    let channel = tonic::transport::Channel::from_shared(lwd).unwrap().connect().await.unwrap();
+    let open = |name: &'static str| {
+        let channel = channel.clone();
+        async move {
+            let w = Wallet::new(Store::open(network, None).unwrap(), channel, network, policy).unwrap();
+            w.create_account(name, &regtest_seed(name), 0, Some(2), None).await.unwrap();
+            w.sync().await.unwrap();
+            w
+        }
+    };
+    let a = open("A").await;
+    let b = open("B").await;
+    let a0 = a.balances(0).await.unwrap();
+    println!("A before: {a0:?}");
+    assert!(a0.orchard_spendable_zat > 0, "A needs a legacy Orchard note: {a0:?}");
+    let ba = b.addresses(0).await.unwrap();
+    let (usk, _) = crate::wallet::usk_from_seed_str(&regtest_seed("A"), 0, &network).unwrap();
+    let out = |to: &str, zat: u64, memo: &str| OutputRequest {
+        to: zcash_address::ZcashAddress::try_from_encoded(to).unwrap(),
+        amount: crate::policy::parse_amount(zat).unwrap(),
+        memo: Some(crate::policy::parse_memo(memo).unwrap()),
+        withdrawal: false,
+    };
+    let a_id = a.account_uuid(0).await.unwrap();
+    let r = a
+        .send_payments(&usk, a_id, vec![out(&ba.unified_shielded, 100_000_000, "zw-pay:v1:from legacy Orchard"), out(&ba.sapling, 50_000_000, "zw-pay:v1:to zs1")])
+        .await
+        .unwrap();
+    println!("SENT {}", serde_json::to_string(&r).unwrap());
+    let raw = zebra("getrawtransaction", &format!(r#"["{}", 0]"#, r.txids[0]))["result"].as_str().unwrap().to_string();
+    zebra("generate", "[1]");
+    let d = &zebra("getrawtransaction", &format!(r#"["{}", 1]"#, r.txids[0]))["result"];
+    let n = |v: &serde_json::Value| v.as_array().map_or(0, |x| x.len());
+    println!(
+        "DECODED {}",
+        serde_json::json!({ "txid": r.txids[0], "version": d["version"], "height": d["height"],
+            "orchardActions": n(&d["orchard"]["actions"]), "orchardValueBalanceZat": d["orchard"]["valueBalanceZat"],
+            "ironwoodActions": n(&d["ironwood"]["actions"]), "ironwoodValueBalanceZat": d["ironwood"]["valueBalanceZat"],
+            "saplingSpends": n(&d["vShieldedSpend"]), "saplingOutputs": n(&d["vShieldedOutput"]),
+            "vin": n(&d["vin"]), "vout": n(&d["vout"]), "feeZat": r.fee_zat, "rawTxHex": raw })
+    );
+    assert_eq!(d["version"], 6);
+    assert!(n(&d["orchard"]["actions"]) > 0, "spends from the Orchard pool");
+    assert!(d["orchard"]["valueBalanceZat"].as_i64().unwrap() > 0, "value leaves the Orchard pool");
+    assert!(n(&d["ironwood"]["actions"]) > 0 && n(&d["vShieldedOutput"]) > 0);
+    tokio::time::sleep(std::time::Duration::from_secs(4)).await;
+    a.sync().await.unwrap();
+    b.sync().await.unwrap();
+    let a1 = a.balances(0).await.unwrap();
+    let b1 = b.balances(0).await.unwrap();
+    println!("A after: {a1:?}\nB after: {b1:?}");
+    // A holds several Orchard coinbase notes and spends one: the Orchard total falls by exactly the
+    // value that left the pool (no Orchard change), and the change arrives in Ironwood.
+    let orchard_out = d["orchard"]["valueBalanceZat"].as_i64().unwrap() as u64;
+    assert_eq!(a1.orchard_total_zat, a0.orchard_total_zat - orchard_out, "no Orchard change");
+    assert_eq!(a1.ironwood_total_zat, a0.ironwood_total_zat + orchard_out - 150_000_000 - r.fee_zat, "change in Ironwood");
+    assert_eq!(a1.total_zat, a0.total_zat - 150_000_000 - r.fee_zat);
+    assert!(b1.ironwood_total_zat >= 100_000_000 && b1.sapling_total_zat >= 50_000_000);
+}

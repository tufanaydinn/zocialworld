+    let b1 = b.balances(0).await.unwrap();
+    assert_eq!(a1.ironwood_total_zat, a0.ironwood_total_zat + 100_000_000);
+    assert_eq!(b1.shielded_total_zat, b0.shielded_total_zat - 100_000_000 - 75_000 - r.fee_zat);
+    let h = a.transaction_history(0, 10, 0).await.unwrap();
+    assert!(h.transactions.iter().any(|t| t.txid == r.txids[0] && t.memo.as_deref() == Some("zw-pay:v1:native")), "{h:?}");
+}

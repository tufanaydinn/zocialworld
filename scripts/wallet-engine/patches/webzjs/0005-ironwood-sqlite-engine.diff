+++ b/crates/webzjs-wallet/src/db.rs
@@ -0,0 +1,672 @@
+//! Stage 2 (ADR-018 § 3): the engine's wallet database — the upstream SQLite wallet backend
+//! (`zcash_client_sqlite`, same librustzcash revision as the rest of the engine).
+//!
+//! * **Where it lives.** On wasm32-unknown-unknown SQLite comes from sqlite-wasm-rs (through the
+//!   libsqlite3-sys shim in `zw/libsqlite3-sys-shim`); the database is a file in its in-memory VFS.
+//!   Natively (unit tests) it is a file in the temp directory. Persistence is unchanged for the game:
+//!   it stores `db_to_bytes()` (the database file's bytes) and passes them back to the constructor.
+//! * **Lifetime.** [`Store`] owns the one connection and the file; when the last clone of the
+//!   wallet is dropped (JS `free()` or garbage collection), the connection is closed and the file is
+//!   deleted from the memory VFS.
+//! * **Lock discipline.** SQLite is built without thread safety (`THREADSAFE=0`) inside a threaded
+//!   engine, and a `rusqlite::Connection` is `Send` but not `Sync`. Every access to the database goes
+//!   through ONE [`DbLock`] (a `tokio::sync::Mutex`). Rules:
+//!   1. never open a second connection to the wallet file;
+//!   2. never touch the connection outside the lock (`db_to_bytes` exports under it);
+//!   3. never call another locking method while holding the lock (a re-entrant `lock()` would wait
+//!      for itself forever). Rule 3 is checked at run time: every engine entry point runs in a
+//!      [`lock_scope`] (a task-local counter), and `lock()` refuses with [`Error::NestedLock`]
+//!      instead of deadlocking when the same task already holds the guard;
+//!   4. hold the guard across an `.await` only where unavoidable: `sync` (upstream `sync::run`
+//!      needs `&mut` to the database for the whole scan) — it runs alone in its own Web Worker.
+
+use std::cell::Cell;
+use std::collections::BTreeMap;
+use std::convert::Infallible;
+use std::future::Future;
+use std::sync::atomic::{AtomicU32, Ordering};
+use std::time::SystemTime;
+
+use async_trait::async_trait;
+use rand_core::OsRng;
+use zcash_client_backend::data_api::chain::{error::Error as ChainError, BlockCache, BlockSource};
+use zcash_client_backend::data_api::scanning::ScanRange;
+use zcash_client_backend::proto::compact_formats::CompactBlock;
+use zcash_client_sqlite::{util::Clock, wallet::init::init_wallet_db, WalletDb};
+use zcash_protocol::consensus::BlockHeight;
+
+use crate::error::Error;
+use webzjs_common::Network;
+
+/// `SystemTime::now()` panics on wasm32-unknown-unknown; the engine reads the JS clock there.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct EngineClock;
+
+impl Clock for EngineClock {
+    fn now(&self) -> SystemTime {
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        {
+            std::time::UNIX_EPOCH
+                + std::time::Duration::from_millis(js_sys::Date::now().max(0.0) as u64)
+        }
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        {
+            SystemTime::now()
+        }
+    }
+}
+
+/// The wallet database as the upstream data-access traits see it: a short-lived view over the
+/// store's connection, created under the lock for each operation.
+pub type Wdb<'a> = WalletDb<&'a mut rusqlite::Connection, Network, EngineClock, OsRng>;
+
+/// The wallet database file. On wasm it is a file in sqlite-wasm-rs's in-memory VFS; natively a
+/// file in the temp directory.
+#[derive(Clone, Debug)]
+pub struct DbFile {
+    name: String,
+}
+
+static NEXT_DB: AtomicU32 = AtomicU32::new(0);
+
+/// Prefix of every wallet database file name (see [`open_database_files`]).
+const DB_FILE_PREFIX: &str = "zw-wallet-";
+
+impl DbFile {
+    fn fresh() -> Self {
+        let n = NEXT_DB.fetch_add(1, Ordering::Relaxed);
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        let name = format!("{DB_FILE_PREFIX}{n}.sqlite");
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        let name = std::env::temp_dir()
+            .join(format!("{DB_FILE_PREFIX}{}-{n}.sqlite", std::process::id()))
+            .to_string_lossy()
+            .into_owned();
+        DbFile { name }
+    }
+
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+
+    pub fn exists(&self) -> bool {
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        return libsqlite3_sys::mem_vfs::MemVfsUtil::new().exists(&self.name);
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        return std::path::Path::new(&self.name).exists();
+    }
+
+    /// Loads a saved database file. Every save that cannot be a complete SQLite
+    /// database is refused with `wallet_format_unsupported` (the game then restores from the
+    /// seed) BEFORE it reaches sqlite-wasm-rs: its `import_db` does not check the page size, and
+    /// a page size of 0 hits an `assert!` there (a trap of the whole wasm instance, with the
+    /// memory VFS's lock held).
+    fn import(&self, bytes: &[u8]) -> Result<(), Error> {
+        if !is_sqlite_file(bytes) || !has_valid_page_layout(bytes) {
+            return Err(Error::WalletFormatUnsupported);
+        }
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        libsqlite3_sys::mem_vfs::MemVfsUtil::new()
+            .import_db(&self.name, bytes)
+            .map_err(|e| {
+                tracing::warn!("the saved wallet could not be loaded: {e}");
+                Error::WalletFormatUnsupported
+            })?;
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        std::fs::write(&self.name, bytes)?;
+        Ok(())
+    }
+
+    /// The database file's bytes. Only call it through [`Store::export`] (under the lock, no
+    /// transaction open, so the file is complete).
+    fn export(&self) -> Result<Vec<u8>, Error> {
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        return libsqlite3_sys::mem_vfs::MemVfsUtil::new()
+            .export_db(&self.name)
+            .map_err(|e| Error::Generic(format!("could not export the wallet: {e}")));
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        return Ok(std::fs::read(&self.name)?);
+    }
+
+    /// Removes the file (and, natively, SQLite's side files); only once its connection is closed.
+    fn remove(&self) {
+        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+        libsqlite3_sys::mem_vfs::MemVfsUtil::new().delete_db(&self.name);
+        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+        for suffix in ["", "-journal", "-wal", "-shm"] {
+            let _ = std::fs::remove_file(format!("{}{suffix}", self.name));
+        }
+    }
+}
+
+/// Whether `bytes` start with the SQLite file header ("SQLite format 3\0").
+pub fn is_sqlite_file(bytes: &[u8]) -> bool {
+    bytes.len() >= 100 && &bytes[..16] == b"SQLite format 3\0"
+}
+
+/// Whether a file with a SQLite header has a valid page size (header bytes 16-17, big-endian, a
+/// power of two from 512 to 32768, or 1 meaning 65536; sqlite.org/fileformat2.html § 1.3.2) and
+/// consists of whole pages (at least one).
+pub fn has_valid_page_layout(bytes: &[u8]) -> bool {
+    if bytes.len() < 18 {
+        return false;
+    }
+    let page_size = match u16::from_be_bytes([bytes[16], bytes[17]]) {
+        1 => 65_536usize,
+        n => n as usize,
+    };
+    (512..=65_536).contains(&page_size)
+        && page_size.is_power_of_two()
+        && bytes.len() >= page_size
+        && bytes.len() % page_size == 0
+}
+
+/// Whether an error opening a SAVED file means the bytes are not a usable SQLite database
+/// (not a database, or corrupt), as opposed to an engine or migration problem.
+fn is_damaged_database(e: &Error) -> bool {
+    let code = match e {
+        Error::Rusqlite(rusqlite::Error::SqliteFailure(f, _)) => Some(f.code),
+        _ => None,
+    };
+    matches!(
+        code,
+        Some(rusqlite::ErrorCode::NotADatabase) | Some(rusqlite::ErrorCode::DatabaseCorrupt)
+    )
+}
+
+/// The wallet database files currently held by this engine instance (diagnostics: a dropped
+/// wallet must leave none behind). On wasm these are the files in the memory VFS.
+pub fn open_database_files() -> Vec<String> {
+    #[cfg(all(target_family = "wasm", target_os = "unknown"))]
+    {
+        let mut files: Vec<String> = libsqlite3_sys::mem_vfs::MemVfsUtil::new()
+            .list()
+            .into_iter()
+            .filter(|f| f.starts_with(DB_FILE_PREFIX))
+            .collect();
+        files.sort();
+        files
+    }
+    #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+    {
+        let prefix = format!("{DB_FILE_PREFIX}{}-", std::process::id());
+        let mut files: Vec<String> = std::fs::read_dir(std::env::temp_dir())
+            .map(|dir| {
+                dir.filter_map(|e| e.ok())
+                    .map(|e| e.file_name().to_string_lossy().into_owned())
+                    .filter(|f| f.starts_with(&prefix) && f.ends_with(".sqlite"))
+                    .collect()
+            })
+            .unwrap_or_default();
+        files.sort();
+        files
+    }
+}
+
+/// The SQLite connection settings (Stage 2 sync tuning, see `API-v2.md` § Performance).
+///
+/// The file lives in memory and is persisted only through `db_to_bytes` (taken under the wallet
+/// lock, between transactions), so durability buys nothing here:
+/// * `journal_mode = MEMORY` keeps the rollback journal in SQLite's heap (transactions still roll
+///   back on error; `OFF` would not);
+/// * `synchronous = OFF` skips the VFS sync calls;
+/// * `temp_store = MEMORY` keeps temporary b-trees (sorts, `GROUP BY` of the balance views) off the
+///   VFS;
+/// * `cache_size = -65536` (64 MiB page cache) keeps the commitment-tree shards and the scan queue
+///   hot, so a sync batch does not re-read pages through the VFS lock;
+/// * `locking_mode = EXCLUSIVE`: the engine is the file's only user, so SQLite takes the file lock
+///   once instead of per transaction.
+pub const CONNECTION_PRAGMAS: &str = "PRAGMA journal_mode = MEMORY; \
+     PRAGMA synchronous = OFF; \
+     PRAGMA temp_store = MEMORY; \
+     PRAGMA cache_size = -65536; \
+     PRAGMA locking_mode = EXCLUSIVE;";
+
+/// Databases smaller than this many pages (4 KiB each) are never compacted.
+pub const COMPACT_MIN_PAGES: i64 = 256;
+
+/// The engine's single connection to the wallet database and the file it lives in.
+pub struct Store {
+    conn: Option<rusqlite::Connection>,
+    file: DbFile,
+    network: Network,
+}
+
+impl Store {
+    /// Opens a new wallet database, or restores one from `db_to_bytes()` output, and runs every
+    /// zcash_client_sqlite migration (an older saved database is upgraded in place). A save that
+    /// is not a SQLite database (a Stage-1 memory-backend save) is refused with
+    /// `wallet_format_unsupported`.
+    pub fn open(network: Network, saved: Option<&[u8]>) -> Result<Store, Error> {
+        Self::open_file(DbFile::fresh(), network, saved)
+    }
+
+    fn open_file(file: DbFile, network: Network, saved: Option<&[u8]>) -> Result<Store, Error> {
+        if file.exists() {
+            file.remove();
+        }
+        if let Some(bytes) = saved {
+            file.import(bytes)?;
+        }
+        let opened = (|| -> Result<rusqlite::Connection, Error> {
+            let conn = rusqlite::Connection::open(&file.name)?;
+            conn.execute_batch(CONNECTION_PRAGMAS)?;
+            // zcash_client_sqlite needs the `rarray` virtual table (`WalletDb::for_path` loads it).
+            rusqlite::vtab::array::load_module(&conn)?;
+            Ok(conn)
+        })();
+        let mut store = Store {
+            conn: None,
+            file: file.clone(),
+            network,
+        };
+        match opened {
+            Ok(conn) => store.conn = Some(conn),
+            Err(e) => {
+                file.remove();
+                // A damaged save (a bad page size, a corrupt first page) already
+                // fails here, on the first PRAGMA.
+                return Err(if saved.is_some() && is_damaged_database(&e) {
+                    Error::WalletFormatUnsupported
+                } else {
+                    e
+                });
+            }
+        }
+        if let Err(e) = init_wallet_db(&mut store.wdb(), None) {
+            // `store` is dropped here: the connection is closed and the file removed.
+            let detail = format!("{e:?}");
+            return Err(
+                if saved.is_some()
+                    && (detail.contains("NotADatabase") || detail.contains("DatabaseCorrupt"))
+                {
+                    Error::WalletFormatUnsupported
+                } else {
+                    Error::SqliteMigration(detail)
+                },
+            );
+        }
+        Ok(store)
+    }
+
+    /// The upstream wallet database over this connection.
+    pub fn wdb(&mut self) -> Wdb<'_> {
+        let network = self.network;
+        WalletDb::from_connection(
+            self.conn.as_mut().expect("the connection is open until drop"),
+            network,
+            EngineClock,
+            OsRng,
+        )
+    }
+
+    /// A read-only view of the upstream wallet database (`&self`: no writes).
+    pub fn wdb_ro(&self) -> WalletDb<&rusqlite::Connection, Network, EngineClock, OsRng> {
+        WalletDb::from_connection(self.conn(), self.network, EngineClock, OsRng)
+    }
+
+    /// Read-only SQL access for the engine's own queries (history).
+    pub fn conn(&self) -> &rusqlite::Connection {
+        self.conn.as_ref().expect("the connection is open until drop")
+    }
+
+    /// The database file's bytes. `&mut self` proves the caller holds the lock; no SQLite
+    /// transaction is open between engine operations, so the file is complete. A fragmented
+    /// database is compacted first, so saves never carry free pages.
+    pub fn export(&mut self) -> Result<Vec<u8>, Error> {
+        debug_assert!(self.conn().is_autocommit(), "export inside a transaction");
+        self.compact_if_fragmented()?;
+        self.file.export()
+    }
+
+    /// Rewrites the database without its free pages (`VACUUM`) once at least a quarter of a
+    /// non-trivial database is free. Each scan batch rewrites tree shards, checkpoints and the
+    /// nullifier map, which leaves most pages free after a large sync (measured: 1,333 of 1,741
+    /// pages after 5,500 mainnet blocks in batches of 5,000); they would otherwise stay in
+    /// memory and in every save. Returns whether the database was compacted.
+    pub fn compact_if_fragmented(&mut self) -> Result<bool, Error> {
+        let conn = self.conn();
+        let pages: i64 = conn.query_row("PRAGMA page_count", [], |r| r.get(0))?;
+        let free: i64 = conn.query_row("PRAGMA freelist_count", [], |r| r.get(0))?;
+        if pages >= COMPACT_MIN_PAGES && free * 4 >= pages {
+            conn.execute_batch("VACUUM")?;
+            return Ok(true);
+        }
+        Ok(false)
+    }
+
+    pub fn file(&self) -> &DbFile {
+        &self.file
+    }
+}
+
+impl Drop for Store {
+    fn drop(&mut self) {
+        // Close the connection first, then delete the file it used.
+        drop(self.conn.take());
+        self.file.remove();
+        tracing::debug!("wallet database {} closed and removed", self.file.name);
+    }
+}
+
+// ---- lock discipline -------------------------------------------------------------------------
+
+#[derive(Default)]
+pub struct LockScope {
+    /// How many wallet-database guards this task holds (0 or 1: a second is refused).
+    held: Cell<u32>,
+}
+
+tokio::task_local! {
+    static LOCK_SCOPE: LockScope;
+}
+
+/// Runs an engine operation inside a lock scope (a no-op when the caller already runs in one), so
+/// that [`DbLock::lock`] can tell a re-entrant acquisition (which would deadlock) from a wait for
+/// another task.
+pub async fn lock_scope<F: Future>(f: F) -> F::Output {
+    if LOCK_SCOPE.try_with(|_| ()).is_ok() {
+        f.await
+    } else {
+        LOCK_SCOPE.scope(LockScope::default(), f).await
+    }
+}
+
+/// Whether the current task holds the wallet lock (false outside a lock scope).
+pub fn lock_held_by_current_task() -> bool {
+    LOCK_SCOPE.try_with(|s| s.held.get() > 0).unwrap_or(false)
+}
+
+/// The one lock around the wallet database.
+pub struct DbLock {
+    inner: tokio::sync::Mutex<Store>,
+}
+
+pub struct DbGuard<'a> {
+    guard: tokio::sync::MutexGuard<'a, Store>,
+}
+
+impl DbLock {
+    pub fn new(store: Store) -> Self {
+        DbLock {
+            inner: tokio::sync::Mutex::new(store),
+        }
+    }
+
+    /// Acquires the wallet database. `site` names the caller for the nested-lock error.
+    ///
+    /// Refuses with [`Error::NestedLock`] — instead of waiting forever — when the current task
+    /// already holds the lock (rule 3 of the module docs). Outside a [`lock_scope`] the check
+    /// cannot run; debug builds assert that every caller is inside one.
+    pub async fn lock(&self, site: &'static str) -> Result<DbGuard<'_>, Error> {
+        match LOCK_SCOPE.try_with(|s| s.held.get()) {
+            Ok(0) => {}
+            Ok(_) => {
+                tracing::error!("nested wallet database lock in {site}");
+                return Err(Error::NestedLock(site));
+            }
+            Err(_) => debug_assert!(false, "wallet database locked outside a lock scope ({site})"),
+        }
+        let guard = self.inner.lock().await;
+        let _ = LOCK_SCOPE.try_with(|s| s.held.set(s.held.get() + 1));
+        Ok(DbGuard { guard })
+    }
+}
+
+impl Drop for DbGuard<'_> {
+    fn drop(&mut self) {
+        let _ = LOCK_SCOPE.try_with(|s| s.held.set(s.held.get().saturating_sub(1)));
+    }
+}
+
+impl std::ops::Deref for DbGuard<'_> {
+    type Target = Store;
+    fn deref(&self) -> &Store {
+        &self.guard
+    }
+}
+
+impl std::ops::DerefMut for DbGuard<'_> {
+    fn deref_mut(&mut self) -> &mut Store {
+        &mut self.guard
+    }
+}
+
+// ---- compact block cache for sync -------------------------------------------------------------
+
+/// The compact blocks of the scan range being processed (replaces `zcash_client_memory`'s
+/// `MemBlockCache`, which went with the memory backend). Blocks are dropped as soon as their range
+/// has been scanned.
+#[derive(Default)]
+pub struct BlockMemCache(std::sync::Mutex<BTreeMap<BlockHeight, CompactBlock>>);
+
+impl BlockMemCache {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn blocks(&self) -> std::sync::MutexGuard<'_, BTreeMap<BlockHeight, CompactBlock>> {
+        self.0.lock().unwrap_or_else(|poisoned| poisoned.into_inner())
+    }
+}
+
+impl BlockSource for BlockMemCache {
+    type Error = Infallible;
+
+    fn with_blocks<F, WalletErrT>(
+        &self,
+        from_height: Option<BlockHeight>,
+        limit: Option<usize>,
+        mut with_block: F,
+    ) -> Result<(), ChainError<WalletErrT, Self::Error>>
+    where
+        F: FnMut(CompactBlock) -> Result<(), ChainError<WalletErrT, Self::Error>>,
+    {
+        // Clone the requested blocks out first: `with_block` runs the scan and must not run while
+        // the cache's mutex is held.
+        let selected: Vec<CompactBlock> = {
+            let blocks = self.blocks();
+            blocks
+                .range(from_height.unwrap_or(BlockHeight::from_u32(0))..)
+                .take(limit.unwrap_or(usize::MAX))
+                .map(|(_, b)| b.clone())
+                .collect()
+        };
+        for block in selected {
+            with_block(block)?;
+        }
+        Ok(())
+    }
+}
+
+#[async_trait]
+impl BlockCache for BlockMemCache {
+    fn get_tip_height(&self, range: Option<&ScanRange>) -> Result<Option<BlockHeight>, Self::Error> {
+        let blocks = self.blocks();
+        Ok(match range {
+            Some(range) => blocks
+                .range(range.block_range().clone())
+                .next_back()
+                .map(|(h, _)| *h),
+            None => blocks.last_key_value().map(|(h, _)| *h),
+        })
+    }
+
+    async fn read(&self, range: &ScanRange) -> Result<Vec<CompactBlock>, Self::Error> {
+        Ok(self
+            .blocks()
+            .range(range.block_range().clone())
+            .map(|(_, b)| b.clone())
+            .collect())
+    }
+
+    async fn insert(&self, compact_blocks: Vec<CompactBlock>) -> Result<(), Self::Error> {
+        let mut blocks = self.blocks();
+        for block in compact_blocks {
+            blocks.insert(block.height(), block);
+        }
+        Ok(())
+    }
+
+    async fn delete(&self, range: ScanRange) -> Result<(), Self::Error> {
+        let mut blocks = self.blocks();
+        let doomed: Vec<BlockHeight> = blocks
+            .range(range.block_range().clone())
+            .map(|(h, _)| *h)
+            .collect();
+        for h in doomed {
+            blocks.remove(&h);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_stage1_save_is_refused_with_a_code() {
+        // A Stage-1 (memory backend, protobuf) save.
+        let err = Store::open(Network::MainNetwork, Some(&[0x0a, 0x02, 0x08, 0x01]))
+            .err()
+            .expect("must refuse");
+        assert!(err.to_string().starts_with("wallet_format_unsupported:"), "{err}");
+        assert_eq!(err.code(), Some("wallet_format_unsupported"));
+        // A file that starts like SQLite but is garbage is refused too, with the same code (the
+        // game restores from the seed on it), and leaves no file behind.
+        let mut fake = b"SQLite format 3\0".to_vec();
+        fake.resize(4096, 0xAB);
+        let file = DbFile::fresh();
+        let err = Store::open_file(file.clone(), Network::MainNetwork, Some(&fake)).err().expect("must refuse");
+        assert_eq!(err.code(), Some("wallet_format_unsupported"), "{err}");
+        assert!(!file.exists(), "{err}");
+        assert!(open_database_files().iter().all(|f| !file.name().ends_with(f.as_str())));
+    }
+
+    /// Every damaged save gives `wallet_format_unsupported` (never an uncoded
+    /// error, never the page-size-0 `assert!` inside sqlite-wasm-rs's `import_db`).
+    #[test]
+    fn damaged_saves_are_refused_with_a_code() {
+        let refused = |bytes: &[u8], what: &str| {
+            let file = DbFile::fresh();
+            let err = Store::open_file(file.clone(), Network::MainNetwork, Some(bytes))
+                .err()
+                .unwrap_or_else(|| panic!("{what}: must refuse"));
+            assert_eq!(err.code(), Some("wallet_format_unsupported"), "{what}: {err}");
+            assert!(!file.exists(), "{what}");
+        };
+        let mut good = Store::open(Network::MainNetwork, None).unwrap().export().unwrap();
+        assert!(has_valid_page_layout(&good));
+        // page size 0 (header bytes 16-17)
+        let mut b = good.clone();
+        b[16] = 0;
+        b[17] = 0;
+        assert!(!has_valid_page_layout(&b));
+        refused(&b, "page size 0");
+        // not a power of two
+        b[16] = 0xAB;
+        b[17] = 0xAB;
+        refused(&b, "page size 0xABAB");
+        // truncated: not whole pages, and less than one page
+        refused(&good[..good.len() - 100], "truncated by 100 bytes");
+        refused(&good[..600], "600 bytes");
+        // whole pages, valid page size, garbage content
+        let mut g = good[..100].to_vec();
+        g.resize(good.len(), 0xAB);
+        refused(&g, "valid header, garbage pages");
+        // page 1's schema b-tree destroyed
+        b = good.clone();
+        for x in &mut b[100..4096] {
+            *x = 0xFF;
+        }
+        refused(&b, "corrupt first page");
+        // the intact save still opens; page size 65536 is written as 1
+        assert!(Store::open(Network::MainNetwork, Some(&good)).is_ok());
+        good[16] = 0;
+        good[17] = 1;
+        assert!(!has_valid_page_layout(&good[..4096 * 3]));
+    }
+
+    #[test]
+    fn the_database_file_is_deleted_when_the_store_is_dropped() {
+        let store = Store::open(Network::MainNetwork, None).unwrap();
+        let name = store.file().name().to_string();
+        assert!(std::path::Path::new(&name).exists());
+        drop(store);
+        assert!(!std::path::Path::new(&name).exists());
+    }
+
+    #[test]
+    fn connection_pragmas_are_applied() {
+        let store = Store::open(Network::MainNetwork, None).unwrap();
+        let q = |p: &str| -> String {
+            store
+                .conn()
+                .query_row(&format!("PRAGMA {p}"), [], |r| r.get::<_, rusqlite::types::Value>(0))
+                .map(|v| format!("{v:?}"))
+                .unwrap()
+        };
+        assert!(q("journal_mode").to_lowercase().contains("memory"));
+        assert!(q("locking_mode").to_lowercase().contains("exclusive"));
+        assert_eq!(q("synchronous"), "Integer(0)");
+        assert_eq!(q("temp_store"), "Integer(2)");
+        assert_eq!(q("cache_size"), "Integer(-65536)");
+    }
+
+    #[test]
+    fn a_fragmented_database_is_compacted_before_export() {
+        let mut store = Store::open(Network::MainNetwork, None).unwrap();
+        store
+            .conn()
+            .execute_batch(
+                "CREATE TABLE zw_filler (b BLOB);
+                 WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 2000)
+                 INSERT INTO zw_filler SELECT zeroblob(2000) FROM n;
+                 DELETE FROM zw_filler;",
+            )
+            .unwrap();
+        let free: i64 = store.conn().query_row("PRAGMA freelist_count", [], |r| r.get(0)).unwrap();
+        assert!(free > 900, "{free} free pages");
+        let bytes = store.export().unwrap();
+        let free: i64 = store.conn().query_row("PRAGMA freelist_count", [], |r| r.get(0)).unwrap();
+        assert_eq!(free, 0);
+        let pages: i64 = store.conn().query_row("PRAGMA page_count", [], |r| r.get(0)).unwrap();
+        assert_eq!(bytes.len() as i64, pages * 4096);
+        // and the compacted save restores
+        let restored = Store::open(Network::MainNetwork, Some(&bytes)).unwrap();
+        drop(restored);
+        // a small or unfragmented database is left alone
+        assert!(!store.compact_if_fragmented().unwrap());
+    }
+
+    /// Rule 3: a task that holds the lock and asks for it again gets `NestedLock` (instead of a
+    /// deadlock); other tasks simply wait; sequential use is fine.
+    #[tokio::test]
+    async fn nested_locking_is_refused_not_deadlocked() {
+        let lock = std::sync::Arc::new(DbLock::new(Store::open(Network::MainNetwork, None).unwrap()));
+        lock_scope(async {
+            let g = lock.lock("outer").await.unwrap();
+            assert!(lock_held_by_current_task());
+            match lock.lock("inner").await {
+                Err(Error::NestedLock(site)) => assert_eq!(site, "inner"),
+                Err(e) => panic!("unexpected error {e}"),
+                Ok(_) => panic!("a nested lock must be refused"),
+            }
+            drop(g);
+            assert!(!lock_held_by_current_task());
+            let _again = lock.lock("sequential").await.unwrap();
+        })
+        .await;
+        // Another task waiting for the lock is not mistaken for nesting.
+        let l2 = lock.clone();
+        let holder = lock_scope(async {
+            let _g = lock.lock("holder").await.unwrap();
+            tokio::task::yield_now().await;
+            tokio::task::yield_now().await;
+        });
+        let waiter = lock_scope(async move { l2.lock("waiter").await.is_ok() });
+        let (_, waited) = tokio::join!(holder, async { tokio::spawn(waiter).await.unwrap() });
+        assert!(waited);
+    }
+}

+    #[test]
+    fn player_payment_with_fee_output_is_one_v6_transaction() {
+        let (mut store, b) = wallet_b();
+        let a = addresses_of("A");
+        let project = addresses_of("PROJECT");
+        // The recipient seals its shielded-only UA (Orchard-family + Sapling); the project fee
+        // address is a zs1 here (a Sapling output in the same transaction).
+        let (proposal, kinds) = propose(
+            &mut store,
+            b,
+            vec![
+                out(&a.unified_shielded, 100_000, Some("zw-pay:v1:hello"), false),
+                out(&project.sapling, FEE_ZAT, Some("zw-fee:v1:n1"), false),
+            ],
+        )
+        .unwrap();
+        assert_eq!(kinds, vec![TxKind::Payment { transparent_outputs: 0 }]);
+        assert_eq!(proposal.proposed_version(), Some(policy::TX_VERSION));
+        assert_eq!(proposal.steps().len(), 1);
+        let step = &proposal.steps().head;
+        assert!(step.input_in_pool(PoolType::IRONWOOD));
+        assert!(!step.input_in_pool(PoolType::SAPLING) && !step.input_in_pool(PoolType::Transparent));
+        let pools: Vec<PoolType> = step.payment_pools().values().copied().collect();
+        assert_eq!(pools, vec![PoolType::IRONWOOD, PoolType::SAPLING]);
+        assert_eq!(step.balance().proposed_change().len(), 1);
+        assert!(step.change_in_pool(PoolType::IRONWOOD));
+        // Ironwood: 1 spend, 2 outputs (recipient + change) → 2 actions; Sapling: 0 spends,
+        // 1 output padded to 2 → 2 logical actions. ZIP 317: 4 × 5,000.
+        assert_eq!(u64::from(step.balance().fee_required()), zip317(4));
+        let change = u64::from(step.balance().proposed_change()[0].value());
+        assert_eq!(change + 100_000 + FEE_ZAT + zip317(4), 625_000_000);
+    }

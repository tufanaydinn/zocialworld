+
+    #[test]
+    fn unified_address_rules() {
+        let params = Network::MainNetwork;
+        // Orchard-only UA: now payable — an Ironwood output to its Orchard-family receiver.
+        for withdrawal in [false, true] {
+            let r = resolve_recipient(&params, &parse(ORCHARD_ONLY), withdrawal).unwrap();
+            assert_eq!(r.pool, OutputPool::Ironwood);
+            let ua = match r.address.clone().convert_if_network::<Address>(NetworkType::Main).unwrap() {
+                Address::Unified(ua) => ua,
+                other => panic!("expected a UA, got {other:?}"),
+            };
+            assert!(ua.orchard().is_some() && ua.sapling().is_none() && ua.transparent().is_none());
+        }
+        // Orchard + Sapling UA: its Orchard-family receiver (Ironwood), never Sapling.
+        let r = resolve_recipient(&params, &parse(ORCHARD_SAPLING), false).unwrap();
+        assert_eq!(r.pool, OutputPool::Ironwood);
+        assert!(r.address.encode().starts_with("u1"));
+        // Orchard + transparent UA: Ironwood, for payments and withdrawals (never transparent).
+        for withdrawal in [false, true] {
+            let r = resolve_recipient(&params, &parse(ORCHARD_TRANSPARENT), withdrawal).unwrap();
+            assert_eq!(r.pool, OutputPool::Ironwood);
+        }
+        // A Sapling + transparent UA (the Stage-1 main address): its Sapling receiver.
+        let sapling_t = UnifiedAddress::from_receivers(
+            None,
+            match parse(ORCHARD_SAPLING).convert_if_network::<Address>(NetworkType::Main).unwrap() {
+                Address::Unified(ua) => ua.sapling().copied(),
+                _ => None,
+            },
+            Some(TransparentAddress::PublicKeyHash([7u8; 20])),
+        )
+        .unwrap();
+        let r = resolve_recipient(&params, &Address::Unified(sapling_t).to_zcash_address(&params), true).unwrap();
+        assert_eq!(r.pool, OutputPool::Sapling);
+        assert!(r.address.encode().starts_with("zs1"));
+        // Output-level checks: memo on a transparent output, empty list, too many outputs.
+        let t = ZcashAddress::from_transparent_p2pkh(NetworkType::Main, [7u8; 20]).encode();
+        let out = |to: &str, withdrawal: bool, memo: bool| OutputRequest {
+            to: parse(to),

+/// Which pool a resolved output pays into.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "lowercase")]
+pub enum OutputPool {
+    Ironwood,
+    Sapling,
+    Transparent,
+}
+
+impl OutputPool {
+    pub fn pool_type(self) -> PoolType {
+        match self {
+            OutputPool::Ironwood => PoolType::IRONWOOD,
+            OutputPool::Sapling => PoolType::SAPLING,
+            OutputPool::Transparent => PoolType::Transparent,
+        }
+    }
+}
+
+/// A payment recipient reduced to the single receiver the engine pays.
+#[derive(Clone, Debug)]
+pub struct ResolvedRecipient {
+    /// A single-receiver address, so that zcash_client_backend cannot route the payment to any
+    /// other pool: a unified address with ONLY its Orchard-family receiver (→ Ironwood), a plain
+    /// Sapling address, a plain transparent address, or a TEX address.
+    pub address: ZcashAddress,
+    pub pool: OutputPool,
+    /// A TEX (ZIP 320) recipient: paid by a second transaction from an ephemeral address.
+    pub tex: bool,
+}
+
+fn transparent_zaddr(net: NetworkType, t: &TransparentAddress) -> ZcashAddress {
+    match t {
+        TransparentAddress::PublicKeyHash(data) => ZcashAddress::from_transparent_p2pkh(net, *data),
+        TransparentAddress::ScriptHash(data) => ZcashAddress::from_transparent_p2sh(net, *data),
+    }
+}
+
+/// Resolves a payment recipient to the one receiver the engine pays, or refuses it.
+///
+/// * a unified address with an Orchard-family receiver → that receiver alone: an Ironwood output
+///   (since NU6.3 an Orchard-receiver payment lands in the Ironwood pool), whatever else the UA has;
+/// * a unified address without one → its Sapling receiver;
+/// * a unified address with neither (transparent and/or unknown receivers only) →
+///   `recipient_unsupported`: a UA's transparent receiver is never paid, not even for a withdrawal
+///   (the player never typed a transparent address); a player who wants a public
+///   withdrawal pastes the plain t-address;
+/// * a Sapling address → itself;
+/// * a transparent address → itself, for withdrawal outputs only (`recipient_transparent_not_allowed`
+///   otherwise);
+/// * a TEX address (ZIP 320) → itself, for withdrawal outputs only; paid in two transactions
+///   (shielded → ephemeral transparent address → TEX);
+/// * a Sprout address → `recipient_unsupported`; another network's address → `recipient_wrong_network`.
+pub fn resolve_recipient<P: Parameters>(
+    params: &P,
+    to: &ZcashAddress,
+    withdrawal: bool,
+) -> Result<ResolvedRecipient, Error> {
+    let net = params.network_type();
+    let addr: Address = match to.clone().convert_if_network::<Address>(net) {
+        Ok(addr) => addr,
+        Err(ConversionError::IncorrectNetwork { .. }) => {
+            return Err(Error::RecipientWrongNetwork(network_name(net).to_string()))
+        }
+        Err(ConversionError::Unsupported(kind)) => {
+            return Err(Error::RecipientUnsupported(format!("a {} address", kind)))
+        }
+        Err(ConversionError::User(e)) => {
+            return Err(Error::RecipientUnsupported(format!("an unusable address ({})", e)))
+        }
+    };
+    match addr {
+        Address::Sapling(pa) => Ok(ResolvedRecipient {
+            address: ZcashAddress::from_sapling(net, pa.to_bytes()),
+            pool: OutputPool::Sapling,
+            tex: false,
+        }),
+        Address::Unified(ua) => {
+            if let Some(orchard) = ua.orchard() {
+                let only = UnifiedAddress::from_receivers(Some(*orchard), None, None)
+                    .ok_or_else(|| Error::RecipientUnsupported("an unusable unified address".into()))?;
+                return Ok(ResolvedRecipient {
+                    address: Address::Unified(only).to_zcash_address(params),
+                    pool: OutputPool::Ironwood,
+                    tex: false,
+                });
+            }
+            if let Some(pa) = ua.sapling() {
+                return Ok(ResolvedRecipient {
+                    address: ZcashAddress::from_sapling(net, pa.to_bytes()),
+                    pool: OutputPool::Sapling,
+                    tex: false,
+                });
+            }
+            // Never fall back to a UA's transparent receiver, not even for a withdrawal.
+            Err(Error::RecipientUnsupported(
+                "a unified address without an Orchard-family or Sapling receiver".to_string(),
+            ))
+        }
+        Address::Transparent(t) => {
+            if withdrawal {
+                Ok(ResolvedRecipient {
+                    address: transparent_zaddr(net, &t),
+                    pool: OutputPool::Transparent,
+                    tex: false,
+                })
+            } else {
+                Err(Error::RecipientTransparentNotAllowed)
+            }
+        }
+        Address::Tex(data) => {
+            if withdrawal {
+                Ok(ResolvedRecipient {
+                    address: ZcashAddress::from_tex(net, data),
+                    pool: OutputPool::Transparent,
+                    tex: true,
+                })
+            } else {
+                Err(Error::RecipientTransparentNotAllowed)
+            }
+        }
+    }
+}
+
+/// One requested output of a `send` call.
+#[derive(Clone, Debug)]
+pub struct OutputRequest {
+    pub to: ZcashAddress,
+    pub amount: Zatoshis,
+    pub memo: Option<MemoBytes>,
+    pub withdrawal: bool,
+}
+
+/// An output after recipient resolution, ready to become a ZIP 321 payment.
+#[derive(Clone, Debug)]
+pub struct ResolvedOutput {
+    pub recipient: ResolvedRecipient,
+    pub amount: Zatoshis,
+    pub memo: Option<MemoBytes>,
+    pub withdrawal: bool,
+}
+
+/// Validates an amount given in zatoshis: an integer in 1..=MAX_MONEY.
+pub fn parse_amount(zat: u64) -> Result<Zatoshis, Error> {
+    if zat == 0 || zat > MAX_MONEY {
+        return Err(Error::InvalidAmountZat(format!(
+            "{} zatoshis (must be 1..={})",
+            zat, MAX_MONEY
+        )));
+    }
+    Zatoshis::from_u64(zat).map_err(|_| Error::InvalidAmountZat(zat.to_string()))
+}
+
+/// Encodes a text memo (ZIP 302: UTF-8, at most 512 bytes).
+pub fn parse_memo(text: &str) -> Result<MemoBytes, Error> {
+    let bytes = text.as_bytes();
+    if bytes.len() > 512 {
+        return Err(Error::MemoTooLong(bytes.len()));
+    }
+    MemoBytes::from_bytes(bytes).map_err(|_| Error::MemoTooLong(bytes.len()))
+}
+
+/// Resolves and validates every output of a `send` call.
+pub fn resolve_outputs<P: Parameters>(
+    params: &P,
+    outputs: Vec<OutputRequest>,
+) -> Result<Vec<ResolvedOutput>, Error> {
+    if outputs.is_empty() {
+        return Err(Error::InvalidOutputs("at least one output is required".into()));
+    }
+    if outputs.len() > MAX_OUTPUTS {
+        return Err(Error::InvalidOutputs(format!(
+            "{} outputs requested; at most {} are allowed",
+            outputs.len(),
+            MAX_OUTPUTS
+        )));
+    }
+    let mut total: u64 = 0;
+    let mut resolved = Vec::with_capacity(outputs.len());
+    for (i, o) in outputs.into_iter().enumerate() {
+        let recipient = resolve_recipient(params, &o.to, o.withdrawal).map_err(|e| e.at_output(i))?;
+        if recipient.pool == OutputPool::Transparent && o.memo.is_some() {
+            return Err(Error::MemoNotAllowed(i));
+        }
+        total = total.saturating_add(u64::from(o.amount));
+        if total > MAX_MONEY {
+            return Err(Error::InvalidAmountZat("the outputs add up to more than MAX_MONEY".into()));
+        }
+        resolved.push(ResolvedOutput {
+            recipient,
+            amount: o.amount,
+            memo: o.memo,
+            withdrawal: o.withdrawal,
+        });
+    }
+    Ok(resolved)
+}
+
+/// The stored transparent outputs the wallet still counts as spendable that
+/// lightwalletd's current UTXO set (GetAddressUtxos) no longer contains. They were spent by a
+/// transaction this wallet did not create (another wallet holding the same seed), or the server
+/// lags behind: they are only candidates, and a UTXO is marked spent only once its mined spending
+/// transaction is found on chain.
+pub fn missing_outpoints(stored: &[OutPoint], live: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
+    let mut out: Vec<OutPoint> = stored.iter().filter(|o| !live.contains(o)).cloned().collect();
+    out.sort();
+    out.dedup();
+    out
+}
+
+/// Which of `candidates` a transaction spends (its transparent inputs).
+pub fn spent_outpoints(tx: &Transaction, candidates: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
+    tx.transparent_bundle()
+        .map(|b| {
+            b.vin
+                .iter()
+                .map(|txin| txin.prevout().clone())
+                .filter(|prevout| candidates.contains(prevout))
+                .collect()
+        })
+        .unwrap_or_default()
+}
+
+/// The marker an error message carries for the transaction it is about, so the game
+/// can report the txid of a transaction that may have reached the network. Errors cross the Web
+/// Worker boundary as strings, so the txid travels inside the message (`[txid=<hex>]`) and is
+/// restored as `error.txid` on the JavaScript side.
+pub fn txid_marker(txid: &str) -> String {
+    format!("[txid={}]", txid)
+}
+
+/// The txid of a `txid_marker` in an error message, if any (64 lower-case hex digits).
+pub fn txid_of_message(message: &str) -> Option<&str> {
+    let start = message.find("[txid=")? + "[txid=".len();
+    let rest = &message[start..];
+    let end = rest.find(']')?;
+    let txid = &rest[..end];
+    (txid.len() == 64 && txid.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
+        .then_some(txid)
+}
+
+/// What a transaction (or proposal step) is expected to look like.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TxKind {
+    /// Transparent UTXOs → the wallet's own Ironwood address. No shielded spends, no transparent
+    /// outputs, no Sapling or Orchard outputs.
+    Shielding,
+    /// Shielded notes (Ironwood / Sapling / legacy Orchard) → Ironwood and Sapling outputs plus
+    /// exactly `transparent_outputs` transparent (withdrawal, or a TEX pair's ephemeral) outputs;
+    /// change to Ironwood. No transparent inputs, nothing paid into Orchard.
+    Payment { transparent_outputs: usize },
+    /// The second transaction of a TEX (ZIP 320) withdrawal: the ephemeral transparent output of
+    /// the first → `transparent_outputs` TEX recipients. Fully transparent, no change.
+    TexFinal { transparent_outputs: usize },
+    /// Broadcast-time check for a transaction already checked precisely at creation: any of the
+    /// shapes above.
+    Any,
+}
+
+/// The expected kind of each step of a payment proposal: one step, or two for a TEX withdrawal
+/// (step 0 pays the shielded outputs, the plain transparent outputs and the ephemeral output;
+/// step 1 pays the TEX recipients).
+pub fn payment_kinds(resolved: &[ResolvedOutput]) -> Vec<TxKind> {
+    let tex = resolved.iter().filter(|o| o.recipient.tex).count();
+    let plain_t = resolved
+        .iter()
+        .filter(|o| o.recipient.pool == OutputPool::Transparent && !o.recipient.tex)
+        .count();
+    if tex == 0 {
+        vec![TxKind::Payment {
+            transparent_outputs: plain_t,
+        }]
+    } else {
+        vec![
+            TxKind::Payment {
+                transparent_outputs: plain_t + 1,
+            },
+            TxKind::TexFinal {
+                transparent_outputs: tex,
+            },
+        ]
+    }
+}
+
+/// Checks a proposal before anything is proved: version 6, the expected number of steps, inputs
+/// only from the allowed pools, outputs only to the resolved pools (transparent only for the
+/// payments listed in `transparent_payments`, i.e. withdrawals), nothing paid into Orchard, and
+/// change only to Ironwood.
+pub fn check_proposal<FeeRuleT, NoteRef>(
+    proposal: &Proposal<FeeRuleT, NoteRef>,
+    kinds: &[TxKind],
+    transparent_payments: &[usize],
+) -> Result<(), Error> {
+    let violation = |m: String| Err(Error::PoolPolicyViolation(m));
+    if proposal.proposed_version() != Some(TX_VERSION) {
+        return violation(format!(
+            "proposal asks for transaction version {:?}, this build only builds {:?}",
+            proposal.proposed_version(),
+            TX_VERSION
+        ));
+    }
+    if proposal.steps().len() != kinds.len() {
+        return violation(format!(
+            "proposal has {} steps, expected {}",
+            proposal.steps().len(),
+            kinds.len()
+        ));
+    }
+    for (i, (step, kind)) in proposal.steps().iter().zip(kinds.iter()).enumerate() {
+        if step.involves(PoolType::ORCHARD) && !step.input_in_pool(PoolType::ORCHARD) {
+            return violation(format!("step {i} pays into the Orchard pool"));
+        }
+        if step.output_in_pool(PoolType::ORCHARD) || step.change_in_pool(PoolType::ORCHARD) {
+            return violation(format!("step {i} pays into the Orchard pool"));
+        }
+        for change in step.balance().proposed_change() {
+            let pool = change.output_pool();
+            let ok = pool == PoolType::IRONWOOD
+                || (change.is_ephemeral() && matches!(kind, TxKind::Payment { .. }) && kinds.len() == 2 && i == 0);
+            if !ok {
+                return violation(format!("step {i}: change goes to the {:?} pool", pool));
+            }
+        }
+        let shielded_inputs = step.input_in_pool(PoolType::IRONWOOD)
+            || step.input_in_pool(PoolType::SAPLING)
+            || step.input_in_pool(PoolType::ORCHARD);
+        match kind {
+            TxKind::Shielding => {
+                if !step.is_shielding() || step.transparent_inputs().is_empty() {
+                    return violation("shielding proposal has no transparent inputs".into());
+                }
+                if shielded_inputs || !step.prior_step_inputs().is_empty() {
+                    return violation("shielding proposal spends shielded notes".into());
+                }
+                if !step.payment_pools().is_empty() {
+                    return violation("shielding proposal pays external recipients".into());
+                }
+                if !step.change_in_pool(PoolType::IRONWOOD) {
+                    return violation("shielding proposal does not shield into Ironwood".into());
+                }
+            }
+            TxKind::Payment { transparent_outputs } => {
+                if !step.transparent_inputs().is_empty() || !step.prior_step_inputs().is_empty() {
+                    return violation(format!("step {i} spends transparent inputs"));
+                }
+                if !shielded_inputs {
+                    return violation(format!("step {i} spends no shielded notes"));
+                }
+                for (idx, pool) in step.payment_pools().iter() {
+                    let allowed = *pool == PoolType::IRONWOOD
+                        || *pool == PoolType::SAPLING
+                        || (*pool == PoolType::Transparent && transparent_payments.contains(idx));
+                    if !allowed {
+                        return violation(format!("payment {} goes to the {:?} pool", idx, pool));
+                    }
+                }
+                let plain_t = step
+                    .payment_pools()
+                    .values()
+                    .filter(|p| **p == PoolType::Transparent)
+                    .count();
+                let ephemeral = step
+                    .balance()
+                    .proposed_change()
+                    .iter()
+                    .filter(|c| c.is_ephemeral())
+                    .count();
+                if plain_t + ephemeral != *transparent_outputs {
+                    return violation(format!(
+                        "step {i} pays {} transparent outputs, expected {}",
+                        plain_t + ephemeral,
+                        transparent_outputs
+                    ));
+                }
+            }
+            TxKind::TexFinal { transparent_outputs } => {
+                if shielded_inputs || !step.transparent_inputs().is_empty() {
+                    return violation("the TEX step spends something other than the ephemeral output".into());
+                }
+                if step.prior_step_inputs().len() != 1 {
+                    return violation("the TEX step must spend exactly the first step's ephemeral output".into());
+                }
+                if step.payment_pools().len() != *transparent_outputs
+                    || step.payment_pools().values().any(|p| *p != PoolType::Transparent)
+                {
+                    return violation("the TEX step pays something other than the TEX recipients".into());
+                }
+                if !step.balance().proposed_change().is_empty() {
+                    return violation("the TEX step has change".into());
+                }
+            }
+            TxKind::Any => {}
+        }
+    }
+    Ok(())
+}
+
+/// The shape of a transaction, as checked and reported (`inspect`).
+#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct TxShape {
+    pub txid: String,
+    pub version: String,
+    pub consensus_branch_id: String,
+    pub transparent_inputs: usize,
+    pub transparent_outputs: usize,
+    pub sapling_spends: usize,
+    pub sapling_outputs: usize,
+    pub orchard_actions: usize,
+    pub ironwood_actions: usize,
+    pub has_orchard_bundle: bool,
+    pub has_ironwood_bundle: bool,
+    pub has_sprout_bundle: bool,
+    /// Orchard value balance (zatoshis leaving the Orchard pool; never negative after NU6.3).
+    pub orchard_value_balance: i64,
+}
+
+pub fn inspect(tx: &Transaction) -> TxShape {
+    let (t_in, t_out) = tx
+        .transparent_bundle()
+        .map(|b| (b.vin.len(), b.vout.len()))
+        .unwrap_or((0, 0));
+    let (s_sp, s_out) = tx
+        .sapling_bundle()
+        .map(|b| (b.shielded_spends().len(), b.shielded_outputs().len()))
+        .unwrap_or((0, 0));
+    TxShape {
+        txid: tx.txid().to_string(),
+        version: format!("{:?}", tx.version()),
+        consensus_branch_id: branch_hex(u32::from(tx.consensus_branch_id())),
+        transparent_inputs: t_in,
+        transparent_outputs: t_out,
+        sapling_spends: s_sp,
+        sapling_outputs: s_out,
+        orchard_actions: tx.orchard_bundle().map(|b| b.actions().len()).unwrap_or(0),
+        ironwood_actions: tx.ironwood_bundle().map(|b| b.actions().len()).unwrap_or(0),
+        has_orchard_bundle: tx.orchard_bundle().is_some(),
+        has_ironwood_bundle: tx.ironwood_bundle().is_some(),
+        has_sprout_bundle: tx.sprout_bundle().is_some(),
+        orchard_value_balance: tx
+            .orchard_bundle()
+            .map(|b| i64::from(*b.value_balance()))
+            .unwrap_or(0),
+    }
+}
+
+/// Checks a built transaction before it can be broadcast: version 6, consensus branch = one this
+/// build supports, no Sprout bundle, an Orchard bundle only to spend legacy Orchard notes (value
+/// leaves the pool), and the shape `kind` asks for.
+pub fn check_transaction(tx: &Transaction, kind: TxKind) -> Result<(), Error> {
+    let violation = |m: String| Err(Error::PoolPolicyViolation(m));
+    let s = inspect(tx);
+    if tx.version() != TX_VERSION {
+        return violation(format!(
+            "transaction {} has version {}, expected {:?}",
+            s.txid, s.version, TX_VERSION
+        ));
+    }
+    if !supports_branch(u32::from(tx.consensus_branch_id())) {
+        return violation(format!(
+            "transaction {} commits to branch {}, this build supports {}",
+            s.txid,
+            s.consensus_branch_id,
+            supported_branches_hex()
+        ));
+    }
+    if s.has_sprout_bundle {
+        return violation(format!("transaction {} has a Sprout bundle", s.txid));
+    }
+    if s.has_orchard_bundle && s.orchard_value_balance <= 0 {
+        return violation(format!(
+            "transaction {} adds value to the Orchard pool (value balance {})",
+            s.txid, s.orchard_value_balance
+        ));
+    }
+    let shielding_shape = s.transparent_inputs > 0
+        && s.transparent_outputs == 0
+        && s.sapling_spends == 0
+        && s.sapling_outputs == 0
+        && !s.has_orchard_bundle
+        && s.has_ironwood_bundle;
+    let shielded_spends = s.sapling_spends > 0 || s.has_orchard_bundle || s.has_ironwood_bundle;
+    let payment_shape = |t_out: Option<usize>| {
+        s.transparent_inputs == 0
+            && shielded_spends
+            && s.has_ironwood_bundle // change (possibly zero-valued) always goes to Ironwood
+            && t_out.map_or(true, |n| s.transparent_outputs == n)
+    };
+    let tex_final_shape = |t_out: Option<usize>| {
+        s.transparent_inputs == 1
+            && t_out.map_or(s.transparent_outputs > 0, |n| s.transparent_outputs == n)
+            && s.sapling_spends == 0
+            && s.sapling_outputs == 0
+            && !s.has_orchard_bundle
+            && !s.has_ironwood_bundle
+    };
+    let ok = match kind {
+        TxKind::Shielding => shielding_shape,
+        TxKind::Payment {
+            transparent_outputs,
+        } => payment_shape(Some(transparent_outputs)),
+        TxKind::TexFinal {
+            transparent_outputs,
+        } => tex_final_shape(Some(transparent_outputs)),
+        TxKind::Any => shielding_shape || payment_shape(None) || tex_final_shape(None),
+    };
+    if !ok {
+        return violation(format!(
+            "transaction {} does not have the expected {:?} shape: {:?}",
+            s.txid, kind, s
+        ));
+    }
+    Ok(())
+}

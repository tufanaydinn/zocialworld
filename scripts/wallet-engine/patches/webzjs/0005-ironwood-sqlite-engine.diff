-    pub unified_shielded: String,
-    pub sapling: String,
-    pub transparent: String,
-}
-
-impl<T> Wallet<SqliteWalletDb, T> {
-    /// The account at position `index` (creation order). The game's API keeps numeric account
-    /// ids; the SQLite backend identifies accounts by UUID.
-    pub async fn account_uuid(&self, index: u32) -> Result<AccountUuid, Error> {
-        let db = self.db.lock().await;
-        let ids = db.get_account_ids()?;
-        ids.get(index as usize)
-            .copied()
-            .ok_or(Error::AccountNotFound(index))
-    }
-
-    /// Position of `uuid` in creation order (the numeric id the game uses).
-    pub async fn account_index(&self, uuid: AccountUuid) -> Result<u32, Error> {
-        let db = self.db.lock().await;
-        let ids = db.get_account_ids()?;
-        ids.iter()
-            .position(|id| *id == uuid)
-            .map(|i| i as u32)
-            .ok_or_else(|| Error::Generic("account not found after creation".into()))
-    }
-
-    pub async fn ironwood_balances(&self, index: u32) -> Result<IronwoodBalances, Error> {
-        let account = self.account_uuid(index).await?;
-        let db = self.db.lock().await;
-        Ok(match db.get_wallet_summary(self.min_confirmations)? {
-            Some(summary) => IronwoodBalances::from_summary(&summary, &account),
-            None => IronwoodBalances::default(),
-        })
-    }
-
-    pub async fn ironwood_addresses(&self, index: u32) -> Result<IronwoodAddresses, Error> {
-        let account = self.account_uuid(index).await?;
-        let db = self.db.lock().await;
-        let ua = db
-            .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)?
-            .ok_or(Error::AccountNotFound(index))?;
-        receive_addresses(&ua, &self.network)
-    }
-}
-
-pub fn receive_addresses(ua: &UnifiedAddress, network: &Network) -> Result<IronwoodAddresses, Error> {
-    let orchard = ua
-        .orchard()
-        .copied()
-        .ok_or_else(|| Error::Generic("the account has no Orchard-family receiver".into()))?;
-    let sapling = ua
-        .sapling()
-        .copied()
-        .ok_or_else(|| Error::Generic("the account has no Sapling receiver".into()))?;
-    let transparent = ua
-        .transparent()

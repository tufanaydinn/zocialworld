+/// Native mainnet sync benchmark (no funds; run by hand, needs network access to zec.rocks):
+/// `BENCH_BLOCKS=10000 BENCH_BATCH=5000 cargo test --release -p webzjs-wallet --lib bench_mainnet_sync -- --ignored --nocapture`
+#[cfg(not(feature = "regtest"))]
+#[tokio::test(flavor = "multi_thread")]
+#[ignore]
+async fn bench_mainnet_sync() {
+    use crate::validation::validate_confirmations_policy;
+    use crate::Wallet;
+    use zcash_client_backend::proto::service::{compact_tx_streamer_client::CompactTxStreamerClient, ChainSpec};
+    let blocks: u32 = std::env::var("BENCH_BLOCKS").ok().and_then(|s| s.parse().ok()).unwrap_or(2000);
+    let batch: u32 = std::env::var("BENCH_BATCH").ok().and_then(|s| s.parse().ok()).unwrap_or(crate::wallet::SYNC_BATCH_SIZE);
+    let url = std::env::var("BENCH_LWD").unwrap_or_else(|_| "https://zec.rocks:443".into());
+    // BENCH_CA: an extra PEM CA bundle (e.g. a TLS-terminating egress proxy's).
+    let mut tls = tonic::transport::ClientTlsConfig::new().with_webpki_roots();
+    if let Ok(ca) = std::env::var("BENCH_CA") {
+        tls = tls.ca_certificate(tonic::transport::Certificate::from_pem(std::fs::read(ca).unwrap()));
+    }
+    let channel = tonic::transport::Channel::from_shared(url)
+        .unwrap()
+        .tls_config(tls)
+        .unwrap()
+        .connect()
+        .await
+        .unwrap();
+    let tip = CompactTxStreamerClient::new(channel.clone())
+        .get_latest_block(ChainSpec {})
+        .await
+        .unwrap()
+        .into_inner()
+        .height as u32;
+    let birthday = std::env::var("BENCH_BIRTHDAY").ok().and_then(|s| s.parse().ok()).unwrap_or(tip - blocks);
+    let network = Network::MainNetwork;
+    let policy = validate_confirmations_policy(1, 1, true).unwrap();
+    let w = Wallet::new(Store::open(network, None).unwrap(), channel, network, policy)
+        .unwrap()
+        .with_sync_batch_size(batch);
+    w.create_account("bench", MAINNET_PHRASE, 0, Some(birthday), None).await.unwrap();
+    let t0 = std::time::Instant::now();
+    w.sync_chain().await.unwrap();
+    let chain = t0.elapsed();
+    let t1 = std::time::Instant::now();
+    w.serve_transaction_data_requests().await.unwrap();
+    let requests = t1.elapsed();
+    let t2 = std::time::Instant::now();
+    let broken = w.check_witnesses().await.unwrap();
+    let witnesses = t2.elapsed();
+    let b = w.balances(0).await.unwrap();
+    let db_bytes = w.db_to_bytes().await.unwrap();
+    if let Ok(path) = std::env::var("BENCH_DUMP") {
+        std::fs::write(path, &db_bytes).unwrap();
+    }
+    let bytes = db_bytes.len();
+    println!(
+        "BENCH {}",
+        serde_json::json!({ "blocks": tip - birthday, "birthday": birthday, "tip": tip, "batch": batch,
+            "syncChainMs": chain.as_millis() as u64, "dataRequestsMs": requests.as_millis() as u64,
+            "checkWitnessesMs": witnesses.as_millis() as u64, "brokenWitnessRanges": broken,
+            "fullyScanned": b.fully_scanned_height, "dbBytes": bytes })
+    );
+}

-/// The marker an error message carries for the transaction it is about, so the game
-/// can report the txid of a transaction that may have reached the network. Errors cross the Web
-/// Worker boundary as strings, so the txid travels inside the message (`[txid=<hex>]`) and is
-/// restored as `error.txid` on the JavaScript side.
-pub fn txid_marker(txid: &str) -> String {
-    format!("[txid={}]", txid)
-}
-
-/// The txid of a `txid_marker` in an error message, if any (64 lower-case hex digits).
-pub fn txid_of_message(message: &str) -> Option<&str> {
-    let start = message.find("[txid=")? + "[txid=".len();
-    let rest = &message[start..];
-    let end = rest.find(']')?;
-    let txid = &rest[..end];
-    (txid.len() == 64 && txid.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)))
-        .then_some(txid)
-}

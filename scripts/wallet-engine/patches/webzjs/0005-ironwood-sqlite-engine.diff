-/// What a transaction is expected to look like.
-#[derive(Clone, Copy, Debug, PartialEq, Eq)]
-pub enum TxKind {
-    /// Transparent UTXOs → the wallet's own Sapling address. No Sapling spends, no transparent
-    /// outputs.
-    Shielding,
-    /// Sapling notes → Sapling outputs and `transparent_outputs` transparent (withdrawal)
-    /// outputs. No transparent inputs.
-    Payment { transparent_outputs: usize },
-    /// Broadcast-time check for a transaction already checked precisely at creation: either of
-    /// the shapes above.
-    Any,
-}
-
-/// Checks that a proposal is a single step, asks for a version-5 transaction, never touches the
-/// Orchard or Ironwood pool, returns change only to Sapling, and has the expected shape:
-/// shielding spends transparent UTXOs only; a payment spends Sapling notes only and pays Sapling
-/// receivers, plus transparent receivers exactly for the payments marked `transparent_payments`.
-pub fn check_proposal<FeeRuleT, NoteRef>(
-    proposal: &Proposal<FeeRuleT, NoteRef>,
-    kind: TxKind,
-    transparent_payments: &[usize],
-) -> Result<(), Error> {
-    let violation = |m: String| Err(Error::SaplingOnlyViolation(m));
-    if proposal.proposed_version() != Some(TX_VERSION) {
-        return violation(format!(
-            "proposal asks for transaction version {:?}, the Sapling beta only builds {:?}",
-            proposal.proposed_version(),
-            TX_VERSION
-        ));
-    }
-    if proposal.steps().len() != 1 {
-        return violation(format!(
-            "proposal has {} steps; the Sapling beta builds single-step transactions only",
-            proposal.steps().len()
-        ));
-    }
-    for step in proposal.steps().iter() {
-        if step.involves(PoolType::ORCHARD) || step.involves(PoolType::IRONWOOD) {
-            return violation("proposal involves the Orchard or Ironwood pool".to_string());
-        }
-        if !step.prior_step_inputs().is_empty() {
-            return violation("proposal spends outputs of a prior step".to_string());
-        }
-        let shielding = matches!(kind, TxKind::Shielding);
-        if step.input_in_pool(PoolType::Transparent) != shielding {
-            return violation(if shielding {
-                "shielding proposal has no transparent inputs".to_string()
-            } else {
-                "payment proposal spends transparent inputs".to_string()
-            });
-        }
-        if shielding && step.input_in_pool(PoolType::SAPLING) {
-            return violation("shielding proposal spends Sapling notes".to_string());
-        }
-        if !shielding && !step.input_in_pool(PoolType::SAPLING) {
-            return violation("payment proposal spends no Sapling notes".to_string());
-        }
-        for (idx, pool) in step.payment_pools().iter() {
-            let allowed = *pool == PoolType::SAPLING
-                || (*pool == PoolType::Transparent && transparent_payments.contains(idx));
-            if !allowed {
-                return violation(format!("payment {} goes to the {:?} pool", idx, pool));
-            }
-        }
-        if let TxKind::Payment { transparent_outputs } = kind {
-            let n = step
-                .payment_pools()
-                .values()
-                .filter(|p| **p == PoolType::Transparent)
-                .count();
-            if n != transparent_outputs {
-                return violation(format!(
-                    "proposal pays {} transparent outputs, expected {}",
-                    n, transparent_outputs
-                ));
-            }
-        }
-        for change in step.balance().proposed_change() {
-            if change.output_pool() != PoolType::SAPLING {
-                return violation(format!(
-                    "change output goes to the {:?} pool",
-                    change.output_pool()
-                ));
-            }
-        }
-    }
-    Ok(())
-}

+fn sqlite_db_roundtrip_keeps_accounts_and_addresses() {
+    let fx = load_fixture("mainnet-3510380-3510412.json");
+    let mut store = Store::open(Network::MainNetwork, None).unwrap();
+    let birthday = AccountBirthday::from_treestate(fx.prior.clone(), None)
+        .map_err(|_| "birthday")
+        .unwrap();
+    let (account, _) = store
+        .wdb()
+        .create_account("a", &seed(MAINNET_PHRASE), &birthday, None)
+        .unwrap();
+    let ua = store
+        .wdb()
+        .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)
+        .unwrap()
+        .unwrap();
+    let addrs = receive_addresses(&ua, &Network::MainNetwork, None).unwrap();
+    assert!(addrs.unified.starts_with("u1"));
+    assert!(addrs.unified_shielded.starts_with("u1"));
+    assert!(addrs.unified_sapling_transparent.starts_with("u1"));
+    assert!(addrs.sapling.starts_with("zs1"));
+    assert!(addrs.transparent.starts_with("t1"));
+    // The five encodings carry the same receivers (ZIP 316): check them through the decoder.
+    use zcash_keys::address::Address;
+    let decode = |s: &str| match Address::decode(&Network::MainNetwork, s).unwrap() {
+        Address::Unified(ua) => ua,
+        other => panic!("expected a UA, got {other:?}"),
+    };
+    let full = decode(&addrs.unified);
+    let shielded = decode(&addrs.unified_shielded);
+    let sapling_t = decode(&addrs.unified_sapling_transparent);
+    assert!(full.orchard().is_some() && full.sapling().is_some() && full.transparent().is_some());
+    assert_eq!(shielded.orchard(), full.orchard());
+    assert_eq!(shielded.sapling(), full.sapling());
+    assert!(shielded.transparent().is_none());
+    assert!(sapling_t.orchard().is_none());
+    assert_eq!(sapling_t.sapling(), full.sapling());
+    assert_eq!(sapling_t.transparent(), full.transparent());
+    let bytes = store.export().unwrap();
+    assert_eq!(&bytes[..16], b"SQLite format 3\0");
+    drop(store);
+
+    let mut store2 = Store::open(Network::MainNetwork, Some(&bytes)).unwrap();
+    assert_eq!(store2.wdb().get_account_ids().unwrap(), vec![account]);
+    let ua2 = store2
+        .wdb()
+        .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)
+        .unwrap()
+        .unwrap();
+    assert_eq!(receive_addresses(&ua2, &Network::MainNetwork, None).unwrap(), addrs);
+}

+/// The account's receive addresses (ADR-018 § 1 Stage 2 amendment). All five share one
+/// diversifier index (ZIP 316).
+#[derive(Debug, Clone, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "camelCase")]
+pub struct ReceiveAddresses {
+    /// The full unified address: Orchard-family (Ironwood payments arrive here) + Sapling +
+    /// transparent receivers. The main address once Ironwood sending has shipped and passed review.
+    pub unified: String,
+    /// Orchard-family + Sapling receivers, no transparent receiver: the address a recipient seals
+    /// in a player payment, so a payer never learns the wallet's t-address.
+    pub unified_shielded: String,
+    /// The Stage-1 main address (Sapling + transparent receivers, no Orchard) — ADR-018 § 1 until
+    /// the Stage-2 main address is switched on.
+    pub unified_sapling_transparent: String,
+    /// The Sapling receiver alone (zs1… on mainnet).
+    pub sapling: String,
+    /// The transparent receiver alone (t1… on mainnet): the exchange address (public on chain).
+    pub transparent: String,
+    /// The diversifier index of the receivers (decimal string), when known.
+    pub diversifier_index: Option<String>,
+}
+
+pub fn receive_addresses(
+    ua: &UnifiedAddress,
+    network: &Network,
+    diversifier_index: Option<String>,
+) -> Result<ReceiveAddresses, Error> {
+    let orchard = ua
+        .orchard()
+        .copied()
+        .ok_or_else(|| Error::Generic("the account has no Orchard-family receiver".into()))?;
+    let sapling = ua
+        .sapling()
+        .copied()
+        .ok_or_else(|| Error::Generic("the account has no Sapling receiver".into()))?;
+    let transparent = ua
+        .transparent()
+        .copied()
+        .ok_or_else(|| Error::Generic("the account has no transparent receiver".into()))?;
+    let full = UnifiedAddress::from_receivers(Some(orchard), Some(sapling), Some(transparent))
+        .ok_or_else(|| Error::Generic("could not build the unified address".into()))?;
+    let shielded = UnifiedAddress::from_receivers(Some(orchard), Some(sapling), None)
+        .ok_or_else(|| Error::Generic("could not build the shielded unified address".into()))?;
+    let sapling_t = UnifiedAddress::from_receivers(None, Some(sapling), Some(transparent))
+        .ok_or_else(|| Error::Generic("could not build the Sapling + transparent unified address".into()))?;
+    Ok(ReceiveAddresses {
+        unified: full.encode(network),
+        unified_shielded: shielded.encode(network),
+        unified_sapling_transparent: sapling_t.encode(network),
+        sapling: ZcashAddress::from_sapling(network.network_type(), sapling.to_bytes()).encode(),
+        transparent: zcash_keys::encoding::AddressCodec::encode(&transparent, network),
+        diversifier_index,
+    })
 }

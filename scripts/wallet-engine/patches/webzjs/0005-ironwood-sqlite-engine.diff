-pub enum OutputPool {
-    Sapling,
-    Transparent,
-}
-
-impl OutputPool {
-    pub fn pool_type(self) -> PoolType {
-        match self {
-            OutputPool::Sapling => PoolType::SAPLING,
-            OutputPool::Transparent => PoolType::Transparent,
-        }
-    }
-}

+/// Real mainnet compact blocks (33 blocks, 314 Ironwood actions): after scanning, the wallet's
+/// Ironwood (and Sapling, Orchard) note commitment tree root at the last block equals the root of
+/// lightwalletd's tree state for that block, and the database export restores the same trees.
+#[cfg(not(feature = "regtest"))]
+#[test]
+fn mainnet_ironwood_tree_matches_lightwalletd() {
+    let fx = load_fixture("mainnet-3510380-3510412.json");
+    let mut store = Store::open(Network::MainNetwork, None).unwrap();
+    scan_fixture(&mut store, &fx, MAINNET_PHRASE);
+    let end = BlockHeight::from_u32(fx.end);
+    let expect = fx.end_state.to_chain_state().unwrap();
+    let roots = |store: &mut Store| {
+        let mut db = store.wdb();
+        (
+            db.with_sapling_tree_mut(|t| t.root_at_checkpoint_id(&end))
+                .unwrap()
+                .unwrap(),
+            db.with_orchard_tree_mut(|t| t.root_at_checkpoint_id(&end))
+                .unwrap()
+                .unwrap(),
+            db.with_ironwood_tree_mut(|t| t.root_at_checkpoint_id(&end))
+                .unwrap()
+                .flatten()
+                .unwrap(),
+        )
+    };
+    let (s, o, i) = roots(&mut store);
+    assert_eq!(s, expect.final_sapling_tree().root());
+    assert_eq!(o, expect.final_orchard_tree().root());
+    assert_eq!(i, expect.final_ironwood_tree().root());
+    assert_eq!(
+        store.wdb().block_metadata(end).unwrap().unwrap().ironwood_tree_size(),
+        Some(expect.final_ironwood_tree().tree_size() as u32)
+    );
+    let summary = store
+        .wdb()
+        .get_wallet_summary(ConfirmationsPolicy::default())
+        .unwrap()
+        .unwrap();
+    assert_eq!(u32::from(summary.fully_scanned_height()), fx.end);
+    // The witnesses of the (zero) spendable notes are fine: nothing to rescan.
+    assert!(store.wdb().check_witnesses().unwrap().is_empty());
+
+    let bytes = store.export().unwrap();
+    drop(store);
+    let mut store2 = Store::open(Network::MainNetwork, Some(&bytes)).unwrap();
+    assert_eq!(roots(&mut store2), (s, o, i));
+}

+pub(crate) fn load_fixture(name: &str) -> Fixture {
+    let path = std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("tests/fixtures")
+        .join(name);
+    let json: serde_json::Value =
+        serde_json::from_slice(&std::fs::read(&path).expect("fixture")).expect("json");
+    let hex = |v: &serde_json::Value| hex::decode(v.as_str().unwrap()).unwrap();
+    Fixture {
+        tip: json["tip"].as_u64().unwrap() as u32,
+        start: json["start"].as_u64().unwrap() as u32,
+        end: json["end"].as_u64().unwrap() as u32,
+        prior: TreeState::decode(&hex(&json["priorTreeState"])[..]).unwrap(),
+        end_state: TreeState::decode(&hex(&json["endTreeState"])[..]).unwrap(),
+        blocks: json["blocks"]
+            .as_array()
+            .unwrap()
+            .iter()
+            .map(|b| CompactBlock::decode(&hex(b)[..]).unwrap())
+            .collect(),
+        json,
+    }
+}

+    async fn serve_address_request(
+        &self,
+        client: &mut CompactTxStreamerClient<T>,
+        req: zcash_client_backend::data_api::TransactionsInvolvingAddress,
+        tip: BlockHeight,
+    ) -> Result<bool, Error> {
+        use futures_util::TryStreamExt;
+        use zcash_client_backend::data_api::{OutputStatusFilter, TransactionStatusFilter};
+        use zcash_keys::encoding::AddressCodec;
+        // Randomly scheduled checks (TEX ephemeral addresses) are served when due, so that the
+        // lightwalletd operator cannot link them by timing.
+        if let Some(at) = req.request_at() {
+            if at > zcash_client_sqlite::util::Clock::now(&crate::db::EngineClock) {
+                return Ok(false);
+            }
+        }
+        let end_exclusive = req.block_range_end().unwrap_or(tip + 1).min(tip + 1);
+        if end_exclusive <= req.block_range_start() {
+            return Ok(false);
+        }
+        let mined_only = matches!(req.tx_status_filter(), TransactionStatusFilter::Mined);
+        let filter = service::TransparentAddressBlockFilter {
+            address: req.address().encode(&self.network),
+            range: Some(service::BlockRange {
+                start: Some(service::BlockId {
+                    height: u64::from(u32::from(req.block_range_start())),
+                    hash: vec![],
+                }),
+                end: Some(service::BlockId {
+                    height: u64::from(u32::from(end_exclusive - 1)),
+                    hash: vec![],
+                }),
+                pool_types: vec![],
+            }),
+        };
+        let mut stream = client.get_taddress_txids(filter).await?.into_inner();
+        let mut transactions = Vec::new();
+        let mut seen = 0;
+        while let Some(raw) = stream.try_next().await? {
+            seen += 1;
+            if seen > MAX_TXS_PER_ADDRESS_REQUEST {
+                break;
+            }
+            let mined = u32::try_from(raw.height)
+                .ok()
+                .filter(|h| *h > 0 && *h < u32::MAX)
+                .map(BlockHeight::from_u32);
+            if mined.is_none() && mined_only {
+                continue;
+            }
+            let Ok(tx) = parse_transaction(&self.network, &raw.data, mined.unwrap_or(tip + 1)) else {
+                tracing::warn!("address request: could not parse a transaction");
+                continue;
+            };
+            transactions.push((tx, mined));
+        }
+        // A request for UNSPENT outputs (upstream's TEX ephemeral-address check)
+        // is answered from the UTXO set as well. Storing what lightwalletd lists as unspent
+        // records that the output was seen unspent at the tip (`max_observed_unspent_height`),
+        // which is the only way the funds of a TEX pair whose second transaction never got mined
+        // come back once that transaction has expired (the stored second transaction keeps its
+        // spend row, so `notify_address_checked` alone never raises that height).
+        let utxos = if matches!(req.output_status_filter(), OutputStatusFilter::Unspent) {
+            let mut replies = client
+                .get_address_utxos_stream(service::GetAddressUtxosArg {
+                    addresses: vec![req.address().encode(&self.network)],
+                    start_height: u64::from(u32::from(req.block_range_start())),
+                    max_entries: MAX_TXS_PER_ADDRESS_REQUEST as u32,
+                })
+                .await?
+                .into_inner();
+            let mut utxos = Vec::new();
+            while let Some(reply) = replies.try_next().await? {
+                utxos.push(reply);
+            }
+            utxos
+        } else {
+            Vec::new()
+        };
+        let mut db = self.db.lock("address_request_store").await?;
+        apply_address_request(
+            &self.network,
+            &mut db.wdb(),
+            req,
+            &transactions,
+            &utxos,
+            end_exclusive - 1,
+        )?;
+        Ok(true)
+    }
+
+    /// Transparent UTXOs spent OUTSIDE this wallet (another wallet with the same
+    /// seed shielded or spent them). For every stored UTXO this wallet still counts as spendable
+    /// that lightwalletd's current UTXO set no longer lists, look for its spending transaction
+    /// (GetTaddressTransactions, from the UTXO's height to the tip) and store it, which marks the
+    /// UTXO spent by a MINED transaction (a lagging or reorganised server can never make funds
+    /// disappear). The upstream transparent spend-search requests cover the same case in 41-block
+    /// windows; this keeps the Stage-1 guarantee of one sync. Returns how many UTXOs were marked.
+    pub async fn reconcile_transparent_utxos(&self) -> Result<usize, Error> {
+        use futures_util::TryStreamExt;
+        use std::collections::{BTreeMap, BTreeSet};
+        use zcash_keys::encoding::AddressCodec;
+        use zcash_transparent::address::TransparentAddress;
+        use zcash_transparent::bundle::OutPoint;
+        const MAX_TXS_PER_ADDRESS: usize = 500;
+        lock_scope(async {
+            // 1. The UTXOs this wallet still counts as spendable, per address.
+            let (stored, tip) = {
+                let mut db = self.db.lock("reconcile_read").await?;
+                let wdb = db.wdb();
+                let Some(tip) = wdb.chain_height()? else { return Ok(0) };
+                let target = TargetHeight::from(tip + 1);
+                let mut stored: Vec<(TransparentAddress, OutPoint, Option<BlockHeight>)> = Vec::new();
+                for account in wdb.get_account_ids()? {
+                    for address in wdb.get_transparent_receivers(account, true, true)?.into_keys() {
+                        for utxo in wdb.get_spendable_transparent_outputs(
+                            &address,
+                            target,
+                            self.min_confirmations,
+                            CoinbaseFilter::AllTransparentOutputs,
+                        )? {
+                            stored.push((address, utxo.outpoint().clone(), utxo.mined_height()));
+                        }
+                    }
+                }
+                (stored, tip)
+            };
+            if stored.is_empty() {
+                return Ok(0);
+            }
+            // 2. lightwalletd's current UTXO set for those addresses.
+            let start = stored
+                .iter()
+                .filter_map(|(_, _, h)| *h)
+                .min()
+                .unwrap_or_else(|| BlockHeight::from_u32(0));
+            let addresses: BTreeSet<String> =
+                stored.iter().map(|(a, _, _)| a.encode(&self.network)).collect();
+            let mut client = self.client.clone();
+            let mut live = BTreeSet::new();
+            let mut replies = client
+                .get_address_utxos_stream(service::GetAddressUtxosArg {
+                    addresses: addresses.into_iter().collect(),
+                    start_height: u64::from(u32::from(start)),
+                    max_entries: 0,
+                })
+                .await?
+                .into_inner();
+            while let Some(reply) = replies.try_next().await? {
+                if let (Ok(hash), Ok(index)) =
+                    (<[u8; 32]>::try_from(&reply.txid[..]), u32::try_from(reply.index))
+                {
+                    live.insert(OutPoint::new(hash, index));
+                }
+            }
+            let outpoints: Vec<OutPoint> = stored.iter().map(|(_, o, _)| o.clone()).collect();
+            let missing: BTreeSet<OutPoint> =
+                policy::missing_outpoints(&outpoints, &live).into_iter().collect();
+            if missing.is_empty() {
+                return Ok(0);
+            }
+            // 3. For each address with missing UTXOs: find the mined transactions that spend them.
+            let mut by_address: BTreeMap<String, BlockHeight> = BTreeMap::new();
+            for (address, outpoint, height) in &stored {
+                if missing.contains(outpoint) {
+                    let from = height.unwrap_or(start);
+                    let entry = by_address.entry(address.encode(&self.network)).or_insert(from);
+                    *entry = (*entry).min(from);
+                }
+            }
+            let mut remaining = missing.clone();
+            let mut marked = 0;
+            for (address, from) in by_address {
+                if remaining.is_empty() {
+                    break;
+                }
+                let filter = service::TransparentAddressBlockFilter {
+                    address,
+                    range: Some(service::BlockRange {
+                        start: Some(service::BlockId {
+                            height: u64::from(u32::from(from)),
+                            hash: vec![],
+                        }),
+                        end: Some(service::BlockId {
+                            height: u64::from(u32::from(tip)),
+                            hash: vec![],
+                        }),
+                        pool_types: vec![],
+                    }),
+                };
+                let mut stream = client.get_taddress_txids(filter).await?.into_inner();
+                let mut seen = 0;
+                while let Some(raw) = stream.try_next().await? {
+                    seen += 1;
+                    if seen > MAX_TXS_PER_ADDRESS || remaining.is_empty() {
+                        break;
+                    }
+                    let Some(height) = u32::try_from(raw.height)
+                        .ok()
+                        .filter(|h| *h > 0 && *h < u32::MAX)
+                        .map(BlockHeight::from_u32)
+                    else {
+                        continue;
+                    };
+                    let Ok(tx) = parse_transaction(&self.network, &raw.data, height) else {
+                        continue;
+                    };
+                    let spends = policy::spent_outpoints(&tx, &remaining);
+                    if spends.is_empty() {
+                        continue;
+                    }
+                    let mut db = self.db.lock("reconcile_store").await?;
+                    decrypt_and_store_transaction(&self.network, &mut db.wdb(), &tx, Some(height))?;
+                    drop(db);
+                    for outpoint in spends {
+                        remaining.remove(&outpoint);
+                        marked += 1;
+                    }
+                }
+            }
+            if marked > 0 {
+                tracing::info!("utxo reconcile: {marked} transparent output(s) were spent elsewhere");
+            }
+            Ok(marked)
+        })
+        .await
+    }

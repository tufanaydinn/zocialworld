-/// The stored transparent outputs the wallet still counts as spendable that
-/// lightwalletd's current UTXO set (GetAddressUtxos) no longer contains. They were spent by a
-/// transaction this wallet did not create (another wallet holding the same seed), or the server
-/// lags behind: they are only candidates, and a UTXO is marked spent only once its mined spending
-/// transaction is found on chain.
-pub fn missing_outpoints(stored: &[OutPoint], live: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
-    let mut out: Vec<OutPoint> = stored.iter().filter(|o| !live.contains(o)).cloned().collect();
-    out.sort();
-    out.dedup();
-    out
-}
-
-/// Which of `candidates` a transaction spends (its transparent inputs).
-pub fn spent_outpoints(tx: &Transaction, candidates: &BTreeSet<OutPoint>) -> Vec<OutPoint> {
-    tx.transparent_bundle()
-        .map(|b| {
-            b.vin
-                .iter()
-                .map(|txin| txin.prevout().clone())
-                .filter(|prevout| candidates.contains(prevout))
-                .collect()
-        })
-        .unwrap_or_default()
-}

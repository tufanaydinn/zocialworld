+//! Stage 2 change policy: change always goes to the Ironwood pool.
+//!
+//! zcash_client_backend's ZIP 317 change strategy keeps change in the pool the transaction already
+//! touches (`fees::common::select_change_pool`): Orchard flows → Orchard (where the NU6.3 turnstile
+//! still allows it), Ironwood flows → Ironwood, Sapling flows → Sapling. ADR-018 Stage 2 wants the
+//! wallet's funds to end up in Ironwood (the pool every new shielded payment uses since NU6.3; the
+//! Orchard pool is withdraw-only), so [`IronwoodChangeStrategy`] wraps the upstream strategy and,
+//! when upstream proposes Sapling or Orchard change, moves the change into the Ironwood bundle and
+//! recomputes the ZIP 317 fee for the resulting bundle shapes.
+//!
+//! Everything else stays upstream's: input selection, insufficient-funds and dust-input
+//! detection, the note-splitting count, the TEX ephemeral output, transparent change (never
+//! produced here: shielded flows always shield their change). The transaction builder recomputes
+//! the fee from the actual bundles and refuses a transaction whose balance does not match
+//! (`InsufficientFunds` / `ChangeRequired`), so a mis-estimate can never reach the network; the
+//! unit tests below compare this strategy's fee with ZIP 317 for the shapes the wallet builds.
+//!
+//! Privacy note (documented in API-v2.md): moving change from Sapling (or Orchard) to Ironwood
+//! makes the change amount visible as the Sapling (or Orchard) value balance, as any pool crossing
+//! does; recipients, the paid amount and addresses stay shielded.
+
+use zcash_client_backend::data_api::wallet::TargetHeight;
+use zcash_client_backend::data_api::{AccountMeta, InputSource};
+use zcash_client_backend::fees::orchard as orchard_fees;
+use zcash_client_backend::fees::sapling as sapling_fees;
+use zcash_primitives::transaction::fees::transparent as transparent_fees;
+use zcash_client_backend::fees::{
+    ChangeError, ChangeStrategy, ChangeValue, DustOutputPolicy, EphemeralBalance, SplitPolicy,
+    StandardFeeRule, TransactionBalance,
+};
+use zcash_client_backend::fees::standard::MultiOutputChangeStrategy;
+use zcash_primitives::transaction::fees::transparent::InputSize;
+use zcash_primitives::transaction::fees::FeeRule;
+use zcash_protocol::consensus::{self, BlockHeight};
+use zcash_protocol::value::{BalanceError, Zatoshis};
+use zcash_protocol::{PoolType, ShieldedPool};
+
+/// The serialized size of a standard P2PKH transparent output (as zcash_client_backend counts the
+/// TEX ephemeral output).
+const P2PKH_STANDARD_OUTPUT_SIZE: usize = 34;
+
+/// ZIP 317 change strategy whose change always lands in the Ironwood pool.
+pub struct IronwoodChangeStrategy<I> {
+    inner: MultiOutputChangeStrategy<I>,
+    fee_rule: StandardFeeRule,
+    dust_threshold: Zatoshis,
+}
+
+impl<I> IronwoodChangeStrategy<I> {
+    pub fn new(split_policy: SplitPolicy) -> Self {
+        let fee_rule = StandardFeeRule::Zip317;
+        IronwoodChangeStrategy {
+            inner: MultiOutputChangeStrategy::new(
+                fee_rule,
+                None,
+                ShieldedPool::Ironwood,
+                DustOutputPolicy::default(),
+                split_policy,
+            ),
+            fee_rule,
+            // DustOutputPolicy::default() has no explicit threshold: upstream uses the ZIP 317
+            // marginal fee (5,000 zat).
+            dust_threshold: zcash_primitives::transaction::fees::zip317::MARGINAL_FEE,
+        }
+    }
+}
+
+fn bal<E: From<BalanceError>, N>(e: BalanceError) -> ChangeError<E, N> {
+    ChangeError::StrategyError(E::from(e))
+}
+
+impl<I> ChangeStrategy for IronwoodChangeStrategy<I>
+where
+    I: InputSource,
+{
+    type FeeRule = StandardFeeRule;
+    type Error = <StandardFeeRule as FeeRule>::Error;
+    type MetaSource = I;
+    type AccountMetaT = AccountMeta;

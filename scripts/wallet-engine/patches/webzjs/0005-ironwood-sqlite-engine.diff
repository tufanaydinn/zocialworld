+        assert_eq!(txid_of_message(&message), Some(txid.as_str()));
+        assert_eq!(txid_of_message("broadcast_failed: no marker"), None);
+        assert_eq!(txid_of_message("x [txid=abc] y"), None);
+        assert_eq!(txid_of_message(&format!("x [txid={}] y", "AB".repeat(32))), None);

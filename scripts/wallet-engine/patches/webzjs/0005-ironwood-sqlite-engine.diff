+/// Local NU6.3 regtest chain (zebrad 6.4.2): B's account receives an Ironwood coinbase output
+/// (block 118's coinbase is a v6 transaction with one Ironwood action, mined to B's unified
+/// address). ZIP 213 applies coinbase maturity to transparent outputs only, so a shielded
+/// (Ironwood) coinbase note is spendable like any other note once the wallet has scanned to the
+/// chain tip; in the short fixture the chain tip is 219 but only 118..=123 are scanned, so it is
+/// not spendable yet. The database export restores the same balance.
+#[cfg(feature = "regtest")]
+fn check_regtest_coinbase(fixture: &str) {
+    let fx = load_fixture(fixture);
+    let phrase = regtest_seed(fx.json["seedName"].as_str().unwrap());
+    let value = fx.json["ironwoodValueZat"].as_u64().unwrap();
+    let mut store = Store::open(Network::TestNetwork, None).unwrap();
+    let account = scan_fixture(&mut store, &fx, &phrase);
+    let summary = store
+        .wdb()
+        .get_wallet_summary(ConfirmationsPolicy::default())
+        .unwrap()
+        .unwrap();
+    let b = Balances::from_summary(&summary, &account);
+    assert_eq!(b.ironwood_total_zat, value, "{b:?}");
+    assert_eq!(b.sapling_total_zat, 0);
+    assert_eq!(b.orchard_total_zat, 0);
+    assert_eq!(b.total_zat, value);
+    assert_eq!(b.shielded_total_zat, value);
+    assert_eq!(b.fully_scanned_height, fx.end);
+    let expect_spendable = fx.json["expectSpendable"].as_bool().unwrap();
+    assert_eq!(b.ironwood_spendable_zat, if expect_spendable { value } else { 0 }, "{b:?}");
+    assert_eq!(b.shielded_spendable_zat, b.ironwood_spendable_zat);
+    let bytes = store.export().unwrap();
+    drop(store);
+    let mut store2 = Store::open(Network::TestNetwork, Some(&bytes)).unwrap();
+    let s2 = store2
+        .wdb()
+        .get_wallet_summary(ConfirmationsPolicy::default())
+        .unwrap()
+        .unwrap();
+    assert_eq!(Balances::from_summary(&s2, &account), b);
+}

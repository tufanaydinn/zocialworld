+                zcash_primitives::block::BlockHash([0; 32]),
+            ),
+            None,
+        );
+        let (account, _) = store
+            .wdb()
+            .create_account(name, &seed(&regtest_seed(name)), &birthday, None)
+            .unwrap();
+        let ua = store
+            .wdb()
+            .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)
+            .unwrap()
+            .unwrap();
+        receive_addresses(&ua, &Network::TestNetwork, None).unwrap()
+    }
+
+    fn out(to: &str, zat: u64, memo: Option<&str>, withdrawal: bool) -> OutputRequest {
+        OutputRequest {
+            to: ZcashAddress::try_from_encoded(to).unwrap(),
+            amount: policy::parse_amount(zat).unwrap(),
+            memo: memo.map(|m| policy::parse_memo(m).unwrap()),
+            withdrawal,
+        }
+    }
+
+    fn propose(
+        store: &mut Store,
+        account: AccountUuid,
+        outputs: Vec<OutputRequest>,
+    ) -> Result<
+        (
+            zcash_client_backend::proposal::Proposal<
+                zcash_client_backend::fees::StandardFeeRule,
+                crate::wallet::NoteRef,
+            >,
+            Vec<TxKind>,
+        ),
+        crate::Error,
+    > {
+        let resolved = policy::resolve_outputs(&Network::TestNetwork, outputs)?;
+        propose_on(
+            &mut store.wdb(),
+            &Network::TestNetwork,
+            crate::validation::validate_confirmations_policy(1, 1, true).unwrap(),
+            SplitPolicy::single_output(),
+            account,
+            &resolved,
+        )
+    }
+
+    /// ZIP 317: 5,000 zat per logical action, at least 2 (grace actions).
+    fn zip317(logical_actions: usize) -> u64 {
+        5_000 * logical_actions.max(2) as u64
+    }

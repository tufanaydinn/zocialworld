+/// The proposal for already-resolved outputs, checked against the pool policy (no upgrade guard:
+/// callers check it first). One version-6 step, or two for a TEX withdrawal.
+pub(crate) fn propose_on(
+    wdb: &mut Wdb<'_>,
+    network: &Network,
+    min_confirmations: ConfirmationsPolicy,
+    split_policy: SplitPolicy,
+    account_id: AccountUuid,
+    resolved: &[ResolvedOutput],
+) -> Result<(Proposal<StandardFeeRule, NoteRef>, Vec<TxKind>), Error> {
+    let kinds = policy::payment_kinds(resolved);
+    let payments = resolved
+        .iter()
+        .enumerate()
+        .map(|(i, o)| {
+            Payment::new(o.recipient.address.clone(), Some(o.amount), o.memo.clone(), None, None, vec![])
+                .map_err(|_| Error::MemoNotAllowed(i))
+        })
+        .collect::<Result<Vec<_>, Error>>()?;
+    let request = TransactionRequest::new(payments)?;
+    let transparent_payments: Vec<usize> = resolved
+        .iter()
+        .enumerate()
+        .filter(|(_, o)| o.recipient.pool == OutputPool::Transparent && !o.recipient.tex)
+        .map(|(i, _)| i)
+        .collect();
+    let change_strategy = IronwoodChangeStrategy::new(split_policy);
+    let proposal = propose_transfer::<_, _, _, _, <Wdb as WalletCommitmentTrees>::Error>(
+        wdb,
+        network,
+        account_id,
+        &GreedyInputSelector::new(),
+        &change_strategy,
+        request,
+        min_confirmations,
+        &policy::spend_policy(),
+        Some(policy::TX_VERSION),
+    )
+    .map_err(map_proposal_error)?;
+    policy::check_proposal(&proposal, &kinds, &transparent_payments)?;
+    Ok((proposal, kinds))
 }
 

diff --git a/crates/webzjs-wallet/src/history.rs b/crates/webzjs-wallet/src/history.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fa9da52afe2ddd124ebaf73814af0bf8675561a5
--- /dev/null
+++ b/crates/webzjs-wallet/src/history.rs
@@ -0,0 +1,232 @@
+//! Transaction history from the wallet database's own views (`v_transactions`, `v_tx_outputs`),
+//! replacing the Stage-1 code that walked the memory backend's internal tables.
+//!
+//! The result keeps the Stage-1 shape (`get_transaction_history`): per transaction `txid`
+//! (explorer order), `tx_type`, `value`, `fee`, `block_height`, `confirmations`, `status`, `memo`,
+//! `timestamp`, `pool`. Changes in meaning, documented in API-v2.md: `value` is the account's net
+//! balance change (network fee included) and `fee` is filled in for transactions whose fee is known
+//! (the wallet's own, and enhanced ones).
+
+use rusqlite::{named_params, OptionalExtension};
+use serde::{Deserialize, Serialize};
+use zcash_client_sqlite::AccountUuid;
+use zcash_primitives::transaction::TxId;
+use zcash_protocol::memo::{Memo, MemoBytes};
+
+use crate::error::Error;
+
+/// The type of transaction.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+pub enum HistoryType {
+    /// Funds received from an external source.
+    Received,
+    /// Funds sent to an external recipient.
+    Sent,
+    /// Internal transfer (shielding, or between the wallet's own pools).
+    Shielded,
+}
+
+/// The status of a transaction.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize, PartialEq, Eq)]
+pub enum HistoryStatus {
+    Confirmed,
+    Pending,
+    Expired,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct HistoryEntry {
+    /// Transaction id as explorers print it (byte-reversed hex).
+    pub txid: String,
+    pub tx_type: HistoryType,
+    /// Net change of the account's balance in zatoshis (network fee included); for a shielding or
+    /// internal transaction, the value it moved into the wallet's shielded pools.
+    pub value: i64,
+    /// Network fee, when known.
+    pub fee: Option<u64>,
+    pub block_height: Option<u32>,
+    pub confirmations: u32,
+    pub status: HistoryStatus,
+    /// Text memos (received, and those the wallet sent), joined by "\n".
+    pub memo: Option<String>,
+    /// Block time (seconds since the Unix epoch), when mined and known.
+    pub timestamp: Option<u64>,
+    /// "ironwood", "sapling", "orchard", "transparent", "mixed" (outputs in more than one pool) or
+    /// "unknown".
+    pub pool: String,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize, PartialEq, Eq)]
+pub struct TransactionHistory {
+    pub transactions: Vec<HistoryEntry>,
+    pub total_count: u32,
+    pub has_more: bool,
+}
+
+pub fn pool_name(code: i64) -> &'static str {
+    match code {
+        0 => "transparent",
+        2 => "sapling",
+        3 => "orchard",
+        4 => "ironwood",
+        _ => "unknown",
+    }
+}
+
+fn memo_text(blob: &[u8]) -> Option<String> {
+    let bytes = MemoBytes::from_bytes(blob).ok()?;
+    match Memo::try_from(bytes).ok()? {
+        Memo::Text(t) => {
+            let s = t.to_string();
+            (!s.is_empty()).then_some(s)
+        }
+        _ => None,
+    }
+}
+
+/// The account's transactions, newest first (unmined ones at the top), `limit` from `offset`.
+pub fn transaction_history(
+    conn: &rusqlite::Connection,
+    account: &AccountUuid,
+    chain_tip_height: Option<u32>,
+    limit: u32,
+    offset: u32,
+) -> Result<TransactionHistory, Error> {
+    let uuid = account.expose_uuid().as_bytes().to_vec();
+    let total_count: u32 = conn
+        .query_row(
+            "SELECT COUNT(*) FROM v_transactions WHERE account_uuid = :account",
+            named_params! { ":account": uuid },
+            |row| row.get(0),
+        )
+        .optional()?
+        .unwrap_or(0);
+    let mut stmt = conn.prepare(
+        "SELECT txid, mined_height, account_balance_delta, total_received, fee_paid,
+                block_time, expired_unmined, is_shielding, sent_note_count
+         FROM v_transactions
+         WHERE account_uuid = :account
+         ORDER BY (mined_height IS NULL) DESC, mined_height DESC, tx_index DESC, txid
+         LIMIT :limit OFFSET :offset",
+    )?;
+    struct Row {
+        txid: Vec<u8>,
+        mined_height: Option<u32>,
+        delta: i64,
+        received: i64,
+        fee: Option<i64>,
+        block_time: Option<i64>,
+        expired: bool,
+        shielding: bool,
+        sent_notes: i64,
+    }
+    let rows = stmt
+        .query_map(
+            named_params! { ":account": uuid, ":limit": limit, ":offset": offset },
+            |row| {
+                Ok(Row {
+                    txid: row.get(0)?,
+                    mined_height: row.get(1)?,
+                    delta: row.get::<_, Option<i64>>(2)?.unwrap_or(0),
+                    received: row.get::<_, Option<i64>>(3)?.unwrap_or(0),
+                    fee: row.get(4)?,
+                    block_time: row.get(5)?,
+                    expired: row.get::<_, Option<bool>>(6)?.unwrap_or(false),
+                    shielding: row.get::<_, Option<bool>>(7)?.unwrap_or(false),
+                    sent_notes: row.get::<_, Option<i64>>(8)?.unwrap_or(0),
+                })
+            },
+        )?
+        .collect::<Result<Vec<_>, _>>()?;
+
+    let mut outputs = conn.prepare(
+        "SELECT output_pool, is_change, memo, from_account_uuid, to_account_uuid
+         FROM v_tx_outputs
+         WHERE txid = :txid",
+    )?;
+    let mut transactions = Vec::with_capacity(rows.len());
+    for r in rows {
+        let mut pools: Vec<&'static str> = Vec::new();
+        let mut memos: Vec<String> = Vec::new();
+        let outs = outputs
+            .query_map(named_params! { ":txid": r.txid }, |row| {
+                Ok((
+                    row.get::<_, i64>(0)?,
+                    row.get::<_, Option<bool>>(1)?.unwrap_or(false),
+                    row.get::<_, Option<Vec<u8>>>(2)?,
+                    row.get::<_, Option<Vec<u8>>>(3)?,
+                    row.get::<_, Option<Vec<u8>>>(4)?,
+                ))
+            })?
+            .collect::<Result<Vec<_>, _>>()?;
+        for (pool, is_change, memo, from, to) in outs {
+            let mine_received = to.as_deref() == Some(&uuid[..]);
+            let mine_sent = to.is_none() && from.as_deref() == Some(&uuid[..]);
+            if !(mine_received || mine_sent) {
+                continue;
+            }
+            let name = pool_name(pool);
+            if !pools.contains(&name) {
+                pools.push(name);
+            }
+            if !is_change {
+                if let Some(text) = memo.as_deref().and_then(memo_text) {
+                    if !memos.contains(&text) {
+                        memos.push(text);
+                    }
+                }
+            }
+        }
+        let tx_type = if r.shielding {
+            HistoryType::Shielded
+        } else if r.delta > 0 {
+            HistoryType::Received
+        } else if r.delta < 0 && r.sent_notes > 0 {
+            HistoryType::Sent
+        } else if r.delta < 0 {
+            // Only the fee left the account: a transfer between the wallet's own pools.
+            HistoryType::Shielded
+        } else {
+            HistoryType::Received
+        };
+        let status = if r.mined_height.is_some() {
+            HistoryStatus::Confirmed
+        } else if r.expired {
+            HistoryStatus::Expired
+        } else {
+            HistoryStatus::Pending
+        };
+        let confirmations = match (r.mined_height, chain_tip_height) {
+            (Some(h), Some(tip)) if tip >= h => tip - h + 1,
+            _ => 0,
+        };
+        let txid = <[u8; 32]>::try_from(&r.txid[..])
+            .map(|b| TxId::from_bytes(b).to_string())
+            .unwrap_or_else(|_| hex::encode(&r.txid));
+        transactions.push(HistoryEntry {
+            txid,
+            tx_type,
+            value: match tx_type {
+                HistoryType::Shielded => r.received,
+                _ => r.delta,
+            },
+            fee: r.fee.and_then(|f| u64::try_from(f).ok()),
+            block_height: r.mined_height,
+            confirmations,
+            status,
+            memo: (!memos.is_empty()).then(|| memos.join("\n")),
+            timestamp: r.block_time.and_then(|t| u64::try_from(t).ok()),
+            pool: match pools.len() {
+                0 => "unknown".to_string(),
+                1 => pools[0].to_string(),
+                _ => "mixed".to_string(),
+            },
+        });
+    }
+    let has_more = (offset as usize + transactions.len()) < total_count as usize;
+    Ok(TransactionHistory {
+        transactions,
+        total_count,
+        has_more,
+    })
+}

-/// A payment recipient reduced to the single receiver the Sapling beta pays.
-#[derive(Clone, Debug)]
-pub struct ResolvedRecipient {
-    /// A plain Sapling or transparent address (never a unified address), so that
-    /// zcash_client_backend cannot route the payment to any other pool.
-    pub address: ZcashAddress,
-    pub pool: OutputPool,
-}
-
-fn transparent_zaddr(net: NetworkType, t: &TransparentAddress) -> ZcashAddress {
-    match t {
-        TransparentAddress::PublicKeyHash(data) => ZcashAddress::from_transparent_p2pkh(net, *data),
-        TransparentAddress::ScriptHash(data) => ZcashAddress::from_transparent_p2sh(net, *data),
-    }
-}
-
-/// Resolves a payment recipient to the one receiver the Sapling beta pays, or refuses it.
-///
-/// * a Sapling address → itself;
-/// * a unified address → its Sapling receiver;
-/// * a transparent address → itself, for withdrawal outputs only
-///   (`recipient_transparent_not_allowed` otherwise);
-/// * a unified address WITHOUT a Sapling receiver (Orchard/Ironwood-only, or Orchard +
-///   transparent) → `recipient_no_sapling_receiver`, for withdrawals too. ADR-018 § 2 refuses a
-///   recipient without a Sapling receiver; paying such a UA's transparent receiver would make the
-///   amount and the address public although the player never typed a transparent address
-///   at all. A player who wants a public withdrawal pastes the plain t-address, which the
-///   game warns about;
-/// * a TEX address (ZIP 320), a Sprout address or an unparseable UA → `recipient_unsupported`;
-/// * an address of another network → `recipient_wrong_network`.
-pub fn resolve_recipient(
-    net: NetworkType,
-    to: &ZcashAddress,
-    withdrawal: bool,
-) -> Result<ResolvedRecipient, Error> {
-    let addr: Address = match to.clone().convert_if_network::<Address>(net) {
-        Ok(addr) => addr,
-        Err(ConversionError::IncorrectNetwork { .. }) => {
-            return Err(Error::RecipientWrongNetwork(network_name(net).to_string()))
-        }
-        Err(ConversionError::Unsupported(kind)) => {
-            return Err(Error::RecipientUnsupported(format!("{} address", kind)))
-        }
-        Err(ConversionError::User(e)) => {
-            return Err(Error::RecipientUnsupported(format!("unusable address ({})", e)))
-        }
-    };
-    match addr {
-        Address::Sapling(pa) => Ok(ResolvedRecipient {
-            address: ZcashAddress::from_sapling(net, pa.to_bytes()),
-            pool: OutputPool::Sapling,
-        }),
-        Address::Unified(ua) => {
-            if let Some(pa) = ua.sapling() {
-                return Ok(ResolvedRecipient {
-                    address: ZcashAddress::from_sapling(net, pa.to_bytes()),
-                    pool: OutputPool::Sapling,
-                });
-            }
-            // Never fall back to a UA's transparent receiver, not even for a withdrawal.
-            Err(Error::RecipientNoSaplingReceiver(if ua.has_orchard() {
-                "a unified address whose only shielded receiver is Orchard/Ironwood".to_string()
-            } else {
-                "a unified address without a Sapling receiver".to_string()
-            }))
-        }
-        Address::Transparent(t) => {
-            if withdrawal {
-                Ok(ResolvedRecipient {
-                    address: transparent_zaddr(net, &t),
-                    pool: OutputPool::Transparent,
-                })
-            } else {
-                Err(Error::RecipientTransparentNotAllowed)
-            }
-        }
-        Address::Tex(_) => Err(Error::RecipientUnsupported(
-            "a TEX (ZIP 320 transparent-source-only) address".to_string(),
-        )),
-    }
-}

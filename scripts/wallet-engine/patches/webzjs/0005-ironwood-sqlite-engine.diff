+/// The consensus branch this wallet build was made for: NU6.3 (Ironwood), `0x37A5165B`, active on
+/// mainnet from height 3,428,143 (ZIP 258). The regtest variant is used only with a local chain
+/// whose upgrades through NU6.3 are active from height 1, so it targets the same branch.
+/// It is the newest entry of `SUPPORTED_BRANCHES`.
+pub const EXPECTED_BRANCH: BranchId = BranchId::Nu6_3;
+
+/// Every consensus branch this build may create transactions for. The NU6.3 build supports only
+/// NU6.3. A NU7 build whose librustzcash knows the NU7 mainnet height lists `[Nu6_3, Nu7]`, so it
+/// keeps sending before activation and switches by itself at the activation height (the builder
+/// picks the branch with `BranchId::for_height`); see scripts/wallet-engine/README.md "Moving to NU7".
+pub const SUPPORTED_BRANCHES: &[BranchId] = &[BranchId::Nu6_3];
+
+/// Whether this build may create transactions for `branch`.
+pub fn supports_branch(branch: u32) -> bool {
+    SUPPORTED_BRANCHES.iter().any(|b| u32::from(*b) == branch)
+}
+
+/// The supported branches as lightwalletd prints them, e.g. "37a5165b".
+pub fn supported_branches_hex() -> String {
+    SUPPORTED_BRANCHES
+        .iter()
+        .map(|b| branch_hex(u32::from(*b)))
+        .collect::<Vec<_>>()
+        .join("|")
+}
+
+/// The transaction version every Stage-2 transaction uses: version 6 (ZIP 229), the only version
+/// that carries an Ironwood bundle. Valid from NU6.3 activation.
+pub const TX_VERSION: TxVersion = TxVersion::V6;
+
+/// Default number of blocks a created transaction stays valid for (zcash_primitives' builder
+/// default, `DEFAULT_TX_EXPIRY_DELTA`). Sending pauses when a pending network upgrade activates
+/// within this many blocks, because a transaction built for the current branch could still be
+/// waiting in a mempool when the branch changes.
+pub const UPGRADE_GUARD_BLOCKS: u64 = 40;
+
+/// The most outputs one `send` call accepts (recipient + project fee is 2; withdrawals and name
+/// fees are 1). A small bound keeps proofs and fees predictable.
+pub const MAX_OUTPUTS: usize = 8;
+
+/// The pools a Stage-2 build spends from / pays to, as `sending_status().pools` reports them.
+/// Orchard is spend-only (withdraw-only pool since NU6.3).
+pub const POOLS: &[&str] = &["ironwood", "sapling", "orchard", "transparent"];
+
+/// Lower-case 8-digit hex form used by lightwalletd (`LightdInfo.consensusBranchId`).
+pub fn branch_hex(branch: u32) -> String {
+    format!("{:08x}", branch)
+}
+
+pub fn expected_branch_hex() -> String {
+    branch_hex(u32::from(EXPECTED_BRANCH))
+}
+
+/// Parses lightwalletd's `consensusBranchId` ("37a5165b", tolerating a 0x prefix / upper case).
+pub fn parse_branch_hex(s: &str) -> Option<u32> {
+    let t = s.trim();
+    let t = t
+        .strip_prefix("0x")
+        .or_else(|| t.strip_prefix("0X"))
+        .unwrap_or(t);
+    if t.is_empty() || t.len() > 8 {
+        return None;
+    }
+    u32::from_str_radix(t, 16).ok()
+}
+
+/// Input-pool selection for every Stage-2 payment: Ironwood, Sapling and legacy Orchard notes,
+/// never transparent UTXOs (transparent funds are only ever spent by `shield`). Within the allowed
+/// pools zcash_client_backend picks the fewest pool crossings: the payment's own pool first.
+pub fn spend_policy() -> SpendPolicy {
+    SpendPolicy::shielded_pools([
+        ShieldedPool::Ironwood,
+        ShieldedPool::Sapling,
+        ShieldedPool::Orchard,
+    ])
+}
+
+/// The pool for change and for the shielded value of a shielding transaction.
+pub const CHANGE_POOL: ShieldedPool = ShieldedPool::Ironwood;
+
+fn network_name(net: NetworkType) -> &'static str {
+    match net {
+        NetworkType::Main => "mainnet",
+        NetworkType::Test => "testnet",
+        NetworkType::Regtest => "regtest",
+    }
+}

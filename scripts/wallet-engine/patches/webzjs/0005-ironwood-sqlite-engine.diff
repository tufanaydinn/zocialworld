+            withdrawal: false,
+        },
+        OutputRequest {
+            to: zcash_address::ZcashAddress::try_from_encoded(&project).unwrap(),
+            amount: crate::policy::parse_amount(75_000).unwrap(),
+            memo: Some(crate::policy::parse_memo("zw-fee:v1:native").unwrap()),
+            withdrawal: false,
+        },
+    ];
+    let b_id = b.account_uuid(0).await.unwrap();
+    let r = b.send_payments(&usk, b_id, outputs).await.unwrap();
+    println!("sent {:?}", r);
+    zebra("generate", "[1]");
+    let d = &zebra("getrawtransaction", &format!(r#"["{}", 1]"#, r.txids[0]))["result"];

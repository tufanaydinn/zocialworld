-//! Stage 2 ("Ironwood"), receive side: the engine on the upstream SQLite wallet database.
-//!
-//! ADR-018 § 3. The in-memory backend (`zcash_client_memory`) does not track the NU6.3 Ironwood
-//! pool, so the engine now keeps its wallet in `zcash_client_sqlite` (same librustzcash revision
-//! as the rest of the engine), which tracks Sapling, Orchard, Ironwood and transparent funds:
-//! received notes, nullifiers, the Ironwood note commitment tree (shardtree) and witnesses.
-//!
-//! On wasm32-unknown-unknown SQLite comes from sqlite-wasm-rs (through the libsqlite3-sys shim in
-//! `zw/libsqlite3-sys-shim`); the database file lives in its in-memory VFS. Persistence stays the
-//! same as today: the game stores `db_to_bytes()` and passes it back to the constructor. The bytes
-//! are a plain SQLite database file.
-//!
-//! This step covers the receive side: open/restore, accounts, addresses with an Orchard-family
-//! receiver (Ironwood receipts arrive through it), sync and per-pool balances. Sending from
-//! Ironwood (and lifting the Sapling-only rules of `sapling_beta`) is the next step.
-
-use std::sync::atomic::{AtomicU32, Ordering};
-use std::time::SystemTime;
-
-use rand_core::OsRng;
-use serde::Serialize;
-use zcash_client_backend::data_api::{Balance, WalletRead, WalletSummary};
-use zcash_client_sqlite::{util::Clock, wallet::init::init_wallet_db, AccountUuid, WalletDb};
-use zcash_address::ToAddress;
-use zcash_keys::address::UnifiedAddress;
-use zcash_keys::keys::UnifiedAddressRequest;
-use zcash_protocol::consensus::Parameters;
-
-use crate::error::Error;
-use crate::Wallet;
-use webzjs_common::Network;
-
-/// `SystemTime::now()` panics on wasm32-unknown-unknown; the engine reads the JS clock there.
-#[derive(Clone, Copy, Debug, Default)]
-pub struct EngineClock;
-
-impl Clock for EngineClock {
-    fn now(&self) -> SystemTime {
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        {
-            std::time::UNIX_EPOCH
-                + std::time::Duration::from_millis(js_sys::Date::now().max(0.0) as u64)
-        }
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        {
-            SystemTime::now()
-        }
-    }
-}
-
-/// The engine's wallet database.
-pub type SqliteWalletDb = WalletDb<rusqlite::Connection, Network, EngineClock, OsRng>;
-
-/// The wallet database file. On wasm it is a file in sqlite-wasm-rs's in-memory VFS; natively
-/// (unit tests) a file in the temp directory.
-#[derive(Clone, Debug)]
-pub struct DbFile {
-    name: String,
-}
-
-static NEXT_DB: AtomicU32 = AtomicU32::new(0);
-
-impl DbFile {
-    fn fresh() -> Self {
-        let n = NEXT_DB.fetch_add(1, Ordering::Relaxed);
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        let name = format!("zw-wallet-{n}.sqlite");
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        let name = std::env::temp_dir()
-            .join(format!("zw-wallet-{}-{n}.sqlite", std::process::id()))
-            .to_string_lossy()
-            .into_owned();
-        DbFile { name }
-    }
-
-    fn exists(&self) -> bool {
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        return libsqlite3_sys::mem_vfs::MemVfsUtil::new().exists(&self.name);
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        return std::path::Path::new(&self.name).exists();
-    }
-
-    fn import(&self, bytes: &[u8]) -> Result<(), Error> {
-        if bytes.len() < 100 || &bytes[..16] != b"SQLite format 3\0" {
-            return Err(Error::Coded(
-                "wallet_format_unsupported: the saved wallet is not an Ironwood (SQLite) wallet \
-                 database; restore the wallet from its seed phrase"
-                    .into(),
-            ));
-        }
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        libsqlite3_sys::mem_vfs::MemVfsUtil::new()
-            .import_db(&self.name, bytes)
-            .map_err(|e| Error::Generic(format!("could not load the saved wallet: {e}")))?;
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        std::fs::write(&self.name, bytes)?;
-        Ok(())
-    }
-
-    /// The database file's bytes. Call it only while holding the wallet's lock (no transaction
-    /// is open then, so the file is complete).
-    pub fn export(&self) -> Result<Vec<u8>, Error> {
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        return libsqlite3_sys::mem_vfs::MemVfsUtil::new()
-            .export_db(&self.name)
-            .map_err(|e| Error::Generic(format!("could not export the wallet: {e}")));
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        return Ok(std::fs::read(&self.name)?);
-    }
-
-    /// Removes the file; only once nothing uses the database any more.
-    pub fn remove(&self) {
-        #[cfg(all(target_family = "wasm", target_os = "unknown"))]
-        libsqlite3_sys::mem_vfs::MemVfsUtil::new().delete_db(&self.name);
-        #[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
-        let _ = std::fs::remove_file(&self.name);
-    }
-}
-
-/// Opens a new wallet database, or restores one from `db_to_bytes()` output, and runs every
-/// zcash_client_sqlite migration (an older saved database is upgraded in place).
-pub fn open_wallet_db(
-    network: Network,
-    saved: Option<&[u8]>,
-) -> Result<(SqliteWalletDb, DbFile), Error> {
-    let file = DbFile::fresh();
-    if file.exists() {
-        file.remove();
-    }
-    if let Some(bytes) = saved {
-        file.import(bytes)?;
-    }
-    let conn = rusqlite::Connection::open(&file.name)?;
-    // The file lives in memory and is persisted only through `db_to_bytes` (taken under the
-    // wallet lock, between transactions), so durability pragmas buy nothing here: keep the
-    // rollback journal in memory and skip syncs. A larger page cache saves VFS round trips.
-    conn.execute_batch(
-        "PRAGMA journal_mode = MEMORY; PRAGMA synchronous = OFF; PRAGMA cache_size = -32768;",
-    )?;
-    // zcash_client_sqlite needs the `rarray` virtual table (`WalletDb::for_path` loads it too).
-    rusqlite::vtab::array::load_module(&conn)?;
-    let mut db = WalletDb::from_connection(conn, network, EngineClock, OsRng);
-    init_wallet_db(&mut db, None).map_err(|e| Error::SqliteMigration(format!("{e:?}")))?;
-    Ok((db, file))
-}
-
-/// Per-pool balances in zatoshis (ADR-018 § 3: imported seeds show all funds).
-#[derive(Debug, Clone, Default, Serialize, PartialEq, Eq)]
-#[serde(rename_all = "camelCase")]
-pub struct IronwoodBalances {
-    pub sapling_spendable_zat: u64,
-    pub sapling_pending_change_zat: u64,
-    pub sapling_pending_zat: u64,
-    pub sapling_total_zat: u64,
-    /// The Orchard pool is withdraw-only since NU6.3; old Orchard notes are still funds.
-    pub orchard_spendable_zat: u64,
-    pub orchard_pending_change_zat: u64,
-    pub orchard_pending_zat: u64,
-    pub orchard_total_zat: u64,
-    pub ironwood_spendable_zat: u64,
-    pub ironwood_pending_change_zat: u64,
-    pub ironwood_pending_zat: u64,
-    pub ironwood_total_zat: u64,
-    pub transparent_total_zat: u64,
-    pub shielded_total_zat: u64,
-    pub total_zat: u64,
-    pub chain_tip_height: u32,
-    pub fully_scanned_height: u32,
-}
-
-fn pool(b: &Balance) -> (u64, u64, u64, u64) {
-    (
-        b.spendable_value().into_u64(),
-        b.change_pending_confirmation().into_u64(),
-        b.value_pending_spendability().into_u64(),
-        b.total().into_u64(),
-    )
-}
-
-impl IronwoodBalances {
-    pub fn from_summary(summary: &WalletSummary<AccountUuid>, account: &AccountUuid) -> Self {
-        let mut out = IronwoodBalances {
-            chain_tip_height: summary.chain_tip_height().into(),
-            fully_scanned_height: summary.fully_scanned_height().into(),
-            ..Default::default()
-        };
-        if let Some(b) = summary.account_balances().get(account) {

-/// Validates an amount given in zatoshis: an integer in 1..=MAX_MONEY.
-pub fn parse_amount(zat: u64) -> Result<Zatoshis, Error> {
-    if zat == 0 || zat > MAX_MONEY {
-        return Err(Error::InvalidAmountZat(format!(
-            "{} zatoshis (must be 1..={})",
-            zat, MAX_MONEY
-        )));
-    }
-    Zatoshis::from_u64(zat).map_err(|_| Error::InvalidAmountZat(zat.to_string()))
-}
-
-/// Encodes a text memo (ZIP 302: UTF-8, at most 512 bytes).
-pub fn parse_memo(text: &str) -> Result<MemoBytes, Error> {
-    let bytes = text.as_bytes();
-    if bytes.len() > 512 {
-        return Err(Error::MemoTooLong(bytes.len()));
-    }
-    MemoBytes::from_bytes(bytes).map_err(|_| Error::MemoTooLong(bytes.len()))
-}
-
-/// Resolves and validates every output of a `send` call.
-pub fn resolve_outputs(
-    net: NetworkType,
-    outputs: Vec<OutputRequest>,
-) -> Result<Vec<ResolvedOutput>, Error> {
-    if outputs.is_empty() {
-        return Err(Error::InvalidOutputs("at least one output is required".into()));
-    }
-    if outputs.len() > MAX_OUTPUTS {
-        return Err(Error::InvalidOutputs(format!(
-            "{} outputs requested; at most {} are allowed",
-            outputs.len(),
-            MAX_OUTPUTS
-        )));
-    }
-    let mut total: u64 = 0;
-    let mut resolved = Vec::with_capacity(outputs.len());
-    for (i, o) in outputs.into_iter().enumerate() {
-        let recipient = resolve_recipient(net, &o.to, o.withdrawal).map_err(|e| e.at_output(i))?;
-        if recipient.pool == OutputPool::Transparent && o.memo.is_some() {
-            return Err(Error::MemoNotAllowed(i));
-        }
-        total = total.saturating_add(u64::from(o.amount));
-        if total > MAX_MONEY {
-            return Err(Error::InvalidAmountZat("the outputs add up to more than MAX_MONEY".into()));
-        }
-        resolved.push(ResolvedOutput {
-            recipient,
-            amount: o.amount,
-            memo: o.memo,
-            withdrawal: o.withdrawal,
-        });
-    }
-    Ok(resolved)
-}

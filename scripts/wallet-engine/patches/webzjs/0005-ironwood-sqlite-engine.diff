+    // ---- TEX withdrawals and ephemeral-address shielding (offline; these prove and sign real transactions)
+
+    use zcash_client_backend::data_api::{
+        InputSource, OutputStatusFilter, TransactionDataRequest, TransactionStatus,
+    };
+    use zcash_primitives::transaction::TxId;
+    use zcash_protocol::value::Zatoshis;
+    use zcash_transparent::address::TransparentAddress;
+
+    /// The TEX form of a regtest t1-style address.
+    fn tex_of(transparent: &str) -> String {
+        let t = ZcashAddress::try_from_encoded(transparent).unwrap();
+        match t.convert_if_network::<zcash_keys::address::Address>(
+            zcash_protocol::consensus::NetworkType::Regtest,
+        ) {
+            Ok(zcash_keys::address::Address::Transparent(TransparentAddress::PublicKeyHash(h))) => {
+                ZcashAddress::from_tex(zcash_protocol::consensus::NetworkType::Regtest, h).encode()
+            }
+            other => panic!("{other:?}"),
+        }
+    }
+
+    fn policy_1() -> ConfirmationsPolicy {
+        crate::validation::validate_confirmations_policy(1, 1, true).unwrap()
+    }
+
+    /// Proves, signs and stores the transactions of a proposal with B's keys (no broadcast).
+    fn create<N: Copy + Eq + Ord + std::fmt::Debug>(
+        store: &mut Store,
+        proposal: &zcash_client_backend::proposal::Proposal<
+            zcash_client_backend::fees::StandardFeeRule,
+            N,
+        >,
+    ) -> Vec<TxId> {
+        use zcash_client_backend::data_api::wallet::{create_proposed_transactions, SpendingKeys};
+        use zcash_client_backend::wallet::OvkPolicy;
+        use zcash_primitives::transaction::fees::FeeRule;
+        let (usk, _) =
+            crate::wallet::usk_from_seed_str(&regtest_seed("B"), 0, &Network::TestNetwork).unwrap();
+        let prover = zcash_proofs::prover::LocalTxProver::bundled();
+        let mut wdb = store.wdb();
+        create_proposed_transactions::<
+            _,
+            _,
+            <crate::db::Wdb<'_> as InputSource>::Error,
+            _,
+            <zcash_client_backend::fees::StandardFeeRule as FeeRule>::Error,
+            _,
+        >(
+            &mut wdb,
+            &Network::TestNetwork,
+            &prover,
+            &prover,
+            &SpendingKeys::from_unified_spending_key(usk),
+            OvkPolicy::Sender,
+            proposal,
+            None,
+        )
+        .unwrap()
+        .into_iter()
+        .collect()
+    }
+
+    /// Spendable transparent value per address (what `shield` can use).
+    fn shieldable(store: &mut Store, account: AccountUuid) -> Vec<(TransparentAddress, u64)> {
+        let wdb = store.wdb();
+        let target = wdb.chain_height().unwrap().unwrap() + 1;
+        let mut v: Vec<_> = wdb
+            .get_transparent_balances(account, target.into(), policy_1())
+            .unwrap()
+            .into_iter()
+            .map(|(a, (_, b))| (a, b.spendable_value().into_u64()))
+            .filter(|(_, v)| *v > 0)
+            .collect();
+        v.sort();
+        v
+    }
+
+    fn shield_inputs(
+        p: &zcash_client_backend::proposal::Proposal<
+            zcash_client_backend::fees::StandardFeeRule,
+            std::convert::Infallible,
+        >,
+    ) -> std::collections::BTreeSet<TransparentAddress> {
+        p.steps()
+            .head
+            .transparent_inputs()
+            .iter()
+            .map(|i| *i.recipient_address())
+            .collect()
+    }
+
+    /// A TEX withdrawal whose FIRST transaction is mined but whose second is
+    /// never mined (refused, lost, tab closed between the broadcasts). Once the second expires,
+    /// the backend asks for an "unspent outputs" check of the ephemeral address; answering it
+    /// with the address's transactions alone (the engine before the fix) leaves the value hidden
+    /// for good (the expired second transaction keeps its spend row, so the check never raises
+    /// `max_observed_unspent_height`). Answering it from the UTXO set too brings the amount + the
+    /// second transaction's fee back as shieldable, and `shield` spends it.
+    #[test]
+    fn tex_funds_come_back_when_the_second_transaction_is_never_mined() {
+        let (mut store, b) = wallet_b();
+        let network = Network::TestNetwork;
+        let tex = tex_of(&addresses_of("C").transparent);
+        let (proposal, _) = propose(&mut store, b, vec![out(&tex, 60_000, None, true)]).unwrap();
+        let txids = create(&mut store, &proposal);
+        assert_eq!(txids.len(), 2);
+        let (tx1, tx2) = (txids[0], txids[1]);
+        let tx1_data = store.wdb().get_transaction(tx1).unwrap().unwrap();
+        let expiry = u32::from(tx1_data.expiry_height());
+        let eph_out = tx1_data.transparent_bundle().unwrap().vout[0].clone();
+        let eph = eph_out.recipient_address().unwrap();
+        let value = eph_out.value().into_u64();
+        assert_eq!(value, 60_000 + 10_000, "the amount plus the second transaction's fee");
+        // tx1 is mined; the chain passes the pair's expiry; tx2 is unknown to the node.
+        let mined = store.wdb().chain_height().unwrap().unwrap() + 2;
+        let tip = BlockHeight::from_u32(expiry + 5);
+        {
+            let mut db = store.wdb();
+            db.update_chain_tip(mined).unwrap();
+            db.set_transaction_status(tx1, TransactionStatus::Mined(mined)).unwrap();
+            db.update_chain_tip(tip).unwrap();
+            db.set_transaction_status(tx2, TransactionStatus::TxidNotRecognized).unwrap();
+        }
+        assert!(shieldable(&mut store, b).is_empty(), "hidden while unchecked");
+        // The ephemeral-address check the backend asks for after the expiry.
+        let request = |store: &Store| {
+            store
+                .wdb_ro()
+                .transaction_data_requests()
+                .unwrap()
+                .into_iter()
+                .find_map(|r| match r {
+                    TransactionDataRequest::TransactionsInvolvingAddress(a)
+                        if a.address() == eph
+                            && matches!(a.output_status_filter(), OutputStatusFilter::Unspent) =>
+                    {
+                        Some(a)
+                    }
+                    _ => None,
+                })
+                .expect("an unspent-outputs check of the ephemeral address")
+        };
+        let req = request(&store);
+        // Served with the address's transactions only (the engine before the fix): still hidden.
+        crate::wallet::apply_address_request(
+            &network,
+            &mut store.wdb(),
+            req.clone(),
+            &[(tx1_data.clone(), Some(mined))],
+            &[],
+            tip,
+        )
+        .unwrap();
+        assert!(shieldable(&mut store, b).is_empty(), "the old answer leaves it hidden");
+        // Served as the engine does now: the UTXO set lists the output as unspent.
+        let utxo = zcash_client_backend::proto::service::GetAddressUtxosReply {
+            address: zcash_keys::encoding::AddressCodec::encode(&eph, &network),
+            txid: tx1.as_ref().to_vec(),
+            index: 0,
+            script: eph_out.script_pubkey().0 .0.clone(),
+            value_zat: value as i64,
+            height: u64::from(u32::from(mined)),
+        };
+        // An output of another address in the reply is ignored.
+        let mut foreign = utxo.clone();
+        foreign.script = zcash_transparent::address::Script::from(TransparentAddress::PublicKeyHash([7; 20]).script()).0 .0;
+        let req = request(&store);
+        let stored = crate::wallet::apply_address_request(
+            &network,
+            &mut store.wdb(),
+            req,
+            &[(tx1_data, Some(mined))],
+            &[foreign, utxo],
+            tip,
+        )
+        .unwrap();
+        assert_eq!(stored, 1);
+        assert_eq!(shieldable(&mut store, b), vec![(eph, value)], "back as shieldable");
+        // The game's "Waiting to be shielded" (the wallet summary) shows it too.
+        let summary = store.wdb().get_wallet_summary(policy_1()).unwrap().unwrap();
+        let balances = Balances::from_summary(&summary, &b);
+        assert_eq!(balances.transparent_total_zat, value, "{balances:?}");
+        assert_eq!(balances.transparent_shieldable_zat, value, "{balances:?}");
+        let p = crate::wallet::propose_shield_on(
+            &mut store.wdb(),
+            &network,
+            policy_1(),
+            SplitPolicy::single_output(),
+            b,
+            Zatoshis::const_from_u64(10_000),
+        )
+        .unwrap();
+        assert_eq!(shield_inputs(&p), [eph].into_iter().collect());
+        assert_eq!(p.steps().head.transparent_inputs().len(), 1);
+    }
+
+    /// A deposit to a TEX ephemeral address (public on chain after a withdrawal:
+    /// a refund, or anyone's few zatoshis) while the deposit t-address also holds funds. Upstream
+    /// refuses any shielding that mixes the two (`EphemeralAddressLinkability`), so passing every
+    /// funded address at once refused shielding for good. Now each call shields one source:
+    /// the regular t-addresses first, then the ephemeral address alone.
+    #[test]
+    fn shielding_never_mixes_a_tex_ephemeral_address_with_other_addresses() {
+        use zcash_client_backend::wallet::WalletTransparentOutput;
+        use zcash_transparent::address::Script;
+        use zcash_transparent::bundle::{OutPoint, TxOut};
+        let (mut store, b) = wallet_b();
+        let network = Network::TestNetwork;
+        let tip = store.wdb().chain_height().unwrap().unwrap();
+        let eph = store.wdb().reserve_next_n_ephemeral_addresses(b, 1).unwrap()[0].0;
+        let deposit = match zcash_keys::address::Address::decode(&network, &addresses_of("B").transparent) {
+            Some(zcash_keys::address::Address::Transparent(t)) => t,
+            other => panic!("{other:?}"),
+        };
+        for (address, txid, zat) in [(eph, [0x11; 32], 300_000u64), (deposit, [0x22; 32], 400_000)] {
+            let utxo = WalletTransparentOutput::from_parts(
+                OutPoint::new(txid, 0),
+                TxOut::new(Zatoshis::const_from_u64(zat), Script::from(address.script())),
+                Some(tip - 5),
+                None,
+                None,
+                None,
+            )
+            .unwrap();
+            store.wdb().put_received_transparent_utxo(&utxo).unwrap();
+        }
+        let mut both = vec![(eph, 300_000), (deposit, 400_000)];
+        both.sort();
+        assert_eq!(shieldable(&mut store, b), both);
+        let shield = |store: &mut Store| {
+            crate::wallet::propose_shield_on(
+                &mut store.wdb(),
+                &network,
+                policy_1(),
+                SplitPolicy::single_output(),
+                b,
+                Zatoshis::const_from_u64(10_000),
+            )
+        };
+        let p1 = shield(&mut store).expect("the first shielding is proposed (not refused)");
+        assert_eq!(shield_inputs(&p1), [deposit].into_iter().collect(), "regular addresses first");
+        create(&mut store, &p1);
+        assert_eq!(shieldable(&mut store, b), vec![(eph, 300_000)]);
+        let p2 = shield(&mut store).expect("then the ephemeral address alone");
+        assert_eq!(shield_inputs(&p2), [eph].into_iter().collect());
+        create(&mut store, &p2);
+        let e = shield(&mut store).unwrap_err();
+        assert_eq!(e.code(), Some("nothing_to_shield"), "{e}");
+    }
+}

+            .wdb()
+            .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)
+            .unwrap()
+            .unwrap();
+        let a = receive_addresses(&ua, &Network::TestNetwork, None).unwrap();
+        let orchard_only = UnifiedAddress::from_receivers(ua.orchard().copied(), None, None)
+            .unwrap()
+            .encode(&Network::TestNetwork);
+        println!("ADDR {name} {}", serde_json::json!({ "addresses": a, "orchardOnly": orchard_only }));
+    }
+}

+    fn fetch_wallet_meta(
+        &self,
+        meta_source: &Self::MetaSource,
+        account: <Self::MetaSource as InputSource>::AccountId,
+        target_height: TargetHeight,
+        exclude: &[<Self::MetaSource as InputSource>::NoteRef],
+    ) -> Result<Self::AccountMetaT, <Self::MetaSource as InputSource>::Error> {
+        self.inner
+            .fetch_wallet_meta(meta_source, account, target_height, exclude)
+    }
+
+    fn compute_balance<P: consensus::Parameters, NoteRefT: Clone>(
+        &self,
+        params: &P,
+        target_height: TargetHeight,
+        transparent_inputs: &[impl transparent_fees::InputView],
+        transparent_outputs: &[impl transparent_fees::OutputView],
+        sapling: &impl sapling_fees::BundleView<NoteRefT>,
+        orchard: &impl orchard_fees::BundleView<NoteRefT>,
+        ironwood: &impl orchard_fees::BundleView<NoteRefT>,
+        ephemeral_balance: Option<EphemeralBalance>,
+        wallet_meta: &Self::AccountMetaT,
+    ) -> Result<TransactionBalance, ChangeError<Self::Error, NoteRefT>> {
+        let upstream = self.inner.compute_balance(
+            params,
+            target_height,
+            transparent_inputs,
+            transparent_outputs,
+            sapling,
+            orchard,
+            ironwood,
+            ephemeral_balance,
+            wallet_meta,
+        )?;
+        let misplaced = upstream
+            .proposed_change()
+            .iter()
+            .filter(|c| {
+                !c.is_ephemeral()
+                    && (c.output_pool() == PoolType::SAPLING || c.output_pool() == PoolType::ORCHARD)
+            })
+            .count();
+        if misplaced == 0 {
+            return Ok(upstream);
+        }
+        // Upstream's change went to Sapling or Orchard: put the same number of change outputs into
+        // the Ironwood bundle instead, and recompute the fee for the new bundle shapes.
+        let change_count = misplaced;
+        let ephemeral_in = ephemeral_balance.and_then(|b| b.ephemeral_input_amount());
+        let ephemeral_out = ephemeral_balance.and_then(|b| b.ephemeral_output_amount());
+
+        let total_in = sum_values(transparent_inputs
+            .iter()
+            .map(|i| i.coin().value())
+            .chain(sapling.inputs().iter().map(sapling_fees::InputView::<NoteRefT>::value))
+            .chain(orchard.inputs().iter().map(orchard_fees::InputView::<NoteRefT>::value))
+            .chain(ironwood.inputs().iter().map(orchard_fees::InputView::<NoteRefT>::value))
+            .chain(ephemeral_in))
+        .ok_or(bal(BalanceError::Overflow))?;
+        let subtotal_out = sum_values(transparent_outputs
+            .iter()
+            .map(|o| o.value())
+            .chain(sapling.outputs().iter().map(sapling_fees::OutputView::value))
+            .chain(orchard.outputs().iter().map(orchard_fees::OutputView::value))
+            .chain(ironwood.outputs().iter().map(orchard_fees::OutputView::value))
+            .chain(ephemeral_out))
+        .ok_or(bal(BalanceError::Overflow))?;
+
+        let sapling_input_count = sapling
+            .bundle_type()
+            .num_spends(sapling.inputs().len())
+            .map_err(ChangeError::BundleError)?;
+        let sapling_output_count = sapling
+            .bundle_type()
+            .num_outputs(sapling.inputs().len(), sapling.outputs().len())
+            .map_err(ChangeError::BundleError)?;
+        let actions = |view: &dyn ActionCount, extra_outputs: usize| {
+            ::orchard::builder::BundleType::DEFAULT
+                .num_actions(
+                    view.version().default_flags(),
+                    view.spends(),
+                    view.outputs() + extra_outputs,
+                )
+                .map_err(ChangeError::BundleError)
+        };
+        let orchard_actions = actions(&Counts::of(orchard), 0)?;
+        let ironwood_actions = actions(&Counts::of(ironwood), change_count)?;
+        let transparent_input_sizes = transparent_inputs
+            .iter()
+            .map(|i| i.serialized_size())
+            .chain(ephemeral_in.map(|_| InputSize::STANDARD_P2PKH));
+        let transparent_output_sizes = transparent_outputs
+            .iter()
+            .map(|o| o.serialized_size())
+            .chain(ephemeral_out.map(|_| P2PKH_STANDARD_OUTPUT_SIZE));
+        let fee = self
+            .fee_rule
+            .fee_required(
+                params,
+                BlockHeight::from(target_height),
+                transparent_input_sizes,
+                transparent_output_sizes,
+                sapling_input_count,
+                sapling_output_count,
+                orchard_actions,
+                ironwood_actions,
+            )
+            .map_err(ChangeError::StrategyError)?;
+        let total_out = (subtotal_out + fee).ok_or(bal(BalanceError::Overflow))?;
+        let total_change = (total_in - total_out).ok_or(ChangeError::InsufficientFunds {
+            available: total_in,
+            required: total_out,
+        })?;
+        if total_change.is_positive() && total_change < self.dust_threshold {
+            // Upstream's `DustAction::Reject` (the default policy): ask for enough input to leave
+            // non-dust change. Zero-valued change is allowed (see below).
+            let shortfall = (self.dust_threshold - total_change).ok_or(bal(BalanceError::Underflow))?;
+            return Err(ChangeError::InsufficientFunds {
+                available: total_in,
+                required: (total_in + shortfall).ok_or(bal(BalanceError::Overflow))?,
+            });
+        }
+        // Split exactly as upstream would (remainder on the first output). A zero-valued change
+        // output is kept, as upstream does for shielded flows (no "exact amount" fingerprint).
+        let per_output = total_change.div_with_remainder(
+            std::num::NonZeroU64::new(change_count as u64).expect("change_count > 0"),
+        );
+        let mut change: Vec<ChangeValue> = (0..change_count)
+            .map(|i| {
+                let value = if i == 0 {
+                    (*per_output.quotient() + *per_output.remainder()).expect("cannot overflow")
+                } else {
+                    *per_output.quotient()
+                };
+                ChangeValue::shielded(ShieldedPool::Ironwood, value, None)
+            })
+            .collect();
+        change.extend(
+            upstream
+                .proposed_change()
+                .iter()
+                .filter(|c| c.is_ephemeral() || c.output_pool() == PoolType::Transparent)
+                .cloned(),
+        );
+        TransactionBalance::new(change, fee).map_err(|_| bal(BalanceError::Overflow))
+    }
+}
+
+fn sum_values(mut values: impl Iterator<Item = Zatoshis>) -> Option<Zatoshis> {
+    values.try_fold(Zatoshis::ZERO, |acc, v| acc + v)
+}
+
+/// The counts of an Orchard-style bundle view, as the action-count rule needs them.
+trait ActionCount {
+    fn version(&self) -> ::orchard::bundle::BundleVersion;
+    fn spends(&self) -> usize;
+    fn outputs(&self) -> usize;
+}
+
+struct Counts {
+    version: ::orchard::bundle::BundleVersion,
+    spends: usize,
+    outputs: usize,
+}
+
+impl Counts {
+    fn of<N>(view: &impl orchard_fees::BundleView<N>) -> Counts {
+        Counts {
+            version: view.bundle_version(),
+            spends: view.inputs().len(),
+            outputs: view.outputs().len(),
+        }
+    }
+}
+
+impl ActionCount for Counts {
+    fn version(&self) -> ::orchard::bundle::BundleVersion {
+        self.version
+    }
+    fn spends(&self) -> usize {
+        self.spends
+    }
+    fn outputs(&self) -> usize {
+        self.outputs
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::convert::Infallible;
+    use zcash_client_backend::data_api::AccountMeta;
+    use zcash_primitives::transaction::fees::zip317;
+    use zcash_protocol::consensus::{BlockHeight, Network};
+
+    #[derive(Clone, Debug)]
+    struct In(u32, u64);
+    impl sapling_fees::InputView<u32> for In {
+        fn note_id(&self) -> &u32 {
+            &self.0
+        }
+        fn value(&self) -> Zatoshis {
+            Zatoshis::const_from_u64(self.1)
+        }
+    }
+    impl orchard_fees::InputView<u32> for In {
+        fn note_id(&self) -> &u32 {
+            &self.0
+        }
+        fn value(&self) -> Zatoshis {
+            Zatoshis::const_from_u64(self.1)
+        }
+    }
+    #[derive(Clone, Debug)]
+    struct Out(u64);
+    impl sapling_fees::OutputView for Out {
+        fn value(&self) -> Zatoshis {
+            Zatoshis::const_from_u64(self.0)
+        }
+    }
+    impl orchard_fees::OutputView for Out {
+        fn value(&self) -> Zatoshis {
+            Zatoshis::const_from_u64(self.0)
+        }
+    }
+
+    /// A mainnet height after NU6.3 activation.
+    fn target() -> TargetHeight {
+        TargetHeight::from(BlockHeight::from_u32(3_510_000))
+    }
+
+    fn versions() -> (::orchard::bundle::BundleVersion, ::orchard::bundle::BundleVersion) {
+        let branch = zcash_protocol::consensus::BranchId::for_height(&Network::MainNetwork, BlockHeight::from(target()));
+        (
+            zcash_primitives::transaction::components::orchard::bundle_version_for_branch(branch, ::orchard::ValuePool::Orchard).unwrap(),
+            zcash_primitives::transaction::components::orchard::bundle_version_for_branch(branch, ::orchard::ValuePool::Ironwood).unwrap(),
+        )
+    }
+
+    fn balance(
+        sapling_in: &[In],
+        sapling_out: &[Out],
+        orchard_in: &[In],
+        ironwood_in: &[In],
+        ironwood_out: &[Out],
+    ) -> Result<TransactionBalance, ChangeError<<StandardFeeRule as FeeRule>::Error, u32>> {
+        let strategy = IronwoodChangeStrategy::<crate::db::Wdb<'static>>::new(SplitPolicy::single_output());
+        let (ov, iv) = versions();
+        strategy.compute_balance::<_, u32>(
+            &Network::MainNetwork,
+            target(),
+            &[] as &[Infallible],
+            &[] as &[zcash_transparent::bundle::TxOut],
+            &(::sapling::builder::BundleType::DEFAULT, sapling_in, sapling_out),
+            &(ov, orchard_in, &[] as &[Out]),
+            &(iv, ironwood_in, ironwood_out),
+            None,
+            &AccountMeta::new(None, None, None),
+        )
+    }
+
+    fn fee(logical_actions: u64) -> u64 {
+        u64::from(zip317::MARGINAL_FEE) * logical_actions.max(2)
+    }
+
+    /// Sapling note → Sapling recipient: upstream keeps the change in Sapling (fee 2 actions);
+    /// here it goes to Ironwood: Sapling 1 spend + 1 output (padded to 2) = 2 logical actions,
+    /// Ironwood 1 change output (padded to 2 actions) = 2: fee 4 × 5,000.
+    #[test]
+    fn sapling_change_moves_to_ironwood_with_the_zip317_fee() {
+        let b = balance(&[In(1, 1_000_000)], &[Out(300_000)], &[], &[], &[]).unwrap();
+        assert_eq!(u64::from(b.fee_required()), fee(4));
+        assert_eq!(b.proposed_change().len(), 1);
+        let c = &b.proposed_change()[0];
+        assert_eq!(c.output_pool(), PoolType::IRONWOOD);
+        assert_eq!(u64::from(c.value()), 1_000_000 - 300_000 - fee(4));
+    }
+
+    /// Legacy Orchard note → Sapling recipient: upstream would return change to Orchard (the
+    /// NU6.3 turnstile allows it while value leaves the pool); here it goes to Ironwood. Orchard:
+    /// 1 spend (padded to 2 actions); Sapling: 1 output (padded to 2); Ironwood: 1 change (padded
+    /// to 2): 6 logical actions.
+    #[test]
+    fn orchard_change_moves_to_ironwood() {
+        let b = balance(&[], &[Out(300_000)], &[In(7, 1_000_000)], &[], &[]).unwrap();
+        assert_eq!(u64::from(b.fee_required()), fee(6));
+        let c = &b.proposed_change()[0];
+        assert_eq!(c.output_pool(), PoolType::IRONWOOD);
+        assert_eq!(u64::from(c.value()), 1_000_000 - 300_000 - fee(6));
+    }
+
+    /// Ironwood flows: upstream already chooses Ironwood; the result is passed through unchanged.
+    #[test]
+    fn ironwood_change_is_left_to_upstream() {
+        let b = balance(&[], &[], &[], &[In(3, 1_000_000)], &[Out(300_000)]).unwrap();
+        // 1 spend, 2 outputs (payment + change) → 2 actions.
+        assert_eq!(u64::from(b.fee_required()), fee(2));
+        assert_eq!(b.proposed_change()[0].output_pool(), PoolType::IRONWOOD);
+        assert_eq!(u64::from(b.proposed_change()[0].value()), 1_000_000 - 300_000 - fee(2));
+    }
+
+    /// Not enough for the (higher) Ironwood-change fee: InsufficientFunds with the exact amount,
+    /// so the input selector adds notes; dust change is refused the same way.
+    #[test]
+    fn insufficient_and_dust() {
+        // upstream (Sapling change, fee 10,000) would accept 315,000 → 300,000 + 10,000 + 5,000.
+        match balance(&[In(1, 315_000)], &[Out(300_000)], &[], &[], &[]) {
+            Err(ChangeError::InsufficientFunds { available, required }) => {
+                assert_eq!(u64::from(available), 315_000);
+                assert_eq!(u64::from(required), 300_000 + fee(4));
+            }
+            other => panic!("{other:?}"),
+        }
+        // Change of 1 zat (< 5,000 dust threshold) → asks for 4,999 more.
+        match balance(&[In(1, 300_000 + fee(4) + 1)], &[Out(300_000)], &[], &[], &[]) {
+            Err(ChangeError::InsufficientFunds { available, required }) => {
+                assert_eq!(u64::from(required) - u64::from(available), 4_999);
+            }
+            other => panic!("{other:?}"),
+        }
+        // Exact amount: a zero-valued Ironwood change output (as upstream keeps for shielded flows).
+        let b = balance(&[In(1, 300_000 + fee(4))], &[Out(300_000)], &[], &[], &[]).unwrap();
+        assert_eq!(b.proposed_change().len(), 1);
+        assert_eq!(u64::from(b.proposed_change()[0].value()), 0);
+        assert_eq!(b.proposed_change()[0].output_pool(), PoolType::IRONWOOD);
+    }
+}

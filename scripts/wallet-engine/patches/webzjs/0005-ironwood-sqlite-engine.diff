-/// The shape of a transaction, as checked and reported (`inspect`).
-#[derive(Clone, Debug, Serialize, PartialEq, Eq)]
-#[serde(rename_all = "camelCase")]
-pub struct TxShape {
-    pub txid: String,
-    pub version: String,
-    pub consensus_branch_id: String,
-    pub transparent_inputs: usize,
-    pub transparent_outputs: usize,
-    pub sapling_spends: usize,
-    pub sapling_outputs: usize,
-    pub orchard_actions: usize,
-    pub ironwood_actions: usize,
-    pub has_orchard_bundle: bool,
-    pub has_ironwood_bundle: bool,
-    pub has_sprout_bundle: bool,
-}
-
-pub fn inspect(tx: &Transaction) -> TxShape {
-    let (t_in, t_out) = tx
-        .transparent_bundle()
-        .map(|b| (b.vin.len(), b.vout.len()))
-        .unwrap_or((0, 0));
-    let (s_sp, s_out) = tx
-        .sapling_bundle()
-        .map(|b| (b.shielded_spends().len(), b.shielded_outputs().len()))
-        .unwrap_or((0, 0));
-    TxShape {
-        txid: tx.txid().to_string(),
-        version: format!("{:?}", tx.version()),
-        consensus_branch_id: branch_hex(u32::from(tx.consensus_branch_id())),
-        transparent_inputs: t_in,
-        transparent_outputs: t_out,
-        sapling_spends: s_sp,
-        sapling_outputs: s_out,
-        orchard_actions: tx.orchard_bundle().map(|b| b.actions().len()).unwrap_or(0),
-        ironwood_actions: tx.ironwood_bundle().map(|b| b.actions().len()).unwrap_or(0),
-        has_orchard_bundle: tx.orchard_bundle().is_some(),
-        has_ironwood_bundle: tx.ironwood_bundle().is_some(),
-        has_sprout_bundle: tx.sprout_bundle().is_some(),
-    }
-}
-
-/// Checks a built transaction before it can be broadcast: version 5, consensus branch = this
-/// build's branch, no Orchard, Ironwood or Sprout bundle, and the shape `kind` asks for.
-pub fn check_transaction(tx: &Transaction, kind: TxKind) -> Result<(), Error> {
-    let violation = |m: String| Err(Error::SaplingOnlyViolation(m));
-    let s = inspect(tx);
-    if tx.version() != TX_VERSION {
-        return violation(format!(
-            "transaction {} has version {}, expected {:?}",
-            s.txid, s.version, TX_VERSION
-        ));
-    }
-    if !supports_branch(u32::from(tx.consensus_branch_id())) {
-        return violation(format!(
-            "transaction {} commits to branch {}, this build supports {}",
-            s.txid,
-            s.consensus_branch_id,
-            supported_branches_hex()
-        ));
-    }
-    if s.has_orchard_bundle || s.has_ironwood_bundle || s.has_sprout_bundle {
-        return violation(format!(
-            "transaction {} has an Orchard, Ironwood or Sprout bundle",
-            s.txid
-        ));
-    }
-    let shielding_shape = s.transparent_inputs > 0
-        && s.transparent_outputs == 0
-        && s.sapling_spends == 0
-        && s.sapling_outputs > 0;
-    let payment_shape = |t_out: Option<usize>| {
-        s.transparent_inputs == 0
-            && s.sapling_spends > 0
-            && t_out.map_or(true, |n| s.transparent_outputs == n)
-    };
-    let ok = match kind {
-        TxKind::Shielding => shielding_shape,
-        TxKind::Payment {
-            transparent_outputs,
-        } => payment_shape(Some(transparent_outputs)),
-        TxKind::Any => shielding_shape || payment_shape(None),
-    };
-    if !ok {
-        return violation(format!(
-            "transaction {} does not have the expected {:?} shape: {:?}",
-            s.txid, kind, s
-        ));
-    }
-    Ok(())
-}

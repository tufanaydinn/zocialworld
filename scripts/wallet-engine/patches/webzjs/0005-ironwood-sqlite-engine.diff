-/// An output after recipient resolution, ready to become a ZIP 321 payment.
-#[derive(Clone, Debug)]
-pub struct ResolvedOutput {
-    pub recipient: ResolvedRecipient,
-    pub amount: Zatoshis,
-    pub memo: Option<MemoBytes>,
-    pub withdrawal: bool,

+/// The game's addresses never change. A deposit to ANY other external t-address
+/// of the seed (a gap-limit address; an imported wallet that rotates t-addresses) exposes that
+/// address at the deposit's height, which makes it the backend's "last generated" address. Some of
+/// those have no Sapling receiver (the lookup the engine used before then failed with "the account
+/// has no Sapling receiver"); the others silently changed all five addresses.
+#[cfg(not(feature = "regtest"))]
+#[test]
+fn addresses_do_not_change_when_another_t_address_of_the_seed_receives_funds() {
+    use zcash_client_backend::wallet::WalletTransparentOutput;
+    use zcash_keys::encoding::AddressCodec;
+    use zcash_protocol::value::Zatoshis;
+    use zcash_transparent::address::Script;
+    use zcash_transparent::bundle::{OutPoint, TxOut};
+    use zcash_transparent::keys::TransparentKeyScope;
+    let fx = load_fixture("mainnet-3510380-3510412.json");
+    let network = Network::MainNetwork;
+    let mut store = Store::open(network, None).unwrap();
+    let birthday = AccountBirthday::from_treestate(fx.prior.clone(), None)
+        .map_err(|_| "birthday")
+        .unwrap();
+    let (account, _) = store
+        .wdb()
+        .create_account("a", &seed(MAINNET_PHRASE), &birthday, None)
+        .unwrap();
+    store.wdb().update_chain_tip(BlockHeight::from_u32(fx.tip)).unwrap();
+    let before = crate::wallet::account_addresses(&store, &network, 0).unwrap();
+    assert_eq!(before.diversifier_index.as_deref(), Some("0"), "{before:?}");
+    let mut others: Vec<_> = store
+        .wdb_ro()
+        .get_transparent_receivers(account, false, false)
+        .unwrap()
+        .into_iter()
+        .filter(|(a, m)| {
+            m.scope() == Some(TransparentKeyScope::EXTERNAL) && a.encode(&network) != before.transparent
+        })
+        .map(|(a, m)| (m.address_index().unwrap().index(), a))
+        .collect();
+    others.sort();
+    assert!(others.len() >= 5, "{} gap addresses", others.len());
+    let mut without_sapling = 0;
+    for (n, (index, address)) in others.iter().enumerate() {
+        let output = WalletTransparentOutput::from_parts(
+            OutPoint::new([n as u8 + 1; 32], 0),
+            TxOut::new(Zatoshis::const_from_u64(200_000), Script::from(address.script())),
+            Some(BlockHeight::from_u32(fx.end - 1)),
+            None,
+            None,
+            None,
+        )
+        .unwrap();
+        store.wdb().put_received_transparent_utxo(&output).unwrap();
+        // The backend's most recently exposed address is now the gap address…
+        let last = store
+            .wdb()
+            .get_last_generated_address_matching(account, UnifiedAddressRequest::ALLOW_ALL)
+            .unwrap()
+            .unwrap();
+        assert_eq!(last.transparent(), Some(address), "gap index {index}");
+        if last.sapling().is_none() {
+            without_sapling += 1;
+        }
+        // …and the game's addresses are still exactly the default ones.
+        assert_eq!(
+            crate::wallet::account_addresses(&store, &network, 0).unwrap(),
+            before,
+            "after a deposit to gap index {index}"
+        );
+    }
+    assert!(without_sapling > 0, "the seed has gap addresses without a Sapling receiver");
+    // And they survive a save/restore.
+    let bytes = store.export().unwrap();
+    drop(store);
+    let store2 = Store::open(network, Some(&bytes)).unwrap();
+    assert_eq!(crate::wallet::account_addresses(&store2, &network, 0).unwrap(), before);
+}

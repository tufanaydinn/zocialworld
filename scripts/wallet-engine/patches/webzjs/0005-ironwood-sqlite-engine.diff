+/// Creates an account with the fixture's prior tree state as birthday, then scans every fixture
+/// block with zcash_client_backend's scan_cached_blocks (the path `sync` uses).
+pub(crate) fn scan_fixture(store: &mut Store, fx: &Fixture, phrase: &str) -> AccountUuid {
+    let birthday = AccountBirthday::from_treestate(fx.prior.clone(), None)
+        .map_err(|_| "birthday")
+        .unwrap();
+    let mut db = store.wdb();
+    let (account, _) = db
+        .create_account("fixture", &seed(phrase), &birthday, None)
+        .unwrap();
+    db.update_chain_tip(BlockHeight::from_u32(fx.tip)).unwrap();
+    let from_state = fx.prior.to_chain_state().unwrap();
+    let network = *db.params();
+    scan_cached_blocks(
+        &network,
+        &VecBlocks(fx.blocks.clone()),
+        &mut db,
+        BlockHeight::from_u32(fx.start),
+        &from_state,
+        fx.blocks.len(),
+    )
+    .unwrap();
+    account
+}

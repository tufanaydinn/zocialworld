+        let e = resolve_outputs(&params, vec![out(&t, true, true)]).unwrap_err().to_string();
+        assert!(e.starts_with("memo_not_allowed:"), "{e}");
+        let e = resolve_outputs(&params, vec![out(TEX, true, true)]).unwrap_err().to_string();
+        assert!(e.starts_with("memo_not_allowed:"), "{e}");
+        let e = resolve_outputs(&params, vec![out(ORCHARD_SAPLING, false, true), out(&t, false, false)])
+            .unwrap_err()
+            .to_string();
+        assert!(e.starts_with("recipient_transparent_not_allowed: output 1:"), "{e}");
+        assert!(resolve_outputs(&params, vec![]).unwrap_err().to_string().starts_with("invalid_outputs:"));
+        let many = (0..=MAX_OUTPUTS).map(|_| out(ORCHARD_SAPLING, false, false)).collect();
+        assert!(resolve_outputs(&params, many).unwrap_err().to_string().starts_with("invalid_outputs:"));
+        let ok = resolve_outputs(
+            &params,
+            vec![out(ORCHARD_ONLY, false, true), out(&t, true, false), out(TEX, true, false)],
+        )
+        .unwrap();
+        assert_eq!(
+            ok.iter().map(|o| (o.recipient.pool, o.recipient.tex)).collect::<Vec<_>>(),
+            vec![(OutputPool::Ironwood, false), (OutputPool::Transparent, false), (OutputPool::Transparent, true)]
+        );
+        // A TEX output turns the send into two steps; the plain t-output and the ephemeral output
+        // are in the first.
+        assert_eq!(
+            payment_kinds(&ok),
+            vec![TxKind::Payment { transparent_outputs: 2 }, TxKind::TexFinal { transparent_outputs: 1 }]
+        );
+        assert_eq!(payment_kinds(&ok[..1]), vec![TxKind::Payment { transparent_outputs: 0 }]);
+    }
+
+    /// Stage-1 transactions (v5, Sapling only) from the local NU6.3 regtest chain are refused by
+    /// the Stage-2 check (version 6 only); the native Ironwood payment (v6, 2 Ironwood actions)
+    /// passes as a payment.
+    #[test]
+    fn transaction_checks() {
+        let stage1: serde_json::Value =

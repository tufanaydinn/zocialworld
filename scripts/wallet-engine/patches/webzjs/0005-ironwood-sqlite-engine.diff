+/// The receive addresses of the account at `index`: ALWAYS the account's
+/// default address (the one the backend stored when the account was added; ZIP 316 default
+/// diversifier, all receivers), never "the most recently exposed" address. A deposit to another
+/// of the seed's t-addresses (an imported wallet that rotates t-addresses, a gap-limit address)
+/// exposes that address and would otherwise change the game's addresses, or make them fail when
+/// that address has no Sapling receiver.
+pub(crate) fn account_addresses(
+    store: &Store,
+    network: &Network,
+    index: u32,
+) -> Result<ReceiveAddresses, Error> {
+    let account = account_at(store, index)?;
+    let acct = store
+        .wdb_ro()
+        .get_account(account)?
+        .ok_or(Error::AccountNotFound(index))?;
+    let (ua, diversifier_index) = acct
+        .uivk()
+        .default_address(UnifiedAddressRequest::AllAvailableKeys)
+        .map_err(|e| Error::Generic(format!("could not derive the account's address: {e:?}")))?;
+    receive_addresses(&ua, network, Some(u128::from(diversifier_index).to_string()))
+}
+
+/// Every account in creation order (the numeric ids the game uses).
+pub(crate) fn ordered_accounts(store: &Store) -> Result<Vec<AccountUuid>, Error> {
+    // zcash_client_sqlite's `get_account_ids` has no ORDER BY; the creation order is the rowid.
+    let mut stmt = store.conn().prepare("SELECT uuid FROM accounts ORDER BY id")?;
+    let blobs = stmt
+        .query_map([], |row| row.get::<_, Vec<u8>>(0))?
+        .collect::<Result<Vec<_>, _>>()?;
+    let ids = store.wdb_ro().get_account_ids()?;
+    Ok(blobs
+        .iter()
+        .filter_map(|blob| ids.iter().find(|id| id.expose_uuid().as_bytes()[..] == blob[..]).copied())
+        .collect())
+}
+
+pub(crate) fn account_at(store: &Store, index: u32) -> Result<AccountUuid, Error> {
+    ordered_accounts(store)?
+        .get(index as usize)
+        .copied()
+        .ok_or(Error::AccountNotFound(index))
+}
+
+/// Whether a GetTransaction error means "the node does not know this transaction".
+fn transaction_not_found(status: &tonic::Status) -> bool {
+    let m = status.message().to_ascii_lowercase();
+    status.code() == tonic::Code::NotFound
+        || m.contains("no such mempool or")
+        || m.contains("not found")
+        || m.contains("no information available")
+}
+
+pub(crate) fn parse_transaction(
+    network: &Network,
+    raw: &[u8],
+    height: BlockHeight,
+) -> Result<Transaction, Error> {
+    Transaction::read(raw, BranchId::for_height(network, height))
+        .map_err(|e| Error::Generic(format!("could not parse a transaction: {e}")))
+}
+
+fn orchard_circuit_version(pczt: &Pczt) -> orchard::circuit::OrchardCircuitVersion {
+    // orchard 0.15 (NU6.3) needs the circuit version of the PCZT's target branch, mirroring
+    // zcash_primitives' builder: Nu6_3 -> PostNu6_3; earlier -> FixedPostNu6_2.
+    match BranchId::try_from(*pczt.global().consensus_branch_id()) {
+        Ok(BranchId::Nu6_3) => orchard::circuit::OrchardCircuitVersion::PostNu6_3,
+        _ => orchard::circuit::OrchardCircuitVersion::FixedPostNu6_2,
     }
 }
 

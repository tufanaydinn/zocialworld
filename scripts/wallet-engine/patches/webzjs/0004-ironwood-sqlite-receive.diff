+    fn regtest_ironwood_coinbase_is_not_seen_by_another_account() {
+        let fx = load_fixture("regtest-ironwood-coinbase.json");
+        let (mut db, file) = open_wallet_db(Network::TestNetwork, None).unwrap();
+        let account = scan_fixture(&mut db, &fx, &regtest_seed("A"));
+        let summary = db
+            .get_wallet_summary(ConfirmationsPolicy::default())
+            .unwrap()
+            .unwrap();
+        assert_eq!(IronwoodBalances::from_summary(&summary, &account).total_zat, 0);
+        file.remove();
+    }
+
+    /// Ironwood send check, run by hand against the local regtest chain (TESTING ONLY):
+    /// `cargo test --release -p webzjs-wallet --lib --features regtest live_regtest -- --ignored --nocapture`
+    /// with zebrad on 127.0.0.1:18732 and lightwalletd on 127.0.0.1:9467 (harness/chain).
+    /// B (Ironwood coinbase funds) pays A 1 ZEC with a memo, spending Ironwood notes only, with
+    /// zcash_client_sqlite + zcash_client_backend at the engine's pinned revision through the
+    /// engine's own generic `Wallet` (sync, account, balances). The transaction is broadcast
+    /// through lightwalletd, mined by zebrad, and A then sees the Ironwood note.
+    #[cfg(feature = "regtest")]
+    #[tokio::test(flavor = "multi_thread")]
+    #[ignore]
+    async fn live_regtest_ironwood_spend() {
+        use crate::validation::validate_confirmations_policy;
+        use std::str::FromStr;
+        use zcash_client_backend::data_api::wallet::input_selection::{
+            GreedyInputSelector, SpendPolicy,
+        };
+        use zcash_client_backend::data_api::wallet::{
+            create_proposed_transactions, propose_transfer, SpendingKeys,
+        };
+        use zcash_client_backend::data_api::{InputSource, WalletCommitmentTrees};
+        use zcash_client_backend::fees::standard::MultiOutputChangeStrategy;
+        use zcash_client_backend::fees::{DustOutputPolicy, SplitPolicy, StandardFeeRule};
+        use zcash_client_backend::proto::service::{
+            compact_tx_streamer_client::CompactTxStreamerClient, RawTransaction,
+        };
+        use zcash_client_backend::wallet::OvkPolicy;
+        use zcash_client_backend::zip321::{Payment, TransactionRequest};
+        use zcash_primitives::transaction::fees::FeeRule;
+        use zcash_proofs::prover::LocalTxProver;
+        use zcash_protocol::memo::{Memo, MemoBytes};
+        use zcash_protocol::value::Zatoshis;
+        use zcash_protocol::ShieldedPool;
+
+        fn zebra(method: &str, params: &str) -> serde_json::Value {
+            let out = std::process::Command::new("curl")
+                .args([
+                    "-s", "-X", "POST", "-H", "content-type: application/json", "--data",
+                    &format!(r#"{{"jsonrpc":"2.0","id":1,"method":"{method}","params":{params}}}"#),
+                    "http://127.0.0.1:18732",
+                ])
+                .output()
+                .unwrap();
+            serde_json::from_slice(&out.stdout).unwrap()
+        }
+        let t0 = std::time::Instant::now();
+        let network = Network::TestNetwork;
+        let policy = validate_confirmations_policy(1, 1, true).unwrap();
+        let channel = tonic::transport::Channel::from_static("http://127.0.0.1:9467")
+            .connect()
+            .await
+            .unwrap();
+        let open = |name: &'static str| {
+            let channel = channel.clone();
+            async move {
+                let (db, file) = open_wallet_db(network, None).unwrap();
+                let w = Wallet::new(db, channel, network, policy).unwrap();
+                let id = w
+                    .create_account(name, &regtest_seed(name), 0, Some(2), None)
+                    .await
+                    .unwrap();
+                w.sync().await.unwrap();
+                (w, id, file)
+            }
+        };
+        let (b, b_id, b_file) = open("B").await;
+        let (a, _a_id, a_file) = open("A").await;
+        let b0 = b.ironwood_balances(0).await.unwrap();
+        let a0 = a.ironwood_balances(0).await.unwrap();
+        println!("before: B {b0:?}\nbefore: A {a0:?} ({:?})", t0.elapsed());
+        assert!(b0.ironwood_spendable_zat >= 625_000_000);
+        let to = a.ironwood_addresses(0).await.unwrap().unified_shielded;
+        let amount = 100_000_000u64;
+        let (usk, _) = crate::wallet::usk_from_seed_str(&regtest_seed("B"), 0, &network).unwrap();
+
+        let (txid, fee) = {
+            let mut db = b.db.lock().await;
+            let payment = Payment::new(
+                zcash_address::ZcashAddress::try_from_encoded(&to).unwrap(),
+                Some(Zatoshis::from_u64(amount).unwrap()),
+                Some(MemoBytes::from(Memo::from_str("zw-ironwood-tx").unwrap())),
+                None,
+                None,
+                vec![],
+            )
+            .unwrap();
+            let request = TransactionRequest::new(vec![payment]).unwrap();
+            let change = MultiOutputChangeStrategy::<SqliteWalletDb>::new(
+                StandardFeeRule::Zip317,
+                None,
+                ShieldedPool::Ironwood,
+                DustOutputPolicy::default(),
+                SplitPolicy::single_output(),
+            );
+            let proposal = propose_transfer::<_, _, _, _, <SqliteWalletDb as WalletCommitmentTrees>::Error>(
+                &mut *db,
+                &network,
+                b_id,
+                &GreedyInputSelector::new(),
+                &change,
+                request,
+                policy,
+                &SpendPolicy::shielded_pools([ShieldedPool::Ironwood]),
+                None,
+            )
+            .unwrap();
+            let fee = proposal.steps().head.balance().fee_required();
+            println!("proposal: fee {fee:?}, version {:?} ({:?})", proposal.proposed_version(), t0.elapsed());
+            let prover = LocalTxProver::bundled();
+            let txids = create_proposed_transactions::<
+                _,
+                _,
+                <SqliteWalletDb as InputSource>::Error,
+                _,
+                <StandardFeeRule as FeeRule>::Error,
+                _,
+            >(
+                &mut *db,
+                &network,
+                &prover,
+                &prover,
+                &SpendingKeys::from_unified_spending_key(usk),
+                OvkPolicy::Sender,
+                &proposal,
+                None,
+            )
+            .unwrap();
+            (txids.head, fee.into_u64())
+        };
+        println!("built {txid} ({:?})", t0.elapsed());
+        let raw = {
+            let db = b.db.lock().await;
+            let tx = db.get_transaction(txid).unwrap().unwrap();
+            let mut v = vec![];
+            tx.write(&mut v).unwrap();
+            v
+        };
+        let resp = CompactTxStreamerClient::new(channel.clone())
+            .send_transaction(RawTransaction { data: raw.clone(), height: 0 })
+            .await
+            .unwrap()
+            .into_inner();
+        assert_eq!(resp.error_code, 0, "broadcast: {}", resp.error_message);
+        let mined = zebra("generate", "[1]");
+        println!("mined {mined}");
+        let decoded = zebra("getrawtransaction", &format!(r#"["{txid}", 1]"#));
+        let d = &decoded["result"];
+        println!(
+            "zebrad: version {} height {} ironwood actions {} orchard actions {} sapling spends {} sapling outputs {} vin {} vout {}",
+            d["version"], d["height"], d["ironwood"]["actions"].as_array().map_or(0, |x| x.len()),
+            d["orchard"]["actions"].as_array().map_or(0, |x| x.len()),
+            d["vShieldedSpend"].as_array().map_or(0, |x| x.len()),
+            d["vShieldedOutput"].as_array().map_or(0, |x| x.len()),
+            d["vin"].as_array().map_or(0, |x| x.len()), d["vout"].as_array().map_or(0, |x| x.len())
+        );
+        assert_eq!(d["version"], 6);
+        assert!(d["ironwood"]["actions"].as_array().unwrap().len() >= 2);
+        assert_eq!(d["orchard"]["actions"].as_array().map_or(0, |x| x.len()), 0);
+        // wait for lightwalletd to ingest the block
+        tokio::time::sleep(std::time::Duration::from_secs(4)).await;
+        a.sync().await.unwrap();
+        b.sync().await.unwrap();
+        let a1 = a.ironwood_balances(0).await.unwrap();
+        let b1 = b.ironwood_balances(0).await.unwrap();
+        println!("after: B {b1:?}\nafter: A {a1:?} ({:?})", t0.elapsed());
+        assert_eq!(a1.ironwood_total_zat, a0.ironwood_total_zat + amount);
+        assert_eq!(b1.ironwood_total_zat, b0.ironwood_total_zat - amount - fee);
+        assert_eq!(b1.sapling_total_zat, b0.sapling_total_zat);
+        println!(
+            "RESULT {}",
+            serde_json::json!({
+                "txid": txid.to_string(), "rawTxHex": hex::encode(&raw), "height": d["height"],
+                "version": d["version"], "feeZat": fee, "amountZat": amount,
+                "ironwoodActions": d["ironwood"]["actions"].as_array().unwrap().len(),
+                "aIronwoodBefore": a0.ironwood_total_zat, "aIronwoodAfter": a1.ironwood_total_zat,
+                "bIronwoodBefore": b0.ironwood_total_zat, "bIronwoodAfter": b1.ironwood_total_zat,
+                "seconds": t0.elapsed().as_secs_f64(),
+            })
+        );
+        a_file.remove();
+        b_file.remove();
+    }
+}

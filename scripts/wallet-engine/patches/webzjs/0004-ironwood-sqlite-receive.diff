+        let bytes = file.export().unwrap();
+        drop(db);
+        let (mut db2, file2) = open_wallet_db(Network::MainNetwork, Some(&bytes)).unwrap();
+        assert_eq!(roots(&mut db2), (s, o, i));
+        file.remove();
+        file2.remove();
+    }

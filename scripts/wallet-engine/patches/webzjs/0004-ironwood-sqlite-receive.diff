diff --git a/zw/libsqlite3-sys-shim/Cargo.toml b/zw/libsqlite3-sys-shim/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..4f99d6f8b1d649f0005fc21af57f98f9e8bba44e
--- /dev/null
+++ b/zw/libsqlite3-sys-shim/Cargo.toml
@@ -0,0 +1,34 @@
+# Zocial World Stage 2: a stand-in for libsqlite3-sys 0.35 so that rusqlite 0.37 -- the
+# exact version zcash_client_sqlite pins -- runs on wasm32-unknown-unknown. On that target the FFI
+# comes from sqlite-wasm-rs 0.4.3 (SQLite 3.50.4 compiled for wasm, memory VFS by default, the same
+# API surface as libsqlite3-sys). On every other target it re-exports the real libsqlite3-sys.
+[package]
+name = "libsqlite3-sys"
+version = "0.35.0"
+edition = "2021"
+publish = false
+
+[features]
+default = ["min_sqlite_version_3_14_0"]
+bundled = ["bundled_bindings"]
+bundled-sqlcipher = ["bundled"]
+bundled-sqlcipher-vendored-openssl = ["bundled-sqlcipher"]
+bundled-windows = ["bundled_bindings"]
+bundled_bindings = []
+buildtime_bindgen = []
+column_metadata = []
+in_gecko = []
+loadable_extension = []
+min_sqlite_version_3_14_0 = []
+preupdate_hook = []
+session = []
+sqlcipher = []
+unlock_notify = []
+wasm32-wasi-vfs = []
+with-asan = []
+
+[target.'cfg(all(target_family = "wasm", target_os = "unknown"))'.dependencies]
+sqlite-wasm-rs = { version = "=0.4.3", default-features = false, features = ["precompiled"] }
+
+[target.'cfg(not(all(target_family = "wasm", target_os = "unknown")))'.dependencies]
+native = { package = "libsqlite3-sys", version = "=0.36.0", features = ["bundled"] }
diff --git a/zw/libsqlite3-sys-shim/src/lib.rs b/zw/libsqlite3-sys-shim/src/lib.rs
new file mode 100644
index 0000000000000000000000000000000000000000..7b46bb2564dfb278ba8307d99d290b8a0906f904
--- /dev/null
+++ b/zw/libsqlite3-sys-shim/src/lib.rs
@@ -0,0 +1,8 @@
+//! libsqlite3-sys 0.35 API, backed by sqlite-wasm-rs on wasm32-unknown-unknown.
+#![allow(non_upper_case_globals, non_camel_case_types, non_snake_case)]
+
+#[cfg(all(target_family = "wasm", target_os = "unknown"))]
+pub use sqlite_wasm_rs::*;
+
+#[cfg(not(all(target_family = "wasm", target_os = "unknown")))]
+pub use native::*;

diff --git a/crates/webzjs-wallet/src/bindgen/ironwood_wallet.rs b/crates/webzjs-wallet/src/bindgen/ironwood_wallet.rs
new file mode 100644
index 0000000000000000000000000000000000000000..2e87668b5a8fc2c29da19645245828ede38d5f8e
--- /dev/null
+++ b/crates/webzjs-wallet/src/bindgen/ironwood_wallet.rs
@@ -0,0 +1,153 @@
+//! Stage 2 ("Ironwood"), receive side: `IronwoodWallet`, the engine on the SQLite wallet backend
+//! (see `crate::ironwood`). Receive side only: create/restore, sync, per-pool balances including
+//! Ironwood, receive addresses with an Orchard-family receiver, and `db_to_bytes`.
+//!
+//! It lives next to the Sapling-beta `WebWallet` (memory backend) until the next step moves sending
+//! and shielding over and the memory backend is removed.
+
+use std::str::FromStr;
+
+use serde::Serialize;
+use tonic_web_wasm_client::Client;
+use wasm_bindgen::prelude::*;
+use wasm_thread as thread;
+use webzjs_common::Network;
+
+use crate::error::Error;
+use crate::ironwood::{open_wallet_db, DbFile, SqliteWalletDb};
+use crate::validation::validate_confirmations_policy;
+use crate::Wallet;
+
+pub type IronwoodInner = Wallet<SqliteWalletDb, Client>;
+
+#[wasm_bindgen]
+#[derive(Clone)]
+pub struct IronwoodWallet {
+    inner: IronwoodInner,
+    file: DbFile,
+}
+
+#[wasm_bindgen]
+impl IronwoodWallet {
+    /// Same arguments as `WebWallet`. `db_bytes` must come from `IronwoodWallet.db_to_bytes()`
+    /// (a SQLite database); a Sapling-beta (memory backend) save is refused with
+    /// `wallet_format_unsupported` and the wallet must be restored from its seed.
+    #[wasm_bindgen(constructor)]
+    pub fn new(
+        network: &str,
+        lightwalletd_url: &str,
+        min_confirmations_trusted: u32,
+        min_confirmations_untrusted: u32,
+        db_bytes: Option<Box<[u8]>>,
+    ) -> Result<IronwoodWallet, Error> {
+        let network = Network::from_str(network)?;
+        let min_confirmations = validate_confirmations_policy(
+            min_confirmations_trusted,
+            min_confirmations_untrusted,
+            true,
+        )
+        .map_err(|_| Error::InvalidMinConformations)?;
+        let client = Client::new(lightwalletd_url.to_string());
+        let (db, file) = open_wallet_db(network, db_bytes.as_deref())?;
+        Ok(Self {
+            inner: Wallet::new(db, client, network, min_confirmations)?,
+            file,
+        })
+    }
+
+    /// Adds an account from a seed phrase; returns its numeric id (creation order, from 0).
+    pub async fn create_account(
+        &self,
+        account_name: &str,
+        seed_phrase: &str,
+        account_hd_index: u32,
+        birthday_height: Option<u32>,
+    ) -> Result<u32, Error> {
+        let uuid = self
+            .inner
+            .create_account(
+                account_name,
+                seed_phrase,
+                account_hd_index,
+                birthday_height,
+                None,
+            )
+            .await?;
+        self.inner.account_index(uuid).await
+    }
+
+    /// Scans the chain in a Web Worker (compact blocks through the game server's bridge), like
+    /// `WebWallet.sync`. Ironwood outputs are trial-decrypted and stored, the Ironwood note
+    /// commitment tree is updated, and Ironwood spends are detected by nullifier.
+    pub async fn sync(&self) -> Result<(), Error> {
+        assert!(!thread::is_web_worker_thread());
+        let wallet = self.inner.clone();
+        let handle = thread::Builder::new()
+            .name("sync".to_string())
+            .spawn_async(|| async {
+                assert!(thread::is_web_worker_thread());
+                let wallet = wallet;
+                wallet.sync().await.map_err(|e| e.to_string())
+            })
+            .unwrap_throw()
+            .join_async();
+        match handle.await {
+            Ok(Ok(())) => Ok(()),
+            Ok(Err(e)) => Err(Error::Sync(e)),
+            Err(panic) => Err(Error::Sync(format!("Sync thread panicked: {panic:?}"))),
+        }
+    }
+
+    /// Per-pool balances in zatoshis, Ironwood included (see `IronwoodBalances`).
+    #[wasm_bindgen(unchecked_return_type = "IronwoodBalances")]
+    pub async fn get_balances(&self, account_id: u32) -> Result<JsValue, Error> {
+        let b = self.inner.ironwood_balances(account_id).await?;
+        Ok(b.serialize(&serde_wasm_bindgen::Serializer::json_compatible())?)
+    }
+
+    /// Receive addresses (see `IronwoodAddresses`). `unified` has an Orchard-family receiver:
+    /// a payment to it lands in the Ironwood pool.
+    #[wasm_bindgen(unchecked_return_type = "IronwoodAddresses")]
+    pub async fn get_addresses(&self, account_id: u32) -> Result<JsValue, Error> {
+        let a = self.inner.ironwood_addresses(account_id).await?;
+        Ok(a.serialize(&serde_wasm_bindgen::Serializer::json_compatible())?)
+    }
+
+    /// The wallet database as bytes (a SQLite database file) to persist and pass back to the
+    /// constructor.
+    pub async fn db_to_bytes(&self) -> Result<Box<[u8]>, Error> {
+        // Holding the wallet lock guarantees no transaction is open while the file is read.
+        let _guard = self.inner.db.lock().await;
+        Ok(self.file.export()?.into_boxed_slice())
+    }
+
+    /// `"sqlite <version>"`, for diagnostics.
+    pub fn backend() -> String {
+        format!("sqlite {}", rusqlite::version())
+    }
+}
+
+#[wasm_bindgen(typescript_custom_section)]
+const IRONWOOD_TS: &'static str = r#"
+/** Zocial World Stage 2 (ADR-018 § 3): `IronwoodWallet.get_balances` result, zatoshis. */
+export interface IronwoodBalances {
+  saplingSpendableZat: number; saplingPendingChangeZat: number; saplingPendingZat: number; saplingTotalZat: number;
+  /** Orchard is withdraw-only since NU6.3; old Orchard notes still count as funds. */
+  orchardSpendableZat: number; orchardPendingChangeZat: number; orchardPendingZat: number; orchardTotalZat: number;
+  ironwoodSpendableZat: number; ironwoodPendingChangeZat: number; ironwoodPendingZat: number; ironwoodTotalZat: number;
+  transparentTotalZat: number;
+  shieldedTotalZat: number;
+  totalZat: number;
+  chainTipHeight: number;
+  fullyScannedHeight: number;
+}
+/** `IronwoodWallet.get_addresses` result. */
+export interface IronwoodAddresses {
+  /** Orchard-family + Sapling + transparent receivers; payments to it land in Ironwood. */
+  unified: string;
+  /** Orchard-family + Sapling receivers only. */
+  unifiedShielded: string;
+  sapling: string;
+  transparent: string;
+}
+"#;

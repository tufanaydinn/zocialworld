# Copy to .env for local development. No secrets belong here — this is a
# single non-sensitive endpoint URL.

# WebSocket endpoint for apps/server. If unset, the client falls back to
# ws://<page host>:8787 (see src/networking/config.ts) — fine for local
# dev where both apps run on localhost.
VITE_WS_URL=ws://localhost:8787

# Voice-token HTTP endpoint (CORE-004). If unset, the client falls back
# to http://<page host>:8787/voice/token (see src/voice/config.ts) — the
# same apps/server process and port as VITE_WS_URL above. Not a secret —
# this is just an endpoint URL; the actual LiveKit API key/secret never
# leave apps/server (see apps/server/.env.example).
VITE_VOICE_TOKEN_URL=http://localhost:8787/voice/token

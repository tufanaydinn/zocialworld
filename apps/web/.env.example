# Copy to .env for local development. No secrets belong here — only
# non-sensitive settings and endpoint URLs.
#
# Leave the endpoint URLs below commented out unless you really need them:
# without them every endpoint derives from VITE_SERVER_ORIGIN (or, if that
# is unset too, from the page's own host on port 8787 — which also works
# from another device on your LAN). A URL set here wins over everything,
# including VITE_SERVER_ORIGIN=same in a single-service build.

# Where apps/server lives (src/core/serverOrigin.ts):
#   unset  → http://<page host>:8787 (local development)
#   same   → the page's own origin (the server also serves the client)
#   https://… → a fixed origin
# VITE_SERVER_ORIGIN=same

# WebSocket endpoint for apps/server. If unset, it derives from
# VITE_SERVER_ORIGIN (see src/networking/config.ts).
# VITE_WS_URL=ws://localhost:8787

# Voice-token HTTP endpoint. If unset, it derives from
# VITE_SERVER_ORIGIN (see src/voice/config.ts) — the
# same apps/server process and port as VITE_WS_URL above. Not a secret —
# this is just an endpoint URL; the actual LiveKit API key/secret never
# leave apps/server (see apps/server/.env.example).
# VITE_VOICE_TOKEN_URL=http://localhost:8787/voice/token

# Zcash network selection. Must be exactly "test" or "main".
# "test" = testnet (for development)
# "main" = mainnet with real ZEC
# REQUIRED for a build (`vite build`, CI, deploys): unset or invalid fails closed.
# The local dev server (`npm run dev`) uses "test" when it is unset and says so.
# An invalid value always fails.
VITE_ZCASH_NETWORK=test
#
# ADR-018: "main" builds the mainnet Sapling-beta wallet (real ZEC;
# consent step, backup check, no faucet). Its per-transaction cap is
# VITE_MAINNET_TX_CAP_ZEC: default 0.01, "off" lifts it (keep it equal to the
# server's PAYMENT_CAP_ZEC). Root `npm run dev:main` runs both on mainnet.
# VITE_MAINNET_TX_CAP_ZEC=0.01
#
# The build id for the "Update ready — reload" prompt (default: build time +
# a random suffix, written to dist/build-id.txt).
# VITE_BUILD_ID=

# Community content gateway (ZecHub bounties/wiki, Zcash forum, GitHub) —
# served read-only by apps/server under /content. If unset, it derives from
# VITE_SERVER_ORIGIN (see src/community/config.ts).
# The browser never contacts those third-party sites directly.
# VITE_CONTENT_URL=http://localhost:8787/content
